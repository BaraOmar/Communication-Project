@model CommunicationProject.ViewModels.CreateMuxCardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Add Card";

    var occupiedSlotsJson =
        JsonSerializer.Serialize(Model.OccupiedSlotNumbers);

    var occupiedByShelfJson =
        JsonSerializer.Serialize(Model.OccupiedSlotsByShelf);
}
<div class="container py-4">

    <div class="mb-4">
        <a asp-controller="Muxes"
               asp-action="Details"
               asp-route-id="@Model.MuxId"
               class="text-decoration-none">
            ← Back to MUX
        </a>

        <h1 class="mt-3 mb-1">
            Add Card
        </h1>

        <p class="text-muted mb-0">
            Add a card to @Model.MuxName.
        </p>
    </div>


    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <div class="alert alert-light border mb-4">

                @if (Model.HasShelves)
                {
                    <div>
                        <strong>Shelves:</strong>
                        @Model.ShelfCount
                    </div>

                    <div>
                        <strong>Cards Per Shelf:</strong>
                        @Model.CardSlotCount
                    </div>
                }
                else
                {
                    <div>
                        <strong>Card Slots:</strong>
                        @Model.CardSlotCount
                    </div>
                }

            </div>


            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="MuxId"
                       type="hidden" />

                <input asp-for="HasShelves"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label asp-for="CardTypeId"
                           class="form-label">
                    </label>

                    <select asp-for="CardTypeId"
                            asp-items="Model.CardTypeOptions"
                            class="form-select">

                        <option value="">
                            -- Select Card Type --
                        </option>

                    </select>

                    <span asp-validation-for="CardTypeId"
                          class="text-danger">
                    </span>

                </div>


                @if (Model.HasShelves)
                {
                    <div class="mb-3">

                        <label asp-for="ShelfNumber"
                               class="form-label">
                        </label>

                        @if (Model.HasShelves)
                        {
                            <div class="mb-3">

                                <label asp-for="ShelfNumber"
                                       class="form-label">
                                </label>

                                <select asp-for="ShelfNumber"
                                        class="form-select"
                                        id="shelfSelect">

                                    <option value="">
                                        -- Select Shelf --
                                    </option>

                                    @for (int shelf = 1;
                                          shelf <= Model.ShelfCount.GetValueOrDefault();
                                          shelf++)
                                    {
                                        <option value="@shelf">
                                            Shelf @shelf
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="ShelfNumber"
                                      class="text-danger">
                                </span>

                            </div>
                        }

                        <div class="form-text">
                            Enter a shelf number from 1 to @Model.ShelfCount.
                        </div>

                        <span asp-validation-for="ShelfNumber"
                              class="text-danger">
                        </span>

                    </div>
                }


                <div class="mb-3">

                    <label asp-for="SlotNumber"
                           class="form-label">
                    </label>

                    <div class="mb-3">

                        <label asp-for="SlotNumber"
                               class="form-label">
                            Card Number
                        </label>

                        <select asp-for="SlotNumber"
                                class="form-select"
                                id="cardSelect">

                            <option value="0">
                                -- Select Card --
                            </option>

                        </select>

                        <span asp-validation-for="SlotNumber"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="form-text">

                        @if (Model.HasShelves)
                        {
                            <span>
                                Enter a card number from 1 to
                                @Model.CardSlotCount for the selected shelf.
                            </span>
                        }
                        else
                        {
                            <span>
                                Enter a card number from 1 to
                                @Model.CardSlotCount.
                            </span>
                        }

                    </div>

                    <span asp-validation-for="SlotNumber"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Add Card
                    </button>

                    <a asp-controller="Muxes"
                           asp-action="Details"
                           asp-route-id="@Model.MuxId"
                           class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const hasShelves =
            @Model.HasShelves.ToString().ToLower();

        const cardSlotCount =
            @Model.CardSlotCount.GetValueOrDefault();

        const occupiedSlots =
            @Html.Raw(occupiedSlotsJson);

        const occupiedByShelf =
            @Html.Raw(occupiedByShelfJson);

        const shelfSelect =
            document.getElementById("shelfSelect");

        const cardSelect =
            document.getElementById("cardSelect");


        function loadAvailableCards() {

            const previousValue =
                cardSelect.value;

            cardSelect.innerHTML =
                '<option value="0">-- Select Card --</option>';


            let occupied = [];


            if (hasShelves) {

                if (!shelfSelect ||
                    !shelfSelect.value) {
                    return;
                }

                const selectedShelf =
                    shelfSelect.value;

                occupied =
                    occupiedByShelf[selectedShelf] ?? [];
            }
            else {
                occupied = occupiedSlots;
            }


            for (let card = 1;
                 card <= cardSlotCount;
                 card++) {

                if (occupied.includes(card)) {
                    continue;
                }

                const option =
                    document.createElement("option");

                option.value = card;
                option.textContent =
                    "Card " + card;

                cardSelect.appendChild(option);
            }


            if ([...cardSelect.options]
                .some(option =>
                    option.value === previousValue)) {

                cardSelect.value =
                    previousValue;
            }
        }


        if (shelfSelect) {
            shelfSelect.addEventListener(
                "change",
                loadAvailableCards);
        }

        loadAvailableCards();
    </script>
}