@model CommunicationProject.Models.MuxCard
@using CommunicationProject.Security
@using CommunicationProject.Models

@{
    ViewData["Title"] = "MUX Card Details";

    bool hasShelves =
        Model.Mux.MuxType?.HasShelves == true;

    bool isStmCard =
        Model.CardType.Category == CardCategory.STM;

    bool isE1Card =
        Model.CardType.Category == CardCategory.E1;
}

<div class="container py-4">

    <div class="mb-4">

        <a asp-controller="Muxes"
               asp-action="Details"
               asp-route-id="@Model.MuxId"
               class="text-decoration-none">
            ← @Model.Mux.Name
        </a>

        @if (hasShelves)
        {
            <h1 class="mt-3 mb-1">
                Shelf @Model.ShelfNumber / Card @Model.SlotNumber
            </h1>
        }
        else
        {
            <h1 class="mt-3 mb-1">
                Card @Model.SlotNumber
            </h1>
        }

        <p class="text-muted mb-0">
            @Model.CardType.Name · @Model.CardType.Category
        </p>

    </div>


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-3">
                    <div class="text-muted small">
                        MUX
                    </div>

                    <div class="fw-semibold">
                        @Model.Mux.Name
                    </div>
                </div>


                <div class="col-md-3">
                    <div class="text-muted small">
                        Site
                    </div>

                    <div class="fw-semibold">
                        @Model.Mux.Site.Name
                    </div>
                </div>


                <div class="col-md-3">
                    <div class="text-muted small">
                        Location
                    </div>

                    <div class="fw-semibold">
                        @if (hasShelves)
                        {
                            <span>
                                Shelf @Model.ShelfNumber /
                                Card @Model.SlotNumber
                            </span>
                        }
                        else
                        {
                            <span>
                                Card @Model.SlotNumber
                            </span>
                        }
                    </div>
                </div>


                <div class="col-md-3">
                    <div class="text-muted small">
                        Card Type
                    </div>

                    <div class="fw-semibold">
                        @Model.CardType.Name
                    </div>

                    <div class="text-muted small">
                        @Model.CardType.Category
                    </div>
                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between
                align-items-center mb-3">

                <div>
                    <h3 class="mb-1">
                        Ports
                    </h3>

                    <div class="text-muted">
                        @Model.Ports.Count ports
                    </div>
                </div>

            </div>


            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>

                            <th>Port</th>
                            <th>Status</th>

                            @if (isStmCard)
                            {
                                <th>STM</th>
                                <th>Communication Link</th>
                            }

                            @if (isE1Card)
                            {
                                <th>E1</th>
                            }

                            <th class="text-end">
                                Action
                            </th>

                        </tr>
                    </thead>


                    <tbody>

                        @foreach (var port in Model.Ports
                            .OrderBy(port => port.PortNumber))
                        {
                            <tr>

                                <td>
                                    Port @port.PortNumber
                                </td>


                                <td>
                                    @port.Status
                                </td>


                                @if (isStmCard)
                                {
                                    <td>

                                        @if (port.Stm != null)
                                        {
                                            <a asp-controller="Stms"
                                                   asp-action="Details"
                                                   asp-route-id="@port.Stm.Id">
                                                STM @port.Stm.Number
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Available
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (port.Stm != null)
                                        {
                                            <span>
                                                @port.Stm.Link.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>
                                }


                                @if (isE1Card)
                                {
                                    <td>

                                        @if (port.E1 != null)
                                        {
                                            <a asp-controller="E1s"
                                                   asp-action="Details"
                                                   asp-route-id="@port.E1.Id">
                                                E1 @port.E1.E1Number
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Available
                                            </span>
                                        }

                                    </td>
                                }


                                <td class="text-end">

                                    @if (isStmCard)
                                    {
                                        if (port.Stm == null)
                                        {
                                            <a asp-controller="MuxPorts"
                                                   asp-action="AssignStm"
                                                   asp-route-id="@port.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                Assign STM
                                            </a>
                                        }
                                        else
                                        {
                                            <form asp-controller="MuxPorts"
                                                  asp-action="ReleaseStm"
                                                  asp-route-id="@port.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Release this STM from the MUX port?');">
                                                    Release STM
                                                </button>

                                            </form>
                                        }
                                    }
                                    else if (isE1Card)
                                    {
                                        if (port.E1 == null)
                                        {
                                            <a asp-controller="MuxPorts"
                                                   asp-action="AssignE1"
                                                   asp-route-id="@port.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                Assign E1
                                            </a>
                                        }
                                        else
                                        {
                                            <form asp-controller="MuxPorts"
                                                  asp-action="ReleaseE1"
                                                  asp-route-id="@port.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Release this E1 from the MUX port?');">
                                                    Release E1
                                                </button>

                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>