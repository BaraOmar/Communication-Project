@model CommunicationProject.Models.Site

@{
    ViewData["Title"] = "Delete Site";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/sites.css"
          asp-append-version="true" />
}

<div class="sites-form-page">

    <div class="sites-page-top">

        <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="sites-back-link">
            ← Site details
        </a>

        <h1 class="sites-form-title">
            Delete site
        </h1>

        <p class="sites-form-subtitle">
            Review the site before deleting it.
        </p>

    </div>


    <div class="sites-card sites-delete-card">

        <div class="sites-delete-notice">
            This action cannot be undone. The site will be permanently removed.
        </div>


        <div asp-validation-summary="ModelOnly"
             class="sites-validation">
        </div>


        <div class="sites-delete-summary">

            <div>

                <div class="sites-detail-label">
                    Site ID
                </div>

                <div class="sites-detail-value">
                    @Model.Id
                </div>

            </div>


            <div>

                <div class="sites-detail-label">
                    Name
                </div>

                <div class="sites-detail-value">
                    @Model.Name
                </div>

            </div>


            <div>

                <div class="sites-detail-label">
                    Location
                </div>

                <div class="sites-detail-value">
                    @(string.IsNullOrWhiteSpace(Model.Location)
                        ? "—"
                        : Model.Location)
                </div>

            </div>

        </div>


        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />


            <div class="sites-form-actions">

                <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="sites-secondary-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="sites-danger-btn">
                    Delete site
                </button>

            </div>

        </form>

    </div>

</div>