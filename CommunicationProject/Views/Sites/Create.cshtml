@model CommunicationProject.Models.Site

@{
    ViewData["Title"] = "Add Site";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/sites.css"
          asp-append-version="true" />
}


<div class="sites-form-page">

    <!-- Header -->
    <div class="sites-form-header">

        <a href="#"
               class="sites-back-link js-back-link"
               data-fallback-url="@Url.Action("Index", "Sites")">

            <span>←</span>
            Back

        </a>


        <div class="sites-form-heading">

            <div class="sites-form-heading-icon">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11z"></path>

                    <circle cx="12"
                            cy="10"
                            r="2"></circle>

                </svg>

            </div>


            <div>

                <h1 class="sites-form-title">
                    Add Site
                </h1>

                <p class="sites-form-subtitle">
                    Create a new communication site
                    and define its basic information.
                </p>

            </div>

        </div>

    </div>


    <!-- Form -->
    <div class="sites-card sites-form-card sites-form-card-modern">

        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="sites-validation-summary">
            </div>


            <div class="sites-form-section">

                <div class="sites-form-section-header">

                    <span class="sites-form-section-mark">
                    </span>

                    <div>
                        <h2>
                            Site Information
                        </h2>

                        <p>
                            Enter the identifier, name and
                            location for this site.
                        </p>
                    </div>

                </div>


                <div class="sites-form-grid">

                    <!-- Site ID -->
                    <div class="sites-form-group">

                        <label asp-for="Id"
                               class="sites-form-label">
                            Site ID
                        </label>

                        <input asp-for="Id"
                               class="sites-form-control"
                               placeholder="e.g. 005" />

                        <div class="sites-form-hint">
                            Must be unique across all sites.
                        </div>

                        <span asp-validation-for="Id"
                              class="sites-validation">
                        </span>

                    </div>


                    <!-- Site Name -->
                    <div class="sites-form-group">

                        <label asp-for="Name"
                               class="sites-form-label">
                            Site Name
                        </label>

                        <input asp-for="Name"
                               class="sites-form-control"
                               placeholder="Enter site name" />

                        <div class="sites-form-hint">
                            A clear name used to identify the site.
                        </div>

                        <span asp-validation-for="Name"
                              class="sites-validation">
                        </span>

                    </div>


                    <!-- Location -->
                    <div class="sites-form-group sites-form-group-wide">

                        <label asp-for="Location"
                               class="sites-form-label">
                            Location
                        </label>

                        <input asp-for="Location"
                               class="sites-form-control"
                               placeholder="Enter site location" />

                        <span asp-validation-for="Location"
                              class="sites-validation">
                        </span>

                    </div>

                </div>

            </div>


            <div class="sites-form-actions">

                <a href="#"
                       class="sites-secondary-btn js-back-link"
                       data-fallback-url="@Url.Action("Index", "Sites")">

                    Cancel

                </a>


                <button type="submit"
                        class="sites-save-btn">

                    <span class="sites-save-icon">
                        +
                    </span>

                    Add Site

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}