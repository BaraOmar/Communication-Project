@model CommunicationProject.Models.LinkType

@{
    ViewData["Title"] = "Edit Link Type";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/linktypes.css"
          asp-append-version="true" />
}


<div class="linktypes-form-page">

    <div class="linktypes-page-top">

        <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="linktypes-back-link">
            ← Link type details
        </a>

        <h1 class="linktypes-form-title">
            Edit link type
        </h1>

        <p class="linktypes-form-subtitle">
            Update the name used by communication links.
        </p>

    </div>


    <div class="linktypes-card linktypes-form-card">

        <form asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            <input type="hidden"
                   asp-for="Id" />


            <div asp-validation-summary="ModelOnly"
                 class="linktypes-validation-summary">
            </div>


            <div class="linktypes-form-group">

                <label asp-for="Name"
                       class="linktypes-form-label">
                    Type name
                </label>

                <input asp-for="Name"
                       class="linktypes-form-control" />

                <span asp-validation-for="Name"
                      class="linktypes-validation">
                </span>

            </div>


            <div class="linktypes-form-actions">

                <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="linktypes-secondary-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="linktypes-submit-btn">
                    Save changes
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}