@model CommunicationProject.Models.LinkType

@{
    ViewData["Title"] = "Delete Link Type";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/linktypes.css"
          asp-append-version="true" />
}


<div class="linktypes-form-page">

    <div class="linktypes-page-top">

        <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="linktypes-back-link">
            ← Link type details
        </a>

        <h1 class="linktypes-form-title">
            Delete link type
        </h1>

        <p class="linktypes-form-subtitle">
            Confirm before removing this type.
        </p>

    </div>


    <div class="linktypes-card linktypes-delete-card">

        <!-- Warning -->
        <div class="linktypes-delete-warning">

            <div class="linktypes-delete-icon">
                !
            </div>


            <div>

                <div class="linktypes-delete-title">
                    Delete this link type?
                </div>

                <p class="linktypes-delete-text">
                    This action cannot be undone. A link type
                    that is currently assigned to communication
                    links cannot be deleted.
                </p>

            </div>

        </div>


        <div asp-validation-summary="ModelOnly"
             class="linktypes-validation-summary">
        </div>


        <!-- Summary -->
        <div class="linktypes-delete-summary">

            <div class="linktypes-detail-label">
                Type
            </div>

            <div class="linktypes-detail-value">
                @Model.Name
            </div>

        </div>


        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />


            <div class="linktypes-form-actions">

                <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="linktypes-secondary-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="linktypes-danger-btn">
                    Delete type
                </button>

            </div>

        </form>

    </div>

</div>