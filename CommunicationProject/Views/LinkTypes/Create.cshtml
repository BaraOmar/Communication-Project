@model CommunicationProject.Models.LinkType

@{
    ViewData["Title"] = "Create Link Type";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/linktypes.css"
          asp-append-version="true" />
}


<div class="linktypes-form-page">

    <div class="linktypes-page-top">

        <a asp-action="Index"
               class="linktypes-back-link">
            ← Link Types
        </a>

        <h1 class="linktypes-form-title">
            Create link type
        </h1>

        <p class="linktypes-form-subtitle">
            Add a connection technology that can be assigned
            to communication links.
        </p>

    </div>


    <div class="linktypes-card linktypes-form-card">

        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="linktypes-validation-summary">
            </div>


            <div class="linktypes-form-group">

                <label asp-for="Name"
                       class="linktypes-form-label">
                    Type name
                </label>

                <input asp-for="Name"
                       class="linktypes-form-control"
                       placeholder="For example: Fiber, Microwave..." />

                <div class="linktypes-form-hint">
                    Use a clear name that identifies the communication technology.
                </div>

                <span asp-validation-for="Name"
                      class="linktypes-validation">
                </span>

            </div>


            <div class="linktypes-form-actions">

                <a asp-action="Index"
                       class="linktypes-secondary-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="linktypes-submit-btn">
                    Create type
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}