@model CommunicationProject.ViewModels.SearchPathViewModel
@using CommunicationProject.Models
@using static CommunicationProject.Models.E1

@{
    ViewData["Title"] = "Search Paths";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/searchpath.css"
          asp-append-version="true" />
}

<div class="path-page">

    <!-- Header -->
    <div class="path-header">

        <h1 class="path-title">
            Search Paths
        </h1>

        <p class="path-subtitle">
            Find saved communication paths and visualize how
            E1 channels move between sites.
        </p>

    </div>


    <!-- Filters -->
    <div class="path-card path-filter-card">

        <form asp-controller="SearchPath"
              asp-action="Index"
              method="get">

            <div class="path-filter-grid">

                <!-- Description -->
                <div class="path-field">

                    <label asp-for="Description">
                        Description
                    </label>

                    <input asp-for="Description"
                           class="path-input"
                           placeholder="Search description..." />

                </div>


                <!-- Link -->
                <div class="path-field">

                    <label asp-for="LinkName">
                        Communication link
                    </label>

                    <select asp-for="LinkName"
                            asp-items="Model.LinkOptions"
                            class="path-select">

                        <option value="">
                            All links
                        </option>

                    </select>

                </div>


                <!-- Source -->
                <div class="path-field">

                    <label asp-for="SiteId">
                        Site
                    </label>

                    <select asp-for="SiteId"
                            asp-items="Model.SiteOptions"
                            class="path-select">

                        <option value="">
                            All sites
                        </option>

                    </select>

                </div>


                <div class="path-field">

                    <label asp-for="SitePosition">
                        Position
                    </label>

                    <select asp-for="SitePosition"
                            class="path-select">

                        <option value="anywhere">
                            Anywhere in path
                        </option>

                        <option value="start">
                            Start site
                        </option>

                        <option value="destination">
                            Destination site
                        </option>

                    </select>

                </div>


                <div class="path-filter-actions">

                    <button type="submit"
                            class="path-search-btn">
                        Search
                    </button>

                    <a asp-action="Index"
                           class="path-clear-btn">
                        Clear
                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- Results Header -->
    <div class="path-results-header">

        <h2 class="path-results-title">
            Saved paths
        </h2>

        <span class="path-results-count">
            @Model.TotalItems
            result@(Model.TotalItems == 1 ? "" : "s")
        </span>

    </div>


    @if (!Model.Results.Any())
    {
        <div class="path-card path-empty">

            <div class="path-empty-title">
                No paths found
            </div>

            <p class="path-empty-text">
                Try changing or clearing your search filters.
            </p>

        </div>
    }
    else
    {
        foreach (var path in Model.Results)
        {
            string[] links =
                path.LinkPath.Split(
                    new[] { " → " },
                    StringSplitOptions.RemoveEmptyEntries);


            string[] siteSteps =
                path.SitePath.Split(
                    new[] { " → " },
                    StringSplitOptions.RemoveEmptyEntries);


            var parsedSites =
                siteSteps
                    .Select(step =>
                    {
                        int detailsStart =
                            step.IndexOf(" (");

                        if (detailsStart < 0)
                        {
                            return new
                            {
                                Site = step.Trim(),
                                Details = ""
                            };
                        }

                        return new
                        {
                            Site =
                                step[..detailsStart]
                                    .Trim(),

                            Details =
                                step
                                    .Substring(
                                        detailsStart + 2)
                                    .TrimEnd(')')
                                    .Trim()
                        };
                    })
                    .ToList();


            <article class="path-card path-result">

                <!-- Path Header -->
                <div class="path-result-header">

                    <div class="path-result-identity">

                        <span class="path-number">
                            Path @path.PathNumber
                        </span>


                        @if (string.IsNullOrWhiteSpace(
                            path.Description))
                        {
                            <h3 class="
                                path-result-description
                                path-result-no-description">

                                No description

                            </h3>
                        }
                        else
                        {
                            <h3 class="path-result-description">
                                @path.Description
                            </h3>
                        }

                    </div>


                    <div class="d-flex align-items-center gap-2">

                        @if (User.IsInRole("Admin") ||
                             User.IsInRole("Operator"))
                        {
                            <a asp-action="AddCustomer"
                                   asp-route-pathId="@path.PathId"
                                   class="btn btn-sm btn-outline-primary">
                                Add Customer
                            </a>
                        }

                        <span class="path-link-count">

                            @path.LinkCount
                            link@(path.LinkCount == 1 ? "" : "s")

                        </span>

                    </div>

                </div>


                <!-- Network Visualization -->
                <div class="path-result-body">

                    <div class="path-topology">

                        @for (int i = 0;
                              i < parsedSites.Count;
                              i++)
                        {
                            bool isFirst =
                                i == 0;

                            bool isLast =
                                i == parsedSites.Count - 1;


                            string nodeClass =
                                isFirst
                                    ? "start"
                                    : isLast
                                        ? "end"
                                        : "transit";


                            <!-- Site Node -->
                            <div class="path-node @nodeClass">

                                <div class="path-node-marker">

                                    @if (isFirst)
                                    {
                                        <span>START</span>
                                    }
                                    else if (isLast)
                                    {
                                        <span>END</span>
                                    }
                                    else
                                    {
                                        <span>SITE</span>
                                    }

                                </div>


                                <div class="path-node-content">

                                    <div class="path-node-top">

                                        <div>

                                            <div class="path-node-label">
                                                Site
                                            </div>

                                            <div class="path-node-site">
                                                @parsedSites[i].Site
                                            </div>

                                        </div>


                                        @if (isFirst)
                                        {
                                            <span class="
                                                path-node-status
                                                path-node-status-start">
                                                Origin
                                            </span>
                                        }
                                        else if (isLast)
                                        {
                                            <span class="
                                                path-node-status
                                                path-node-status-end">
                                                Destination
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="
                                                path-node-status
                                                path-node-status-transit">
                                                Cross connection
                                            </span>
                                        }

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        parsedSites[i].Details))
                                    {
                                        <div class="path-node-channels">

                                            @foreach (
                                                var part
                                                in parsedSites[i]
                                                    .Details
                                                    .Split('|'))
                                            {
                                                string channel =
                                                    part.Trim();

                                                bool incoming =
                                                    channel.StartsWith(
                                                        "IN:",
                                                        StringComparison
                                                            .OrdinalIgnoreCase);

                                                bool outgoing =
                                                    channel.StartsWith(
                                                        "OUT:",
                                                        StringComparison
                                                            .OrdinalIgnoreCase);


                                                <div class="
                                                    path-channel
                                                    @(incoming
                                                                                                             ? "path-channel-in"
                                                                                                             : outgoing
                                                                                                                 ? "path-channel-out"
                                                                                                                 : "")">

                                                    @if (incoming)
                                                    {
                                                        var incomingText =
                                                            channel.Substring(3).Trim();

                                                        <span class="
                                                            path-channel-direction">
                                                            IN
                                                        </span>

                                                        <span>
                                                            @incomingText
                                                        </span>
                                                    }
                                                    else if (outgoing)
                                                    {
                                                        var outgoingText =
                                                            channel.Substring(4).Trim();

                                                        <span class="
                                                            path-channel-direction">
                                                            OUT
                                                        </span>

                                                        <span>
                                                            @outgoingText
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            @channel
                                                        </span>
                                                    }

                                                </div>
                                            }

                                        </div>
                                    }

                                </div>

                            </div>


                            <!-- Connection -->
                            @if (i < parsedSites.Count - 1)
                            {
                                <div class="path-connection">

                                    <div class="path-connection-rail">

                                        <div class="
                                            path-connection-line">
                                        </div>

                                        <div class="
                                            path-connection-arrow">
                                            ↓
                                        </div>

                                    </div>


                                    <div class="
                                        path-connection-card">

                                        <div class="
                                            path-connection-label">
                                            Communication link
                                        </div>


                                        <div class="
                                            path-connection-name">

                                            @if (i < links.Length)
                                            {
                                                @links[i]
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }

                                        </div>


                                        <div class="
                                            path-connection-direction">

                                            @parsedSites[i].Site
                                            <span>→</span>
                                            @parsedSites[i + 1].Site

                                        </div>

                                    </div>

                                </div>
                            }
                        }

                    </div>
                    <!-- Customers Using This Path -->
                    <div class="path-customers">

                        <div class="path-customers-header">

                            <div>
                                <h4 class="path-customers-title">
                                    Customers
                                </h4>

                                <p class="path-customers-subtitle">
                                    Customers currently using this communication path.
                                </p>
                            </div>

                            <span class="path-customers-count">
                                @path.Customers.Count
                                customer@(path.Customers.Count == 1 ? "" : "s")
                            </span>

                        </div>


                        @if (!path.Customers.Any())
                        {
                            <div class="path-customers-empty">
                                No customers are assigned to this path yet.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">

                                <table class="table align-middle mb-0">

                                    <thead>
                                        <tr>
                                            <th>Customer</th>
                                            <th>E1 Route</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var customer in path.Customers)
                                        {
                                            <tr>

                                                <td>
                                                    <div class="fw-semibold">
                                                        @customer.CustomerName
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(
                                                        customer.StartSiteId) &&
                                                        !string.IsNullOrWhiteSpace(
                                                        customer.DestinationSiteId))
                                                    {
                                                        <small class="text-muted d-block">
                                                            Uses:
                                                            @customer.StartSiteId
                                                            →
                                                            @customer.DestinationSiteId
                                                        </small>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(
                                                        customer.Description))
                                                    {
                                                        <small class="text-muted d-block">
                                                            @customer.Description
                                                        </small>
                                                    }
                                                </td>


                                                <td>

                                                    @if (!customer.E1s.Any())
                                                    {
                                                        <span class="text-muted">
                                                            No E1 assignments
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var e1 in customer.E1s)
                                                        {
                                                            <div class="d-flex align-items-center gap-2 mb-1">

                                                                <div>
                                                                    <strong>
                                                                        @e1.SiteFrom → @e1.SiteTo
                                                                    </strong>

                                                                    <span class="text-muted">—</span>

                                                                    @(e1.StmNumber == "Direct (PDH)"
                                                                        ? $"Direct (PDH) / E1 {e1.E1Number}"
                                                                        : $"STM {e1.StmNumber} / E1 {e1.E1Number}")
                                                                </div>

                                                                @if (User.IsInRole("Admin") ||
                                                                     User.IsInRole("Operator"))
                                                                {
                                                                    <form asp-action="ReleaseCustomerE1"
                                                                          method="post"
                                                                          class="d-inline"
                                                                          onsubmit="return confirm('Release only this physical E1 pair?');">

                                                                        @Html.AntiForgeryToken()

                                                                        <input type="hidden"
                                                                               name="customerConnectionSegmentId"
                                                                               value="@e1.CustomerConnectionSegmentId" />

                                                                        <button type="submit"
                                                                                class="btn btn-sm btn-outline-danger">
                                                                            Release E1
                                                                        </button>

                                                                    </form>
                                                                }

                                                            </div>
                                                        }
                                                    }

                                                </td>


                                                <td>

                                                    @if (customer.OperationalStatus.HasValue)
                                                    {
                                                        switch (customer.OperationalStatus.Value)
                                                        {
                                                            case E1OperationalStatus.Connected:
                                                                <span class="badge bg-success">
                                                                    Connected
                                                                </span>
                                                                break;

                                                            case E1OperationalStatus.Wrong:
                                                                <span class="badge bg-warning text-dark">
                                                                    Wrong
                                                                </span>
                                                                break;

                                                            case E1OperationalStatus.Damaged:
                                                                <span class="badge bg-danger">
                                                                    Damaged
                                                                </span>
                                                                break;

                                                            case E1OperationalStatus.Available:
                                                                <span class="badge bg-secondary">
                                                                    Available
                                                                </span>
                                                                break;
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">
                                                            Unknown
                                                        </span>
                                                    }
                                                    @if (customer.ManageE1Id.HasValue)
                                                    {
                                                        <a asp-controller="E1s"
                                                               asp-action="ChangeStatus"
                                                               asp-route-id="@customer.ManageE1Id"
                                                               class="btn btn-sm btn-outline-secondary ms-2">
                                                            Manage Connection
                                                        </a>
                                                    }

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>
                </div>

            </article>
        }


        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="path-pagination-area">

                <div class="path-page-info">

                    Showing
                    @Model.FirstItem–@Model.LastItem
                    of
                    @Model.TotalItems

                </div>


                <ul class="path-pagination">

                    <!-- Previous -->
                    <li>

                        @if (Model.HasPreviousPage)
                        {
                            <a asp-action="Index"
                                   asp-route-description="@Model.Description"
                                   asp-route-linkName="@Model.LinkName"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-sitePosition="@Model.SitePosition"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   class="path-page-link">
                                ‹
                            </a>
                        }
                        else
                        {
                            <span class="
                                path-page-link
                                disabled">
                                ‹
                            </span>
                        }

                    </li>


                    @{
                        int currentPage =
                            Model.PageNumber;

                        int totalPages =
                            Model.TotalPages;

                        int startPage =
                            Math.Max(
                                2,
                                currentPage - 2);

                        int endPage =
                            Math.Min(
                                totalPages - 1,
                                currentPage + 2);
                    }


                    <!-- First -->
                    <li>

                        <a asp-action="Index"
                               asp-route-description="@Model.Description"
                               asp-route-linkName="@Model.LinkName"
                               asp-route-siteId="@Model.SiteId"
                               asp-route-sitePosition="@Model.SitePosition"
                               asp-route-pageNumber="1"
                               class="path-page-link
                            @(currentPage == 1
                                                           ? "active"
                                                           : "")">
                            1
                        </a>

                    </li>


                    @if (startPage > 2)
                    {
                        <li>
                            <span class="path-page-ellipsis">
                                …
                            </span>
                        </li>
                    }


                    @for (int i = startPage;
                          i <= endPage;
                          i++)
                    {
                        <li>

                            <a asp-action="Index"
                                   asp-route-description="@Model.Description"
                                   asp-route-linkName="@Model.LinkName"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-sitePosition="@Model.SitePosition"
                                   asp-route-pageNumber="@i"
                                   class="path-page-link
                                @(currentPage == i
                                                                   ? "active"
                                                                   : "")">
                                @i
                            </a>

                        </li>
                    }


                    @if (endPage < totalPages - 1)
                    {
                        <li>
                            <span class="path-page-ellipsis">
                                …
                            </span>
                        </li>
                    }


                    @if (totalPages > 1)
                    {
                        <li>

                            <a asp-action="Index"
                                   asp-route-description="@Model.Description"
                                   asp-route-linkName="@Model.LinkName"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-sitePosition="@Model.SitePosition"
                                   asp-route-pageNumber="@totalPages"
                                   class="path-page-link
                                @(currentPage == totalPages
                                                                   ? "active"
                                                                   : "")">
                                @totalPages
                            </a>

                        </li>
                    }


                    <!-- Next -->
                    <li>

                        @if (Model.HasNextPage)
                        {
                            <a asp-action="Index"
                                   asp-route-description="@Model.Description"
                                   asp-route-linkName="@Model.LinkName"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-sitePosition="@Model.SitePosition"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   class="path-page-link">
                                ›
                            </a>
                        }
                        else
                        {
                            <span class="
                                path-page-link
                                disabled">
                                ›
                            </span>
                        }

                    </li>

                </ul>

            </div>
        }
    }

</div>