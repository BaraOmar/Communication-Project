@model CommunicationProject.ViewModels.SearchPathViewModel
@using CommunicationProject.Models
@using static CommunicationProject.Models.E1

@{
    ViewData["Title"] = "Search Paths";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/searchpath.css"
          asp-append-version="true" />
}


<div class="path-page">

    <!-- =====================================================
         Header
         ===================================================== -->

    <div class="path-header">

        <h1 class="path-title">
            Search Paths
        </h1>

        <p class="path-subtitle">
            Find saved communication paths and visualize how
            E1 channels move between sites.
        </p>

    </div>


    <!-- =====================================================
         Filters
         ===================================================== -->

    <div class="path-card path-filter-card">

        <form asp-controller="SearchPath"
              asp-action="Index"
              method="get">

            <div class="path-filter-grid">

                <div class="path-field">

                    <label asp-for="Description">
                        Description
                    </label>

                    <input asp-for="Description"
                           class="path-input"
                           placeholder="Search description..." />

                </div>


                <div class="path-field">

                    <label asp-for="LinkName">
                        Communication link
                    </label>

                    <select asp-for="LinkName"
                            asp-items="Model.LinkOptions"
                            class="path-select">

                        <option value="">
                            All links
                        </option>

                    </select>

                </div>


                <div class="path-field">

                    <label asp-for="SiteId">
                        Site
                    </label>

                    <select asp-for="SiteId"
                            asp-items="Model.SiteOptions"
                            class="path-select">

                        <option value="">
                            All sites
                        </option>

                    </select>

                </div>


                <div class="path-field">

                    <label asp-for="SitePosition">
                        Position
                    </label>

                    <select asp-for="SitePosition"
                            class="path-select">

                        <option value="anywhere">
                            Anywhere in path
                        </option>

                        <option value="start">
                            Start site
                        </option>

                        <option value="destination">
                            Destination site
                        </option>

                    </select>

                </div>


                <div class="path-filter-actions">

                    <button type="submit"
                            class="path-search-btn">
                        Search
                    </button>

                    <a asp-action="Index"
                           class="path-clear-btn">
                        Clear
                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- =====================================================
         Results Header
         ===================================================== -->

    <div class="path-results-header">

        <h2 class="path-results-title">
            Saved paths
        </h2>

        <span class="path-results-count">

            @Model.TotalItems
            result@(Model.TotalItems == 1 ? "" : "s")

        </span>

    </div>


    <!-- =====================================================
         Empty Results
         ===================================================== -->
    @if (!Model.Results.Any())
    {
        <div class="path-card path-empty">

            <div class="path-empty-title">
                No paths found
            </div>

            <p class="path-empty-text">
                Try changing or clearing your search filters.
            </p>

        </div>
    }
    else
    {
        foreach (var path in Model.Results)
        {
            string[] links =
                path.LinkPath.Split(
                    new[] { " → " },
                    StringSplitOptions.RemoveEmptyEntries);


            string[] siteSteps =
                path.SitePath.Split(
                    new[] { " → " },
                    StringSplitOptions.RemoveEmptyEntries);


            /*
             * Only take site IDs.
             * We no longer need the old IN/OUT text stored
             * inside SitePath because the new UI builds it
             * from the actual link sequence.
             */
            var sites =
                siteSteps
                    .Select(step =>
                    {
                        int detailsStart =
                            step.IndexOf(" (");


                        return detailsStart < 0
                            ? step.Trim()
                            : step[..detailsStart].Trim();
                    })
                    .ToList();


            /*
             * If Description is empty, display
             * customer names in the path header.
             */
            var customerNames =
                path.Customers
                    .Where(customer =>
                        !string.IsNullOrWhiteSpace(
                            customer.CustomerName))
                    .Select(customer =>
                        customer.CustomerName.Trim())
                    .Distinct(
                        StringComparer.OrdinalIgnoreCase)
                    .ToList();


            string pathTitle =
                !string.IsNullOrWhiteSpace(
                    path.Description)
                    ? path.Description
                    : customerNames.Any()
                        ? string.Join(
                            " / ",
                            customerNames)
                        : "No description";


            bool titleIsCustomer =
                string.IsNullOrWhiteSpace(
                    path.Description) &&
                customerNames.Any();


            string pathBodyId =
                $"path-body-{path.PathId}";


            <!-- =================================================
                 Path
                 ================================================= -->

            <article class="path-card path-result">


                <!-- =============================================
                     Path Header
                     ============================================= -->

                <div class="path-result-header">

                    <div class="path-result-identity">

                        <span class="path-number">
                            Path @path.PathNumber
                        </span>


                        <div class="path-title-content">

                            <h3 class="
                                path-result-description
                                @(titleIsCustomer
                                                                    ? "path-result-customer-title"
                                                                    : "")">

                                @pathTitle

                            </h3>


                            @if (titleIsCustomer)
                            {
                                <span class="path-title-source">
                                    Customer
                                </span>
                            }

                        </div>

                    </div>


                    <div class="path-result-header-actions">

                        <span class="path-link-count">

                            @path.LinkCount
                            link@(path.LinkCount == 1 ? "" : "s")

                        </span>


                        <button type="button"
                                class="path-toggle-btn"
                                data-path-toggle="@pathBodyId"
                                aria-expanded="false">

                            <span class="path-toggle-text">
                                View Path
                            </span>

                            <span class="path-toggle-icon">
                                ↓
                            </span>

                        </button>

                    </div>

                </div>


                <!-- =============================================
                     ENTIRE PATH - COLLAPSIBLE
                     ============================================= -->

                <div class="path-result-body"
                     id="@pathBodyId"
                     hidden>

                    <div class="path-network-flow">


                        @for (int i = 0;
                              i < sites.Count;
                              i++)
                        {
                            bool isFirst =
                                i == 0;


                            bool isLast =
                                i == sites.Count - 1;


                            string currentSiteId =
                                sites[i];


                            string previousLink =
                                i > 0 &&
                                (i - 1) < links.Length
                                    ? links[i - 1]
                                    : "";


                            string nextLink =
                                i < links.Length
                                    ? links[i]
                                    : "";


                            string circleClass =
                                isFirst
                                    ? "origin"
                                    : isLast
                                        ? "destination"
                                        : "transit";


                            string roleText =
                                isFirst
                                    ? "Origin"
                                    : isLast
                                        ? "Destination"
                                        : "Cross Connection";

                            var nodeCrossConnections =
                                path.Customers
                                    .SelectMany(
                                        customer =>
                                            customer.CrossConnections
                                                .Where(cross =>
                                                    string.Equals(
                                                        cross.SiteId,
                                                        currentSiteId,
                                                        StringComparison.OrdinalIgnoreCase))
                                                .Select(cross =>
                                                    new
                                                    {
                                                        Customer = customer,
                                                        CrossConnection = cross
                                                    }))
                                    .Where(item =>
                                        !string.IsNullOrWhiteSpace(
                                            item.CrossConnection.DisplayText))
                                    .ToList();
                            <!-- =================================
                                 SITE NODE
                                 ================================= -->

                            <div class="path-flow-site">

                                <!-- Circle -->

                                <div class="
                                    path-flow-circle
                                    @circleClass">

                                    <span>
                                        @currentSiteId
                                    </span>

                                </div>


                                <!-- Site + Cross Connection -->

                                <div class="
                                    path-flow-node-content
                                    @(i > 0 && nodeCrossConnections.Any()
                                                 ? "has-cross"
                                                 : "")">


                                    <!-- =============================
             Site Information
             ============================= -->

                                    <div class="path-flow-site-info">

                                        <div class="path-flow-site-top">

                                            <span class="path-flow-site-title">
                                                Site @currentSiteId
                                            </span>


                                            <span class="
                                                path-flow-role
                                                @circleClass">

                                                @roleText

                                            </span>

                                        </div>


                                        <div class="path-flow-site-links">

                                            @if (!string.IsNullOrWhiteSpace(
                                                previousLink))
                                            {
                                                <span class="
                                                    path-flow-link-label">

                                                    <small>
                                                        IN
                                                    </small>

                                                    <strong>
                                                        @previousLink
                                                    </strong>

                                                </span>
                                            }


                                            @if (!string.IsNullOrWhiteSpace(
                                                nextLink))
                                            {
                                                <span class="
                                                    path-flow-link-label">

                                                    <small>
                                                        OUT
                                                    </small>

                                                    <strong>
                                                        @nextLink
                                                    </strong>

                                                </span>
                                            }

                                        </div>

                                    </div>


                                    <!-- =============================
             Cross Connection
             Starting from second node
             ============================= -->
                                    @if (i > 0 &&
                                                 nodeCrossConnections.Any())
                                    {
                                        <div class="path-readable-cross">

                                            @foreach (
                                                var item
                                                in nodeCrossConnections)
                                            {
                                                <div class="
                                                    path-readable-cross-item">

                                                    <div class="
                                                        path-readable-cross-main">

                                                        <div class="
                                                            path-readable-cross-title">

                                                            @if (
                                                                item.CrossConnection
                                                                    .IsPhysicalTermination)
                                                            {
                                                                <span>
                                                                    Physical Termination
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span>
                                                                    Cross Connection
                                                                </span>
                                                            }

                                                        </div>


                                                        <!-- Exact old formula -->

                                                        <div class="
                                                            path-readable-cross-formula">

                                                            @(item.CrossConnection.DisplayText)

                                                        </div>


                                                        @if (
                                                            item.CrossConnection
                                                                .IsPhysicalTermination)
                                                        {
                                                            <div class="
                                                                path-readable-cross-note">

                                                                Physical termination

                                                            </div>
                                                        }

                                                    </div>


                                                    <!-- Status + Manage -->

                                                    <div class="
                                                        path-readable-cross-actions">

                                                        @if (
                                                            item.Customer
                                                                .OperationalStatus
                                                                .HasValue)
                                                        {
                                                            switch (
                                                                item.Customer
                                                                    .OperationalStatus
                                                                    .Value)
                                                            {
                                                                case E1OperationalStatus.Connected:

                                                                    <span class="
                                                                        path-status-badge
                                                                        path-status-connected">

                                                                        Connected

                                                                    </span>

                                                                    break;


                                                                case E1OperationalStatus.Wrong:

                                                                    <span class="
                                                                        path-status-badge
                                                                        path-status-wrong">

                                                                        Wrong

                                                                    </span>

                                                                    break;


                                                                case E1OperationalStatus.Damaged:

                                                                    <span class="
                                                                        path-status-badge
                                                                        path-status-damaged">

                                                                        Damaged

                                                                    </span>

                                                                    break;


                                                                case E1OperationalStatus.Available:

                                                                    <span class="
                                                                        path-status-badge
                                                                        path-status-available">

                                                                        Available

                                                                    </span>

                                                                    break;
                                                            }
                                                        }


                                                        @if (
                                                            item.Customer
                                                                .ManageE1Id
                                                                .HasValue)
                                                        {
                                                            <a asp-controller="E1s"
                                                                   asp-action="ChangeStatus"
                                                                   asp-route-id="@item.Customer.ManageE1Id"
                                                                   class="path-manage-btn">

                                                                Manage Connection

                                                            </a>
                                                        }

                                                    </div>

                                                </div>
                                            }

                                        </div>
                                    }

                                </div>

                            </div>


                            <!-- =================================
                                 SEGMENT TO NEXT SITE
                                 ================================= -->
                            @if (i < sites.Count - 1)
                            {
                                string nextSiteId =
                                    sites[i + 1];


                                string currentLink =
                                    i < links.Length
                                        ? links[i]
                                        : "—";


                                /*
                                 * Customer E1s that use this
                                 * physical segment.
                                 */
                                var segmentE1s =
                                    path.Customers
                                        .SelectMany(
                                            customer =>
                                                customer.E1s
                                                    .Where(e1 =>
                                                        string.Equals(
                                                            e1.SiteFrom,
                                                            currentSiteId,
                                                            StringComparison.OrdinalIgnoreCase) &&

                                                        string.Equals(
                                                            e1.SiteTo,
                                                            nextSiteId,
                                                            StringComparison.OrdinalIgnoreCase))
                                                    .Select(e1 =>
                                                        new
                                                        {
                                                            Customer =
                                                                customer,

                                                            E1 =
                                                                e1
                                                        }))
                                        .ToList();


                                /*
                                 * Cross connection executed
                                 * when reaching next site.
                                 */
                                var crossConnections =
                                    path.Customers
                                        .SelectMany(
                                            customer =>
                                                customer
                                                    .CrossConnections
                                                    .Where(cross =>
                                                        string.Equals(
                                                            cross.SiteId,
                                                            nextSiteId,
                                                            StringComparison.OrdinalIgnoreCase))
                                                    .Select(cross =>
                                                        new
                                                        {
                                                            Customer =
                                                                customer,

                                                            CrossConnection =
                                                                cross
                                                        }))
                                        .Where(item =>
                                            !string.IsNullOrWhiteSpace(
                                                item
                                                    .CrossConnection
                                                    .DisplayText))
                                        .ToList();


                                <!-- =============================
                                     Vertical Connector
                                     ============================= -->

                                <div class="
                                    path-flow-segment">

                                    <div class="
                                        path-flow-rail">

                                        <div class="
                                            path-flow-line">
                                        </div>

                                        <div class="
                                            path-flow-arrow">
                                            ↓
                                        </div>

                                    </div>


                                    <div class="
                                        path-flow-segment-content">


                                        <!-- =========================================
     Communication Link
     ========================================= -->

                                        <div class="path-flow-link-row">

                                            <div class="path-flow-link">

                                                <div>

                                                    <span class="path-flow-small-label">
                                                        Communication Link
                                                    </span>

                                                    <strong>
                                                        @currentLink
                                                    </strong>

                                                </div>


                                                <span class="path-flow-direction">
                                                    @currentSiteId → @nextSiteId
                                                </span>

                                            </div>


                                            <!-- Release belongs to this physical link/E1 segment -->
                                            @if (User.IsInRole("Admin") ||
                                                     User.IsInRole("Operator"))
                                            {
                                                <div class="path-flow-release-actions">

                                                    @foreach (var segment in segmentE1s)
                                                    {
                                                        <form asp-action="ReleaseCustomerE1"
                                                              method="post"
                                                              class="path-inline-form"
                                                              onsubmit="return confirm('Release this physical E1 pair?');">

                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="customerConnectionSegmentId"
                                                                   value="@segment.E1.CustomerConnectionSegmentId" />

                                                            <button type="submit"
                                                                    class="path-release-btn">

                                                                Release E1

                                                            </button>

                                                        </form>
                                                    }

                                                </div>
                                            }

                                        </div>


                                        <!-- =========================================
     Cross Connection
     ========================================= -->
                                      @*   @if (crossConnections.Any())
                                        {
                                            <div class="path-readable-cross">

                                                <div class="path-readable-cross-title">
                                                    Cross Connection
                                                </div>


                                                @foreach (var item in crossConnections)
                                                {
                                                    <div class="path-readable-cross-item">

                                                        <div class="path-readable-cross-main">

                                                            <div class="path-readable-cross-site">
                                                                Site @nextSiteId
                                                            </div>


                                                            <div class="path-readable-cross-formula">
                                                                @(item.CrossConnection.DisplayText)
                                                            </div>


                                                            @if (item.CrossConnection.IsPhysicalTermination)
                                                            {
                                                                <div class="path-readable-cross-note">
                                                                    Physical termination
                                                                </div>
                                                            }

                                                        </div>


                                                        <div class="path-readable-cross-actions">

                                                            @if (item.Customer.OperationalStatus.HasValue)
                                                            {
                                                                switch (item.Customer.OperationalStatus.Value)
                                                                {
                                                                    case E1OperationalStatus.Connected:

                                                                        <span class="
                                                                            path-status-badge
                                                                            path-status-connected">
                                                                            Connected
                                                                        </span>

                                                                        break;


                                                                    case E1OperationalStatus.Wrong:

                                                                        <span class="
                                                                            path-status-badge
                                                                            path-status-wrong">
                                                                            Wrong
                                                                        </span>

                                                                        break;


                                                                    case E1OperationalStatus.Damaged:

                                                                        <span class="
                                                                            path-status-badge
                                                                            path-status-damaged">
                                                                            Damaged
                                                                        </span>

                                                                        break;


                                                                    case E1OperationalStatus.Available:

                                                                        <span class="
                                                                            path-status-badge
                                                                            path-status-available">
                                                                            Available
                                                                        </span>

                                                                        break;
                                                                }
                                                            }


                                                            @if (item.Customer.ManageE1Id.HasValue)
                                                            {
                                                                <a asp-controller="E1s"
                                                                       asp-action="ChangeStatus"
                                                                       asp-route-id="@item.Customer.ManageE1Id"
                                                                       class="path-manage-btn">

                                                                    Manage Connection

                                                                </a>
                                                            }

                                                        </div>

                                                    </div>
                                                }

                                            </div>
                                        }
         *@                           
                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>

            </article>
        }


        <!-- =================================================
             Pagination
             ================================================= -->
        @if (Model.TotalPages > 1)
        {
            <div class="path-pagination-area">

                <div class="path-page-info">

                    Showing
                    @Model.FirstItem–@Model.LastItem
                    of
                    @Model.TotalItems

                </div>


                <ul class="path-pagination">


                    <!-- Previous -->

                    <li>

                        @if (Model.HasPreviousPage)
                        {
                            <a asp-action="Index"
                                   asp-route-description="@Model.Description"
                                   asp-route-linkName="@Model.LinkName"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-sitePosition="@Model.SitePosition"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   class="path-page-link">

                                ‹

                            </a>
                        }
                        else
                        {
                            <span class="
                                path-page-link
                                disabled">

                                ‹

                            </span>
                        }

                    </li>


                    @{
                        int currentPage =
                            Model.PageNumber;


                        int totalPages =
                            Model.TotalPages;


                        int startPage =
                            Math.Max(
                                2,
                                currentPage - 2);


                        int endPage =
                            Math.Min(
                                totalPages - 1,
                                currentPage + 2);
                    }


                    <!-- First Page -->

                    <li>

                        <a asp-action="Index"
                               asp-route-description="@Model.Description"
                               asp-route-linkName="@Model.LinkName"
                               asp-route-siteId="@Model.SiteId"
                               asp-route-sitePosition="@Model.SitePosition"
                               asp-route-pageNumber="1"
                               class="
                            path-page-link
                            @(currentPage == 1
                                                           ? "active"
                                                           : "")">

                            1

                        </a>

                    </li>


                    @if (startPage > 2)
                    {
                        <li>

                            <span class="
                                path-page-ellipsis">

                                …

                            </span>

                        </li>
                    }


                    @for (
                        int pageNumber =
                            startPage;

                        pageNumber <=
                            endPage;

                        pageNumber++)
                    {
                        <li>

                            <a asp-action="Index"
                                   asp-route-description="@Model.Description"
                                   asp-route-linkName="@Model.LinkName"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-sitePosition="@Model.SitePosition"
                                   asp-route-pageNumber="@pageNumber"
                                   class="
                                path-page-link
                                @(currentPage ==
                                                                   pageNumber
                                                                       ? "active"
                                                                       : "")">

                                @pageNumber

                            </a>

                        </li>
                    }


                    @if (
                        endPage <
                        totalPages - 1)
                    {
                        <li>

                            <span class="
                                path-page-ellipsis">

                                …

                            </span>

                        </li>
                    }


                    @if (totalPages > 1)
                    {
                        <li>

                            <a asp-action="Index"
                                   asp-route-description="@Model.Description"
                                   asp-route-linkName="@Model.LinkName"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-sitePosition="@Model.SitePosition"
                                   asp-route-pageNumber="@totalPages"
                                   class="
                                path-page-link
                                @(currentPage ==
                                                                   totalPages
                                                                       ? "active"
                                                                       : "")">

                                @totalPages

                            </a>

                        </li>
                    }


                    <!-- Next -->

                    <li>

                        @if (Model.HasNextPage)
                        {
                            <a asp-action="Index"
                                   asp-route-description="@Model.Description"
                                   asp-route-linkName="@Model.LinkName"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-sitePosition="@Model.SitePosition"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   class="path-page-link">

                                ›

                            </a>
                        }
                        else
                        {
                            <span class="
                                path-page-link
                                disabled">

                                ›

                            </span>
                        }

                    </li>

                </ul>

            </div>
        }
    }

</div>


@section Scripts {

    <script>
        (() => {

            /*
             * One button controls the WHOLE path.
             *
             * All nodes, links, E1 routes,
             * formulas and actions expand/collapse
             * together.
             */

            const buttons =
                document.querySelectorAll(
                    "[data-path-toggle]");


            buttons.forEach(button => {

                button.addEventListener(
                    "click",
                    () => {

                        const bodyId =
                            button.dataset.pathToggle;


                        const body =
                            document.getElementById(
                                bodyId);


                        if (!body) {
                            return;
                        }


                        const shouldOpen =
                            body.hidden;


                        body.hidden =
                            !shouldOpen;


                        button.setAttribute(
                            "aria-expanded",
                            shouldOpen
                                ? "true"
                                : "false");


                        const text =
                            button.querySelector(
                                ".path-toggle-text");


                        const icon =
                            button.querySelector(
                                ".path-toggle-icon");


                        if (text) {

                            text.textContent =
                                shouldOpen
                                    ? "Hide Path"
                                    : "View Path";

                        }


                        if (icon) {

                            icon.textContent =
                                shouldOpen
                                    ? "↑"
                                    : "↓";

                        }

                    });

            });

        })();
    </script>

}