@model IEnumerable<CommunicationProject.Models.Stm>

@{
    ViewData["Title"] = "STMs";
}

<h1>STMs</h1>

<p class="text-muted">
    Every STM belongs to the source site of its directional communication link
    and is connected automatically to the corresponding STM on the reverse link.
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>STM ID</th>
            <th>STM Number</th>
            <th>Site From</th>
            <th>Site To</th>
            <th>Connected STM</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            /*
             * IsFromSide is no longer needed.
             *
             * The STM belongs to Link.SiteFrom.
             * The opposite endpoint is Link.SiteTo.
             */
            var displayedSiteFrom = item.Link?.SiteFrom;
            var displayedSiteTo = item.Link?.SiteTo;

            <tr>
                <td>
                    @item.Id
                </td>

                <td>
                    STM @item.Number
                </td>

                <td>
                    @if (displayedSiteFrom != null)
                    {
                        <span>
                            @displayedSiteFrom.Id -
                            @displayedSiteFrom.Name
                        </span>
                    }
                    else
                    {
                        <span>Not available</span>
                    }
                </td>

                <td>
                    @if (displayedSiteTo != null)
                    {
                        <span>
                            @displayedSiteTo.Id -
                            @displayedSiteTo.Name
                        </span>
                    }
                    else
                    {
                        <span>Not available</span>
                    }
                </td>

                <td>
                    @if (item.ConnectedStm != null)
                    {
                        <div>
                            <strong>
                                STM @item.ConnectedStm.Number
                            </strong>
                        </div>

                        @if (item.ConnectedStm.Link?.SiteFrom != null)
                        {
                            <div class="text-muted">
                                @item.ConnectedStm.Link.SiteFrom.Id -
                                @item.ConnectedStm.Link.SiteFrom.Name
                            </div>
                        }
                    }
                    else
                    {
                        <span>Not connected</span>
                    }
                </td>

                <td>
                    <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-info">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>