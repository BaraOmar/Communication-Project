@model CommunicationProject.ViewModels.StmIndexViewModel

@{
    ViewData["Title"] = "STMs";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/stms.css"
          asp-append-version="true" />
}

<div class="stms-page">

    <!-- Header -->
    <div class="stms-header">

        <div>

            <h1 class="stms-title">
                STMs
            </h1>

            <p class="stms-subtitle">
                View STM units generated from communication links
                and their connected endpoints.
            </p>

        </div>

        <div class="stms-readonly">
            Read only
        </div>

    </div>


    <!-- Filters -->
    <div class="stms-card stms-filter-card">

        <form asp-action="Index"
              method="get">

            <div class="stms-filter-grid">

                <!-- Search -->
                <div class="stms-field">

                    <label for="search">
                        Search
                    </label>

                    <input id="search"
                           name="search"
                           value="@Model.Search"
                           class="stms-input"
                           placeholder="STM, link or site..." />

                </div>


                <!-- Site -->
                <div class="stms-field">

                    <label for="siteId">
                        Source site
                    </label>

                    <select id="siteId"
                            name="siteId"
                            class="stms-select">

                        <option value="">
                            All sites
                        </option>

                        @foreach (var site in Model.Sites)
                        {
                            if (Model.SiteId == site.Id)
                            {
                                <option value="@site.Id"
                                        selected>
                                    @site.Name
                                </option>
                            }
                            else
                            {
                                <option value="@site.Id">
                                    @site.Name
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- Connection -->
                <div class="stms-field">

                    <label for="connectionStatus">
                        Connection
                    </label>

                    <select id="connectionStatus"
                            name="connectionStatus"
                            class="stms-select">

                        <option value="">
                            All
                        </option>

                        @if (Model.ConnectionStatus == "connected")
                        {
                            <option value="connected" selected>
                                Connected
                            </option>
                        }
                        else
                        {
                            <option value="connected">
                                Connected
                            </option>
                        }

                        @if (Model.ConnectionStatus == "not-connected")
                        {
                            <option value="not-connected" selected>
                                Not connected
                            </option>
                        }
                        else
                        {
                            <option value="not-connected">
                                Not connected
                            </option>
                        }

                    </select>

                </div>


                <!-- Buttons -->
                <div class="stms-filter-actions">

                    <button type="submit"
                            class="stms-filter-btn">
                        Apply
                    </button>

                    <a asp-action="Index"
                           class="stms-reset-btn">
                        Clear
                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- Table -->
    <div class="stms-card stms-table-card">

        <div class="stms-table-header">

            <h2 class="stms-table-title">
                All STMs
            </h2>

            <span class="stms-count">
                @Model.TotalItems total
            </span>

        </div>


        <div class="table-responsive">

            <table class="stms-table">

                <thead>

                    <tr>

                        <th>
                            STM
                        </th>

                        <th>
                            Source
                        </th>

                        <th>
                            Destination
                        </th>

                        <th>
                            Connected STM
                        </th>

                        <th class="text-end">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Stms.Any())
                    {
                        foreach (var stm in Model.Stms)
                        {
                            <tr>

                                <!-- STM -->
                                <td>

                                    <span class="stm-number">
                                        STM @stm.Number
                                    </span>

                                </td>


                                <!-- Source -->
                                <td>

                                    <div class="stm-site">

                                        <span class="stm-site-name">
                                            @stm.Link.SiteFrom.Name
                                        </span>

                                        <span class="stm-site-id">
                                            @stm.Link.SiteFrom.Id
                                        </span>

                                    </div>

                                </td>


                                <!-- Destination -->
                                <td>

                                    <div class="stm-site">

                                        <span class="stm-site-name">
                                            @stm.Link.SiteTo.Name
                                        </span>

                                        <span class="stm-site-id">
                                            @stm.Link.SiteTo.Id
                                        </span>

                                    </div>

                                </td>


                                <!-- Connected STM -->
                                <td>

                                    @if (stm.ConnectedStm != null)
                                    {
                                        <div class="stm-connected">

                                            <span class="stm-connected-number">
                                                STM @stm.ConnectedStm.Number
                                            </span>

                                            @if (stm.ConnectedStm.Link?.SiteFrom != null)
                                            {
                                                <span class="stm-connected-site">
                                                    @stm.ConnectedStm.Link.SiteFrom.Name
                                                </span>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="stm-not-connected">
                                            Not connected
                                        </span>
                                    }

                                </td>


                                <!-- Action -->
                                <td>

                                    <div class="stm-actions">

                                        <a asp-action="Details"
                                               asp-route-id="@stm.Id"
                                               class="stm-view-link">
                                            View
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="stms-empty">

                                <div class="stms-empty-title">
                                    No STMs found
                                </div>

                                <p class="stms-empty-text">
                                    Try changing your search or filters.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- Compact Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="stms-pagination-area">

                <div class="stms-page-info">
                    Page @Model.PageNumber of @Model.TotalPages
                </div>


                <ul class="stms-pagination">

                    <!-- Previous -->
                    <li>

                        @if (Model.HasPreviousPage)
                        {
                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-connectionStatus="@Model.ConnectionStatus"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   class="stms-page-link">
                                ‹
                            </a>
                        }
                        else
                        {
                            <span class="stms-page-link disabled">
                                ‹
                            </span>
                        }

                    </li>


                    @{
                        int currentPage = Model.PageNumber;
                        int totalPages = Model.TotalPages;

                        int startPage =
                            Math.Max(2, currentPage - 2);

                        int endPage =
                            Math.Min(
                                totalPages - 1,
                                currentPage + 2);
                    }


                    <!-- Page 1 -->
                    <li>

                        <a asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-siteId="@Model.SiteId"
                               asp-route-connectionStatus="@Model.ConnectionStatus"
                               asp-route-pageNumber="1"
                               class="stms-page-link
                            @(currentPage == 1
                                                           ? "active"
                                                           : "")">
                            1
                        </a>

                    </li>


                    <!-- Left ellipsis -->
                    @if (startPage > 2)
                    {
                        <li>
                            <span class="stms-page-ellipsis">
                                …
                            </span>
                        </li>
                    }


                    <!-- Nearby -->
                    @for (int i = startPage;
                          i <= endPage;
                          i++)
                    {
                        <li>

                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-connectionStatus="@Model.ConnectionStatus"
                                   asp-route-pageNumber="@i"
                                   class="stms-page-link
                                @(currentPage == i
                                                                   ? "active"
                                                                   : "")">
                                @i
                            </a>

                        </li>
                    }


                    <!-- Right ellipsis -->
                    @if (endPage < totalPages - 1)
                    {
                        <li>
                            <span class="stms-page-ellipsis">
                                …
                            </span>
                        </li>
                    }


                    <!-- Last -->
                    @if (totalPages > 1)
                    {
                        <li>

                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-connectionStatus="@Model.ConnectionStatus"
                                   asp-route-pageNumber="@totalPages"
                                   class="stms-page-link
                                @(currentPage == totalPages
                                                                   ? "active"
                                                                   : "")">
                                @totalPages
                            </a>

                        </li>
                    }


                    <!-- Next -->
                    <li>

                        @if (Model.HasNextPage)
                        {
                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-connectionStatus="@Model.ConnectionStatus"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   class="stms-page-link">
                                ›
                            </a>
                        }
                        else
                        {
                            <span class="stms-page-link disabled">
                                ›
                            </span>
                        }

                    </li>

                </ul>

            </div>
        }

    </div>

</div>