@model CommunicationProject.ViewModels.CreateMuxTypeViewModel

@{
    ViewData["Title"] = "Add MUX Type";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/mux-types.css"
          asp-append-version="true" />
}

<div class="mux-type-form-page">

    <div class="mux-type-form-header">

        <a href="@Url.Action("Index", "MuxTypes")"
               data-fallback-url="@Url.Action("Index", "MuxTypes")"
               class="mux-type-back js-back-link">
            ← Back
        </a>

        <h1>Add MUX Type</h1>

        <p>
            Define the physical card structure and port capacity
            for a reusable MUX type.
        </p>

    </div>


    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="mux-type-validation">
        </div>


        <!-- Name -->

        <section class="mux-type-form-card">

            <div class="mux-type-section-heading">

                <span>GENERAL</span>

                <h2>MUX Type Information</h2>

            </div>


            <div class="mux-type-name-field">

                <label asp-for="Name">
                </label>

                <input asp-for="Name"
                       class="mux-type-input"
                       placeholder="Example: Ericsson AXE MUX" />

                <span asp-validation-for="Name"
                      class="mux-type-field-error">
                </span>

            </div>

        </section>


        <!-- Hardware cards -->

        <div class="mux-type-hardware-grid">


            <!-- Power -->

            <section class="mux-type-hardware-card">

                <div class="mux-type-hardware-header">

                    <div class="mux-type-hardware-icon">
                        P
                    </div>

                    <div>
                        <span>CARD CATEGORY</span>
                        <h2>LTU</h2>
                    </div>

                </div>


                <div class="mux-type-field">

                    <label asp-for="LtuCardCount">
                    </label>

                    <input asp-for="LtuCardCount"
                           class="mux-type-input mux-capacity-input"
                           min="0"
                           max="100" />

                    <span asp-validation-for="LtuCardCount"
                          class="mux-type-field-error">
                    </span>

                </div>


                <div class="mux-type-field">

                    <label asp-for="LtuPortsPerCard">
                    </label>

                    <input asp-for="LtuPortsPerCard"
                           class="mux-type-input mux-capacity-input"
                           min="0"
                           max="1000" />

                    <span asp-validation-for="LtuPortsPerCard"
                          class="mux-type-field-error">
                    </span>

                </div>


                <div class="mux-type-card-total">
                    <span>Total LTU Ports</span>
                    <strong id="ltuTotal">0</strong>
                </div>

            </section>



            <!-- STM -->

            <section class="mux-type-hardware-card">

                <div class="mux-type-hardware-header">

                    <div class="mux-type-hardware-icon">
                        S
                    </div>

                    <div>
                        <span>CARD CATEGORY</span>
                        <h2>STM</h2>
                    </div>

                </div>


                <div class="mux-type-field">

                    <label asp-for="StmCardCount">
                    </label>

                    <input asp-for="StmCardCount"
                           class="mux-type-input mux-capacity-input"
                           min="0"
                           max="100" />

                    <span asp-validation-for="StmCardCount"
                          class="mux-type-field-error">
                    </span>

                </div>


                <div class="mux-type-field">

                    <label asp-for="StmPortsPerCard">
                    </label>

                    <input asp-for="StmPortsPerCard"
                           class="mux-type-input mux-capacity-input"
                           min="0"
                           max="1000" />

                    <span asp-validation-for="StmPortsPerCard"
                          class="mux-type-field-error">
                    </span>

                </div>


                <div class="mux-type-card-total">

                    <span>Total STM Ports</span>

                    <strong id="stmTotal">
                        0
                    </strong>

                </div>

            </section>




        </div>


        <!-- Summary -->

        <section class="mux-type-live-summary">

            <div>

                <span>HARDWARE SUMMARY</span>

                <strong>
                    Current configuration
                </strong>

            </div>


            <div class="mux-type-summary-values">

                <div>
                    <span>Total Cards</span>
                    <strong id="totalCards">0</strong>
                </div>

                <div>
                    <span>Total Ports</span>
                    <strong id="totalPorts">0</strong>
                </div>

                <div>
                    <span>STM Capacity</span>
                    <strong id="summaryStmPorts">0</strong>
                </div>

                <div>
                    <span>LTU / E1 Capacity</span>
                    <strong id="summaryLtuPorts">0</strong>
                </div>

            </div>

        </section>


        <!-- Actions -->

        <div class="mux-type-form-actions">

            <a href="@Url.Action("Index", "MuxTypes")"
                   data-fallback-url="@Url.Action("Index", "MuxTypes")"
                   class="mux-type-cancel-btn js-back-link">

                Cancel

            </a>


            <button type="submit"
                    class="mux-types-primary-btn">

                Add MUX Type

            </button>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const fields = {
                ltuCount: document.getElementById("LtuCardCount"),
                ltuPorts: document.getElementById("LtuPortsPerCard"),
                stmCount: document.getElementById("StmCardCount"),
                stmPorts: document.getElementById("StmPortsPerCard")
            };

            function number(input) {
                return Math.max(0, Number(input.value) || 0);
            }

            function configurePorts(countInput, portsInput) {
                const hasCards = number(countInput) > 0;

                portsInput.disabled = !hasCards;

                if (!hasCards) {
                    portsInput.value = 0;
                }
            }

            function updateSummary() {
                configurePorts(fields.ltuCount, fields.ltuPorts);
                configurePorts(fields.stmCount, fields.stmPorts);

                const ltuCount = number(fields.ltuCount);
                const stmCount = number(fields.stmCount);

                const ltuTotal =
                    ltuCount * number(fields.ltuPorts);

                const stmTotal =
                    stmCount * number(fields.stmPorts);

                document.getElementById("ltuTotal").textContent =
                    ltuTotal;

                document.getElementById("stmTotal").textContent =
                    stmTotal;

                document.getElementById("totalCards").textContent =
                    ltuCount + stmCount;

                document.getElementById("totalPorts").textContent =
                    ltuTotal + stmTotal;

                document.getElementById("summaryLtuPorts").textContent =
                    ltuTotal;

                document.getElementById("summaryStmPorts").textContent =
                    stmTotal;
            }

            document.querySelectorAll(".mux-capacity-input")
                .forEach(input => {
                    input.addEventListener("input", updateSummary);
                });

            updateSummary();
        })();
    </script>
}