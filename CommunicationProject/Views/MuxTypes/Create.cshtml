@model CommunicationProject.ViewModels.CreateMuxTypeViewModel

@{
    ViewData["Title"] = "Add MUX Type";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/mux-types.css"
          asp-append-version="true" />
}

<div class="mux-type-form-page">

    <div class="mux-type-form-header">

        <a href="@Url.Action("Index", "MuxTypes")"
               data-fallback-url="@Url.Action("Index", "MuxTypes")"
               class="mux-type-back js-back-link">
            ← Back
        </a>

        <h1>Add MUX Type</h1>

        <p>
            Define the physical card structure and port capacity
            for a reusable MUX type.
        </p>

    </div>


    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="mux-type-validation">
        </div>


        <!-- Name -->

        <section class="mux-type-form-card">

            <div class="mux-type-section-heading">

                <span>GENERAL</span>

                <h2>MUX Type Information</h2>

            </div>


            <div class="mux-type-name-field">

                <label asp-for="Name">
                </label>

                <input asp-for="Name"
                       class="mux-type-input"
                       placeholder="Example: Ericsson AXE MUX" />

                <span asp-validation-for="Name"
                      class="mux-type-field-error">
                </span>

            </div>

        </section>


        <!-- Hardware cards -->

        <div class="mux-type-hardware-grid">


            <!-- Power -->

            <section class="mux-type-hardware-card">

                <div class="mux-type-hardware-header">

                    <div class="mux-type-hardware-icon">
                        P
                    </div>

                    <div>
                        <span>CARD CATEGORY</span>
                        <h2>Power</h2>
                    </div>

                </div>


                <div class="mux-type-field">

                    <label asp-for="PowerCardCount">
                    </label>

                    <input asp-for="PowerCardCount"
                           class="mux-type-input mux-capacity-input"
                           min="0"
                           max="100" />

                    <span asp-validation-for="PowerCardCount"
                          class="mux-type-field-error">
                    </span>

                </div>


                <div class="mux-type-field">

                    <label asp-for="PowerPortsPerCard">
                    </label>

                    <input asp-for="PowerPortsPerCard"
                           class="mux-type-input mux-capacity-input"
                           min="0"
                           max="1000" />

                    <span asp-validation-for="PowerPortsPerCard"
                          class="mux-type-field-error">
                    </span>

                </div>


                <div class="mux-type-card-total">

                    <span>Total Power Ports</span>

                    <strong id="powerTotal">
                        0
                    </strong>

                </div>

            </section>



            <!-- STM -->

            <section class="mux-type-hardware-card">

                <div class="mux-type-hardware-header">

                    <div class="mux-type-hardware-icon">
                        S
                    </div>

                    <div>
                        <span>CARD CATEGORY</span>
                        <h2>STM</h2>
                    </div>

                </div>


                <div class="mux-type-field">

                    <label asp-for="StmCardCount">
                    </label>

                    <input asp-for="StmCardCount"
                           class="mux-type-input mux-capacity-input"
                           min="0"
                           max="100" />

                    <span asp-validation-for="StmCardCount"
                          class="mux-type-field-error">
                    </span>

                </div>


                <div class="mux-type-field">

                    <label asp-for="StmPortsPerCard">
                    </label>

                    <input asp-for="StmPortsPerCard"
                           class="mux-type-input mux-capacity-input"
                           min="0"
                           max="1000" />

                    <span asp-validation-for="StmPortsPerCard"
                          class="mux-type-field-error">
                    </span>

                </div>


                <div class="mux-type-card-total">

                    <span>Total STM Ports</span>

                    <strong id="stmTotal">
                        0
                    </strong>

                </div>

            </section>



            <!-- E1 -->

            <section class="mux-type-hardware-card">

                <div class="mux-type-hardware-header">

                    <div class="mux-type-hardware-icon">
                        E1
                    </div>

                    <div>
                        <span>CARD CATEGORY</span>
                        <h2>E1</h2>
                    </div>

                </div>


                <div class="mux-type-field">

                    <label asp-for="E1CardCount">
                    </label>

                    <input asp-for="E1CardCount"
                           class="mux-type-input mux-capacity-input"
                           min="0"
                           max="100" />

                    <span asp-validation-for="E1CardCount"
                          class="mux-type-field-error">
                    </span>

                </div>


                <div class="mux-type-field">

                    <label asp-for="E1PortsPerCard">
                    </label>

                    <input asp-for="E1PortsPerCard"
                           class="mux-type-input mux-capacity-input"
                           min="0"
                           max="1000" />

                    <span asp-validation-for="E1PortsPerCard"
                          class="mux-type-field-error">
                    </span>

                </div>


                <div class="mux-type-card-total">

                    <span>Total E1 Ports</span>

                    <strong id="e1Total">
                        0
                    </strong>

                </div>

            </section>

        </div>


        <!-- Summary -->

        <section class="mux-type-live-summary">

            <div>

                <span>HARDWARE SUMMARY</span>

                <strong>
                    Current configuration
                </strong>

            </div>


            <div class="mux-type-summary-values">

                <div>
                    <span>Total Cards</span>
                    <strong id="totalCards">0</strong>
                </div>

                <div>
                    <span>Total Ports</span>
                    <strong id="totalPorts">0</strong>
                </div>

                <div>
                    <span>STM Capacity</span>
                    <strong id="summaryStmPorts">0</strong>
                </div>

                <div>
                    <span>E1 Capacity</span>
                    <strong id="summaryE1Ports">0</strong>
                </div>

            </div>

        </section>


        <!-- Actions -->

        <div class="mux-type-form-actions">

            <a href="@Url.Action("Index", "MuxTypes")"
                   data-fallback-url="@Url.Action("Index", "MuxTypes")"
                   class="mux-type-cancel-btn js-back-link">

                Cancel

            </a>


            <button type="submit"
                    class="mux-types-primary-btn">

                Add MUX Type

            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>
        (() => {

            const fields = {

                powerCount:
                    document.getElementById(
                        "PowerCardCount"),

                powerPorts:
                    document.getElementById(
                        "PowerPortsPerCard"),

                stmCount:
                    document.getElementById(
                        "StmCardCount"),

                stmPorts:
                    document.getElementById(
                        "StmPortsPerCard"),

                e1Count:
                    document.getElementById(
                        "E1CardCount"),

                e1Ports:
                    document.getElementById(
                        "E1PortsPerCard")
            };


            function number(input) {

                return Math.max(
                    0,
                    Number(input.value) || 0);

            }


            function configurePortsInput(
                countInput,
                portsInput) {

                const hasCards =
                    number(countInput) > 0;


                portsInput.disabled =
                    !hasCards;


                if (!hasCards) {
                    portsInput.value = 0;
                }

            }


            function updateSummary() {

                configurePortsInput(
                    fields.powerCount,
                    fields.powerPorts);

                configurePortsInput(
                    fields.stmCount,
                    fields.stmPorts);

                configurePortsInput(
                    fields.e1Count,
                    fields.e1Ports);


                const powerCount =
                    number(fields.powerCount);

                const powerPorts =
                    number(fields.powerPorts);

                const stmCount =
                    number(fields.stmCount);

                const stmPorts =
                    number(fields.stmPorts);

                const e1Count =
                    number(fields.e1Count);

                const e1Ports =
                    number(fields.e1Ports);


                const powerTotal =
                    powerCount * powerPorts;

                const stmTotal =
                    stmCount * stmPorts;

                const e1Total =
                    e1Count * e1Ports;


                document.getElementById(
                    "powerTotal")
                    .textContent =
                    powerTotal;


                document.getElementById(
                    "stmTotal")
                    .textContent =
                    stmTotal;


                document.getElementById(
                    "e1Total")
                    .textContent =
                    e1Total;


                document.getElementById(
                    "totalCards")
                    .textContent =
                    powerCount +
                    stmCount +
                    e1Count;


                document.getElementById(
                    "totalPorts")
                    .textContent =
                    powerTotal +
                    stmTotal +
                    e1Total;


                document.getElementById(
                    "summaryStmPorts")
                    .textContent =
                    stmTotal;


                document.getElementById(
                    "summaryE1Ports")
                    .textContent =
                    e1Total;

            }


            document.querySelectorAll(
                ".mux-capacity-input")
                .forEach(input => {

                    input.addEventListener(
                        "input",
                        updateSummary);

                });


            updateSummary();

        })();
    </script>

}