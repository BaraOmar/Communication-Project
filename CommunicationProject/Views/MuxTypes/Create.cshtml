@model CommunicationProject.ViewModels.CreateMuxTypeViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Add MUX Type";

    var initialCards = JsonSerializer.Serialize(
        Model.Cards,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/mux-types.css"
          asp-append-version="true" />
}

<div class="mux-type-form-page">
    <div class="mux-type-form-header">
        <h1>Add MUX Type</h1>
        <p>Choose a model and configure its default cards.</p>
    </div>

    <form asp-action="Create" method="post" id="muxTypeForm">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="mux-type-validation"></div>

        <section class="mux-type-form-card">
            <label asp-for="Model"></label>

            <select asp-for="Model"
                    asp-items="@(Html.GetEnumSelectList<MuxModel>()
                                                            .Where(item => item.Value != "0"))"
                    class="mux-type-input">
                <option value="">Select a model</option>
            </select>

            <span asp-validation-for="Model"
                  class="mux-type-field-error"></span>
        </section>

        <section class="mux-type-form-card">
            <h2>Default Cards</h2>

            <p id="structureHint">
                Required cards must remain in an installed MUX.
                Optional cards can be omitted during installation.
            </p>

            <p id="loadError" class="mux-type-field-error"
               role="alert"></p>

            <div class="mux-types-table-wrap">
                <table class="mux-types-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Section</th>
                            <th class="shelf-column">Shelf</th>
                            <th>Card Number</th>
                            <th>Ports</th>
                            <th>Required</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="cardRows"></tbody>
                </table>
            </div>

            <button type="button" id="addCard"
                    class="mux-types-primary-btn">
                + Add Card
            </button>
        </section>

        <div class="mux-type-form-actions">
            <a asp-action="Index" class="mux-type-cancel-btn">
                Cancel
            </a>

            <button type="submit" id="saveType"
                    class="mux-types-primary-btn">
                Save MUX Type
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const modelSelect = document.getElementById("Model");
            const body = document.getElementById("cardRows");
            const addButton = document.getElementById("addCard");
            const saveButton = document.getElementById("saveType");
            const error = document.getElementById("loadError");
            const hint = document.getElementById("structureHint");

            let cards = @Html.Raw(initialCards);
            let requestVersion = 0;

            const selectedModel = () => Number(modelSelect.value);
            const usesShelves = () => [1, 2].includes(selectedModel());
            const fixedStructure = () => [5, 6].includes(selectedModel());

            function readCards() {
                return [...body.querySelectorAll("tr")].map(row => ({
                    category: Number(row.querySelector('[data-field="Category"]').value),
                    section: Number(row.querySelector('[data-field="Section"]').value),
                    shelfNumber: Number(row.querySelector('[data-field="ShelfNumber"]').value),
                    slotNumber: Number(row.querySelector('[data-field="SlotNumber"]').value),
                    portCount: Number(row.querySelector('[data-field="PortCount"]').value),
                    isRequired: row.querySelector('[data-field="IsRequired"]').checked
                }));
            }

            function render() {
                const fixed = fixedStructure();
                const shelves = usesShelves();

                body.innerHTML = cards.map((card, index) => {
                    const name = field => `Cards[${index}].${field}`;

                    const hidden = (field, value) =>
                        `<input type="hidden" name="${name(field)}"
                            data-field="${field}" value="${value}">`;

                    const number = (field, value, minimum) =>
                        `<input type="number" name="${name(field)}"
                            data-field="${field}" value="${value}"
                            min="${minimum}" max="1000" required
                            class="mux-type-input"
                            ${fixed ? "readonly" : ""}>`;

                    const category = fixed
                        ? hidden("Category", card.category) +
                            (card.category === 0 ? "STM" : "LTU")
                        : `<select name="${name("Category")}"
                                data-field="Category" class="mux-type-input">
                              <option value="0"
                                ${card.category === 0 ? "selected" : ""}>STM</option>
                              <option value="1"
                                ${card.category === 1 ? "selected" : ""}>LTU</option>
                           </select>`;

                    const sectionName =
                        ["Standard", "Main", "Sub"][card.section];

                    const required = fixed
                        ? `<input type="checkbox" data-field="IsRequired"
                                checked disabled>
                           <input type="hidden" name="${name("IsRequired")}"
                                value="true">`
                        : `<input type="checkbox" name="${name("IsRequired")}"
                                data-field="IsRequired" value="true"
                                ${card.isRequired ? "checked" : ""}>
                           <input type="hidden" name="${name("IsRequired")}"
                                value="false">`;

                    return `<tr>
                        <td>${category}</td>
                        <td>
                            ${hidden("Section", card.section)}
                            ${sectionName}
                        </td>
                        <td class="shelf-column" ${shelves ? "" : "hidden"}>
                            ${shelves
                                ? number("ShelfNumber", card.shelfNumber, 1)
                                : hidden("ShelfNumber", 0)}
                        </td>
                        <td>${number("SlotNumber", card.slotNumber, 1)}</td>
                        <td>${number("PortCount", card.portCount, 1)}</td>
                        <td>${required}</td>
                        <td>
                            <button type="button" data-remove="${index}"
                                ${fixed ? "disabled" : ""}>
                                Remove
                            </button>
                        </td>
                    </tr>`;
                }).join("");

                document.querySelectorAll(".shelf-column")
                    .forEach(cell => cell.hidden = !shelves);

                addButton.hidden = fixed || !modelSelect.value;
                addButton.disabled = cards.length >= 100;

                hint.textContent = fixed
                    ? "This model uses its predefined card structure."
                    : "Set each card's actual position and port count. " +
                      "Required cards cannot be omitted during installation.";
            }

            addButton.addEventListener("click", () => {
                cards = readCards();

                if (cards.length >= 100)
                    return;

                cards.push({
                    category: 0,
                    section: 0,
                    shelfNumber: usesShelves() ? 1 : 0,
                    slotNumber: Math.max(0, ...cards.map(c => c.slotNumber)) + 1,
                    portCount: 1,
                    isRequired: true
                });

                render();
            });

            body.addEventListener("click", event => {
                const button = event.target.closest("[data-remove]");

                if (!button || fixedStructure())
                    return;

                cards = readCards();
                cards.splice(Number(button.dataset.remove), 1);
                render();
            });

            modelSelect.addEventListener("change", async () => {
                const version = ++requestVersion;

                cards = [];
                error.textContent = "";
                render();

                if (!modelSelect.value) {
                    saveButton.disabled = false;
                    return;
                }

                saveButton.disabled = true;
                addButton.disabled = true;

                try {
                    const response = await fetch(
                        '@Url.Action("GetDefaultCards", "MuxTypes")' +
                        '?model=' + encodeURIComponent(modelSelect.value));

                    if (!response.ok)
                        throw new Error("Unable to load the model structure.");

                    const data = await response.json();

                    if (version !== requestVersion)
                        return;

                    cards = data.cards;
                    render();
                    saveButton.disabled = false;
                } catch (problem) {
                    if (version !== requestVersion)
                        return;

                    error.textContent = problem.message;
                }
            });

            render();
        })();
    </script>
}