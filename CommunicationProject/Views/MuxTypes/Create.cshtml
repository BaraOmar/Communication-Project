@model CommunicationProject.Models.MuxType

@{
    ViewData["Title"] = "Add MUX Type";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Index"
               class="text-decoration-none">
            ← MUX Types
        </a>

        <h1 class="mt-3 mb-1">
            Add MUX Type
        </h1>

        <p class="text-muted mb-0">
            Define a new MUX type and whether it uses shelves.
        </p>
    </div>


    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-check mb-4">

                    <input asp-for="HasShelves"
                           class="form-check-input" />

                    <label asp-for="HasShelves"
                           class="form-check-label">
                        Uses Shelves
                    </label>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Add MUX Type
                    </button>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}