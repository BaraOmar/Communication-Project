@model IEnumerable<CommunicationProject.Models.MuxType>
@using CommunicationProject.Security

@{
    ViewData["Title"] = "MUX Types";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/mux-types.css"
          asp-append-version="true" />
}

<div class="mux-types-page">
    <div class="mux-types-header">
        <div>
            <h1 class="mux-types-title">MUX Types</h1>
            <p class="mux-types-subtitle">
                Default structures for site installations.
            </p>
        </div>

        @if (User.IsInRole(AppRoles.Admin) ||
             User.IsInRole(AppRoles.Operator))
        {
            <a asp-action="Create" class="mux-types-primary-btn">
                + Add MUX Type
            </a>
        }
    </div>

    @foreach (var type in Model)
    {
        var cards = type.DefaultCards
            .OrderBy(card => card.Section)
            .ThenBy(card => card.ShelfNumber)
            .ThenBy(card => card.SlotNumber)
            .ToList();

        <section class="mux-types-card">
            <div class="mux-types-card-header">
                <h2>@type.Name</h2>
                <span>
                    @cards.Count cards · @cards.Sum(card => card.PortCount) ports
                </span>
            </div>

            <div class="mux-types-table-wrap">
                <table class="mux-types-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Section</th>
                            <th>Shelf</th>
                            <th>Card Number</th>
                            <th>Ports</th>
                            <th>Installation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var card in cards)
                        {
                            <tr>
                                <td>@card.Category</td>
                                <td>@card.Section</td>
                                <td>
                                    @(card.ShelfNumber == 0
                                        ? "—"
                                        : card.ShelfNumber.ToString())
                                </td>
                                <td>@card.SlotNumber</td>
                                <td>@card.PortCount</td>
                                <td>@(card.IsRequired ? "Required" : "Optional")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (!Model.Any())
    {
        <p>No MUX types configured.</p>
    }
</div>