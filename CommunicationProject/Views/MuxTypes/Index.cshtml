@model IEnumerable<CommunicationProject.Models.MuxType>
@using CommunicationProject.Security

@{
    ViewData["Title"] = "MUX Types";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <h1 class="mb-1">
                MUX Types
            </h1>

            <p class="text-muted mb-0">
                Manage reusable MUX types and their card capacities.
            </p>
        </div>

        @if (User.IsInRole(AppRoles.Admin) ||
             User.IsInRole(AppRoles.Operator))
        {
            <a asp-action="Create"
                   class="btn btn-primary">
                Add MUX Type
            </a>
        }

    </div>


    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>MUX Type</th>
                                <th>Power Cards</th>
                                <th>STM Cards</th>
                                <th>E1 Cards</th>
                                <th>Total Ports</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var type in Model)
                            {
                                var totalPorts =
                                    (type.PowerCardCount *
                                     type.PowerPortsPerCard) +

                                    (type.StmCardCount *
                                     type.StmPortsPerCard) +

                                    (type.E1CardCount *
                                     type.E1PortsPerCard);

                                <tr>

                                    <td>
                                        <strong>
                                            @type.Name
                                        </strong>
                                    </td>


                                    <td>
                                        @if (type.PowerCardCount > 0)
                                        {
                                            <div>
                                                <strong>
                                                    @type.PowerCardCount
                                                </strong>
                                                cards

                                                <div class="small text-muted">
                                                    @type.PowerPortsPerCard
                                                    ports per card
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                None
                                            </span>
                                        }
                                    </td>


                                    <td>
                                        @if (type.StmCardCount > 0)
                                        {
                                            <div>
                                                <strong>
                                                    @type.StmCardCount
                                                </strong>
                                                cards

                                                <div class="small text-muted">
                                                    @type.StmPortsPerCard
                                                    ports per card
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                None
                                            </span>
                                        }
                                    </td>


                                    <td>
                                        @if (type.E1CardCount > 0)
                                        {
                                            <div>
                                                <strong>
                                                    @type.E1CardCount
                                                </strong>
                                                cards

                                                <div class="small text-muted">
                                                    @type.E1PortsPerCard
                                                    ports per card
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                None
                                            </span>
                                        }
                                    </td>


                                    <td>
                                        <span class="badge bg-primary">
                                            @totalPorts
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-muted">
                    No MUX types have been created yet.
                </div>
            }

        </div>
    </div>

</div>