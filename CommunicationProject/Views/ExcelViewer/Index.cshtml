@model CommunicationProject.ViewModels.ExcelUploadViewModel

@{
    ViewData["Title"] = "Excel Sheet";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">
            Excel Sheet
        </h1>

        <p class="text-muted mb-0">
            Upload an Excel file and preview its contents.
        </p>
    </div>


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-controller="ExcelViewer"
                  asp-action="Index"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3 align-items-end">

                    <div class="col-md-8">

                        <label asp-for="ExcelFile"
                               class="form-label">
                        </label>

                        <input asp-for="ExcelFile"
                               type="file"
                               accept=".xlsx"
                               class="form-control" />

                        <span asp-validation-for="ExcelFile"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Supported format: .xlsx.
                            Maximum file size: 10 MB.
                        </div>

                    </div>


                    <div class="col-md-4">

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Upload and Display
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    @if (Model.HasData)
    {
        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">

                <div class="d-flex flex-wrap
                    justify-content-between
                    align-items-center gap-2">

                    <div>
                        <strong>
                            @Model.FileName
                        </strong>

                        <div class="small text-muted">
                            Worksheet:
                            @Model.WorksheetName
                        </div>
                    </div>

                    <div class="small text-muted">
                        @Model.Rows.Count rows
                        ·
                        @Model.Headers.Count columns
                    </div>

                </div>

            </div>


            <div class="table-responsive">

                <table class="table table-hover
                    table-bordered
                    align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            @foreach (string header
                                      in Model.Headers)
                            {
                                <th>
                                    @header
                                </th>
                            }

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var row in Model.Rows)
                        {
                            <tr>

                                @foreach (string value in row)
                                {
                                    <td>
                                        @value
                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>