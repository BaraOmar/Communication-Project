@model CommunicationProject.ViewModels.ExcelUploadViewModel

@{
    ViewData["Title"] = "Excel Sheet";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">
            Excel Sheet
        </h1>

        <p class="text-muted mb-0">
            Select one or more Excel files and preview their contents.
        </p>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["ErrorMessage"]
        </div>
    }

    <form asp-controller="ExcelViewer"
          asp-action="Index"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <div class="row g-4">

            @for (int i = 0; i < Model.Files.Count; i++)
            {
                var fileItem = Model.Files[i];

                var profile =
                    Model.Profiles.FirstOrDefault(
                        p => p.Key == fileItem.ProfileKey);


                <div class="col-lg-6 col-xl-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body">

                            <input asp-for="Files[i].ProfileKey"
                                   type="hidden" />


                            <h5 class="card-title mb-1">
                                @fileItem.ProfileName
                            </h5>


                            @if (profile != null)
                            {
                                <p class="text-muted small">
                                    @profile.Description
                                </p>


                                @if (profile.RequiredColumns.Count > 0)
                                {
                                    <div class="mb-3">

                                        <div class="small fw-semibold mb-2">
                                            Required columns
                                        </div>

                                        <div class="d-flex flex-wrap gap-1">

                                            @foreach (var column
                                                      in profile.RequiredColumns)
                                            {
                                                <span class="badge
                                                    bg-light
                                                    text-dark
                                                    border">
                                                    @column
                                                </span>
                                            }

                                        </div>

                                    </div>
                                }
                            }


                            <div class="mt-3">

                                <label asp-for="Files[i].ExcelFile"
                                       class="form-label">
                                    Excel File
                                </label>

                                <input asp-for="Files[i].ExcelFile"
                                       type="file"
                                       accept=".xlsx"
                                       class="form-control" />

                                <span asp-validation-for="Files[i].ExcelFile"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">
                                    .xlsx only · Maximum 10 MB
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>


        <div class="d-flex justify-content-end mt-4">

            <button type="submit"
                    class="btn btn-primary px-5">

                Upload All Files

            </button>

        </div>

    </form>



    @if (Model.HasData)
    {
        <hr class="my-5" />


        <div class="mb-4">

            <h2 class="h4 mb-1">
                Uploaded Files
            </h2>

            <p class="text-muted mb-0">
                Preview of the successfully uploaded Excel files.
            </p>

        </div>


        @foreach (var fileItem in Model.Files.Where(x => x.HasData))
        {
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white py-3">

                    <div class="d-flex flex-wrap
                        justify-content-between
                        align-items-center
                        gap-3">

                        <div>

                            <span class="badge bg-primary mb-2">
                                @fileItem.ProfileName
                            </span>

                            <div>
                                <strong>
                                    @fileItem.FileName
                                </strong>
                            </div>

                            <div class="small text-muted">

                                Worksheet:
                                @fileItem.WorksheetName

                            </div>

                        </div>


                        <div class="small text-muted">

                            @fileItem.Rows.Count rows
                            ·
                            @fileItem.Headers.Count columns

                        </div>

                    </div>

                </div>


                <div class="table-responsive">

                    <table class="table
                        table-hover
                        table-bordered
                        align-middle
                        mb-0">

                        <thead class="table-light">

                            <tr>

                                @foreach (var header
                                          in fileItem.Headers)
                                {
                                    <th>
                                        @header
                                    </th>
                                }

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var row
                                      in fileItem.Rows)
                            {
                                <tr>

                                    @foreach (var value in row)
                                    {
                                        <td>
                                            @value
                                        </td>
                                    }

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
                @if (fileItem.ProfileKey == "communication-links")
                {
                    <div class="card-footer bg-white py-3">

                        <form asp-controller="ExcelViewer"
                              asp-action="ImportCommunicationLinks"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="ProfileKey"
                                   value="@fileItem.ProfileKey" />

                            <input type="hidden"
                                   name="ProfileName"
                                   value="@fileItem.ProfileName" />

                            @for (int h = 0;
                                  h < fileItem.Headers.Count;
                                  h++)
                            {
                                <input type="hidden"
                                       name="Headers[@h]"
                                       value="@fileItem.Headers[h]" />
                            }

                            @for (int r = 0;
                                  r < fileItem.Rows.Count;
                                  r++)
                            {
                                @for (int c = 0;
                                      c < fileItem.Rows[r].Count;
                                      c++)
                                {
                                    <input type="hidden"
                                           name="Rows[@r][@c]"
                                           value="@fileItem.Rows[r][c]" />
                                }
                            }

                            <div class="d-flex justify-content-end">

                                <button type="submit"
                                        class="btn btn-success px-4">

                                    Import to Database

                                </button>

                            </div>

                        </form>

                    </div>
                }
            </div>
        }
    }

</div>