@model CommunicationProject.ViewModels.E1IndexViewModel
@using CommunicationProject.Models

@{
    ViewData["Title"] = "E1 Channels";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/e1channels.css"
          asp-append-version="true" />
}


<div class="e1-page">

    <!-- Header -->
    <div class="e1-header">

        <div>

            <h1 class="e1-title">
                E1 Channels
            </h1>

            <p class="e1-subtitle">
                Browse E1 channels, their STM routes,
                connections and cross-connection states.
            </p>

        </div>


        <span class="e1-readonly">
            Read only
        </span>

    </div>


    <!-- Filters -->
    <div class="e1-card e1-filter-card">

        <form asp-action="Index"
              method="get">

            <div class="e1-filter-grid">

                <!-- Search -->
                <div class="e1-field">

                    <label for="search">
                        Search
                    </label>

                    <input id="search"
                           name="search"
                           value="@Model.Search"
                           class="e1-input"
                           placeholder="E1 or STM..." />

                </div>


                <!-- Site From -->
                <div class="e1-field">

                    <label for="siteFromId">
                        Site From
                    </label>

                    <select id="siteFromId"
                            name="siteFromId"
                            class="e1-select">

                        <option value="">
                            All sites
                        </option>

                        @foreach (var site in Model.Sites)
                        {
                            <option value="@site.Id"
                                    selected="@(site.Id == Model.SiteFromId)">
                                @site.Name
                            </option>
                        }

                    </select>

                </div>


                <!-- Site To -->
                <div class="e1-field">

                    <label for="siteToId">
                        Site To
                    </label>

                    <select id="siteToId"
                            name="siteToId"
                            class="e1-select">

                        <option value="">
                            All sites
                        </option>

                        @foreach (var site in Model.Sites)
                        {
                            <option value="@site.Id"
                                    selected="@(site.Id == Model.SiteToId)">
                                @site.Name
                            </option>
                        }

                    </select>

                </div>

                <!-- Description -->
                <div class="e1-field">

                    <label for="description">
                        Description
                    </label>

                    <input id="description"
                           name="description"
                           value="@Model.Description"
                           class="e1-input"
                           placeholder="Search description..." />

                </div>


                <!-- Connection -->
                <div class="e1-field">

                    <label for="connectionStatus">
                        Connection
                    </label>

                    <select id="connectionStatus"
                            name="connectionStatus"
                            class="e1-select">

                        <option value="">
                            All
                        </option>

                        <option value="connected"
                                selected="@(Model.ConnectionStatus == "connected")">
                            Connected
                        </option>

                        <option value="not-connected"
                                selected="@(Model.ConnectionStatus == "not-connected")">
                            Not connected
                        </option>

                    </select>

                </div>


                <!-- State -->
                <div class="e1-field">

                    <label for="state">
                        State
                    </label>

                    <select id="state"
                            name="state"
                            class="e1-select">

                        <option value="">
                            All states
                        </option>

                        <option value="Available"
                                selected="@(Model.State == "Available")">
                            Available
                        </option>

                        <option value="CrossConnected"
                                selected="@(Model.State == "CrossConnected")">
                            Cross connected
                        </option>

                        <option value="ExtendExistingPath"
                                selected="@(Model.State == "ExtendExistingPath")">
                            Extended path
                        </option>

                    </select>

                </div>
                <!-- Operational Status -->
                <div class="e1-field">

                    <label for="operationalStatus">
                        Operational Status
                    </label>

                    <select id="operationalStatus"
                            name="operationalStatus"
                            class="e1-select">

                        <option value="">
                            All statuses
                        </option>

                        <option value="Available"
                                selected="@(Model.OperationalStatus == "Available")">
                            Available
                        </option>

                        <option value="Connected"
                                selected="@(Model.OperationalStatus == "Connected")">
                            Connected
                        </option>

                        <option value="Wrong"
                                selected="@(Model.OperationalStatus == "Wrong")">
                            Wrong
                        </option>

                        <option value="Damaged"
                                selected="@(Model.OperationalStatus == "Damaged")">
                            Damaged
                        </option>

                    </select>

                </div>
                <div class="e1-field">

                    <label for="connectionType">
                        Connection Type
                    </label>

                    <select id="connectionType"
                            name="connectionType"
                            class="e1-select">

                        <option value="">
                            All types
                        </option>

                        <option value="Physical"
                                selected="@(Model.ConnectionType == "Physical")">
                            Physical
                        </option>

                        <option value="Logical"
                                selected="@(Model.ConnectionType == "Logical")">
                            Logical
                        </option>

                    </select>

                </div>
                <div class="e1-filter-actions">

                    <button type="submit"
                            class="e1-filter-btn">
                        Apply
                    </button>

                    <a asp-action="Index"
                           class="e1-clear-btn">
                        Clear
                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- Table -->
    <div class="e1-card e1-table-card">

        <div class="e1-table-header">

            <h2 class="e1-table-title">
                All E1 Channels
            </h2>

            <span class="e1-count">
                @Model.TotalItems total
            </span>

        </div>


        <div class="table-responsive">

            <table class="e1-table">

                <thead>

                    <tr>
                        <th>E1</th>
                        <th>STM</th>
                        <th>Route</th>
                        <th>Connected E1</th>
                        <th>Cross Connection State</th>
                        <th>Status</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th class="text-end">Action</th>
                    </tr>

                </thead>


                <tbody>

                    @if (Model.E1Channels.Any())
                    {
                        foreach (var item in Model.E1Channels)
                        {
                            string stateClass =
                                item.CrossConnectionState switch
                                {
                                    E1CrossConnectionState.CrossConnected =>
                                        "e1-state-cross",

                                    E1CrossConnectionState.ExtendExistingPath =>
                                        "e1-state-path",

                                    _ =>
                                        "e1-state-available"
                                };


                            string stateText =
                                item.CrossConnectionState switch
                                {
                                    E1CrossConnectionState.CrossConnected =>
                                        "Cross connected",

                                    E1CrossConnectionState.ExtendExistingPath =>
                                        "Extended path",

                                    _ =>
                                        "Available"
                                };


                            <tr>

                                <!-- E1 -->
                                <td>
                                    <span class="e1-number">
                                        E1 @item.E1Number
                                    </span>
                                </td>


                                <!-- STM -->
                                <td>
                                    <span class="e1-stm">
                                        STM @item.Stm.Number
                                    </span>
                                </td>


                                <!-- Route -->
                                <td>

                                    <div class="e1-route">

                                        <div class="e1-route-site">

                                            <span class="e1-route-name">
                                                @item.Stm.Link.SiteFrom.Name
                                            </span>

                                            <span class="e1-route-id">
                                                @item.Stm.Link.SiteFrom.Id
                                            </span>

                                        </div>


                                        <span class="e1-route-arrow">
                                            →
                                        </span>


                                        <div class="e1-route-site">

                                            <span class="e1-route-name">
                                                @item.Stm.Link.SiteTo.Name
                                            </span>

                                            <span class="e1-route-id">
                                                @item.Stm.Link.SiteTo.Id
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- Connected -->
                                <td>

                                    @if (item.ConnectedE1 != null)
                                    {
                                        <div class="e1-connection">

                                            <span class="e1-connected-number">
                                                E1 @item.ConnectedE1.E1Number
                                            </span>

                                            <span class="e1-connected-stm">
                                                STM @item.ConnectedE1.Stm.Number
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="e1-not-connected">
                                            Not connected
                                        </span>
                                    }

                                </td>


                                <!-- State -->
                                <td>

                                    <span class="e1-state @stateClass">
                                        @stateText
                                    </span>

                                </td>
                                <td>

                                    <span class="e1-state">
                                        @item.Status
                                    </span>

                                </td>
                                <td>
                                    @item.ConnectionType
                                </td>
                                <!-- Description -->
                                <td>

                                    <span class="e1-description"
                                          title="@item.Description">

                                        @(string.IsNullOrWhiteSpace(item.Description)
                                            ? "—"
                                            : item.Description)

                                    </span>

                                </td>


                                <!-- Action -->
                                <td>

                                    <div class="e1-actions">

                                        <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="e1-view-link">
                                            View
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9"
                                class="e1-empty">

                                <div class="e1-empty-title">
                                    No E1 channels found
                                </div>

                                <p class="e1-empty-text">
                                    Try changing your search or filters.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="e1-pagination-area">

                <div class="e1-page-info">
                    Showing @Model.FirstItem–@Model.LastItem
                    of @Model.TotalItems
                </div>


                <ul class="e1-pagination">

                    <li>

                        @if (Model.HasPreviousPage)
                        {
                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-siteFromId="@Model.SiteFromId"
                                   asp-route-siteToId="@Model.SiteToId"
                                   asp-route-description="@Model.Description"
                                   asp-route-connectionStatus="@Model.ConnectionStatus"
                                   asp-route-state="@Model.State"
                                   asp-route-operationalStatus="@Model.OperationalStatus"
                                   asp-route-connectionType="@Model.ConnectionType"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   class="e1-page-link">
                                ‹
                            </a>
                        }
                        else
                        {
                            <span class="e1-page-link disabled">
                                ‹
                            </span>
                        }

                    </li>


                    @{
                        int currentPage = Model.PageNumber;
                        int totalPages = Model.TotalPages;

                        int startPage =
                            Math.Max(2, currentPage - 2);

                        int endPage =
                            Math.Min(
                                totalPages - 1,
                                currentPage + 2);
                    }


                    <!-- First -->
                    <li>

                        <a asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-siteFromId="@Model.SiteFromId"
                               asp-route-siteToId="@Model.SiteToId"
                               asp-route-description="@Model.Description"
                               asp-route-connectionStatus="@Model.ConnectionStatus"
                               asp-route-state="@Model.State"
                               asp-route-operationalStatus="@Model.OperationalStatus"
                               asp-route-connectionType="@Model.ConnectionType"
                               asp-route-pageNumber="1"
                               class="e1-page-link
                            @(currentPage == 1 ? "active" : "")">

                            1

                        </a>

                    </li>


                    @if (startPage > 2)
                    {
                        <li>
                            <span class="e1-page-ellipsis">
                                …
                            </span>
                        </li>
                    }


                    @for (int i = startPage;
                          i <= endPage;
                          i++)
                    {
                        <li>

                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-siteFromId="@Model.SiteFromId"
                                   asp-route-siteToId="@Model.SiteToId"
                                   asp-route-description="@Model.Description"
                                   asp-route-connectionStatus="@Model.ConnectionStatus"
                                   asp-route-state="@Model.State"
                                   asp-route-operationalStatus="@Model.OperationalStatus"
                                   asp-route-connectionType="@Model.ConnectionType"
                                   asp-route-pageNumber="@i"
                                   class="e1-page-link
                                @(currentPage == i ? "active" : "")">

                                @i

                            </a>

                        </li>
                    }


                    @if (endPage < totalPages - 1)
                    {
                        <li>
                            <span class="e1-page-ellipsis">
                                …
                            </span>
                        </li>
                    }


                    @if (totalPages > 1)
                    {
                        <li>

                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-siteFromId="@Model.SiteFromId"
                                   asp-route-siteToId="@Model.SiteToId"
                                   asp-route-description="@Model.Description"
                                   asp-route-connectionStatus="@Model.ConnectionStatus"
                                   asp-route-state="@Model.State"
                                   asp-route-operationalStatus="@Model.OperationalStatus"
                                   asp-route-connectionType="@Model.ConnectionType"
                                   asp-route-pageNumber="@totalPages"
                                   class="e1-page-link
                                @(currentPage == totalPages ? "active" : "")">

                                @totalPages

                            </a>

                        </li>
                    }


                    <li>

                        @if (Model.HasNextPage)
                        {
                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-siteFromId="@Model.SiteFromId"
                                   asp-route-siteToId="@Model.SiteToId"
                                   asp-route-description="@Model.Description"
                                   asp-route-connectionStatus="@Model.ConnectionStatus"
                                   asp-route-state="@Model.State"
                                   asp-route-operationalStatus="@Model.OperationalStatus"
                                   asp-route-connectionType="@Model.ConnectionType"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   class="e1-page-link">
                                ›
                            </a>
                        }
                        else
                        {
                            <span class="e1-page-link disabled">
                                ›
                            </span>
                        }

                    </li>

                </ul>

            </div>
        }

    </div>

</div>