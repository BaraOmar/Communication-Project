@model CommunicationProject.Models.E1

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>E1</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="E1Number" class="control-label"></label>
                <input asp-for="E1Number"
                       class="form-control" />
                <span asp-validation-for="E1Number"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StmId" class="control-label"></label>
                <select asp-for="StmId"
                        class="form-select"
                        asp-items="ViewBag.StmId">
                    <option value="">-- Select STM --</option>
                </select>
                <span asp-validation-for="StmId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConnectedE1Id" class="control-label"></label>
                <select asp-for="ConnectedE1Id"
                        class="form-select"
                        asp-items="ViewBag.ConnectedE1Id">
                    <option value="">-- No Connected E1 --</option>
                </select>
                <span asp-validation-for="ConnectedE1Id"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Create"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
