@model CommunicationProject.ViewModels.CommunicationLinkIndexViewModel

@{
    ViewData["Title"] = "Communication Links";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/links.css"
          asp-append-version="true" />
}


<div class="links-page">

    <!-- Header -->
    <div class="links-header">

        <div>

            <h1 class="links-title">
                Communication Links
            </h1>

            <p class="links-subtitle">
                Manage network links, routes and generated
                STM/E1 inventory.
            </p>

        </div>


        <div class="links-header-actions">

            <a asp-action="Import"
                   class="links-secondary-btn">
                Import
            </a>

            <a asp-action="Create"
                   class="links-primary-btn">
                <span>＋</span>
                New link
            </a>

        </div>

    </div>


    <!-- Filters -->
    <div class="links-card links-filter-card">

        <form asp-action="Index"
              method="get">

            <div class="links-filter-grid">


                <!-- Search -->
                <div class="links-field">

                    <label for="search">
                        Search
                    </label>

                    <input id="search"
                           name="search"
                           value="@Model.Search"
                           class="links-input"
                           placeholder="Name, type, site or capacity..." />

                </div>


                <!-- Type -->
                <div class="links-field">

                    <label for="linkTypeId">
                        Link type
                    </label>

                    <select id="linkTypeId"
                            name="linkTypeId"
                            class="links-select">

                        <option value="">
                            All types
                        </option>

                        @foreach (var type in Model.LinkTypes)
                        {
                            if (Model.LinkTypeId == type.Id)
                            {
                                <option value="@type.Id"
                                        selected>
                                    @type.Name
                                </option>
                            }
                            else
                            {
                                <option value="@type.Id">
                                    @type.Name
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- Site -->
                <div class="links-field">

                    <label for="siteId">
                        Site
                    </label>

                    <select id="siteId"
                            name="siteId"
                            class="links-select">

                        <option value="">
                            All sites
                        </option>

                        @foreach (var site in Model.Sites)
                        {
                            if (Model.SiteId == site.Id)
                            {
                                <option value="@site.Id"
                                        selected>
                                    @site.Name
                                </option>
                            }
                            else
                            {
                                <option value="@site.Id">
                                    @site.Name
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- Inventory -->
                <div class="links-field">

                    <label for="inventoryStatus">
                        Inventory
                    </label>

                    <select id="inventoryStatus"
                            name="inventoryStatus"
                            class="links-select">

                        <option value="">
                            All
                        </option>

                        @if (Model.InventoryStatus == "generated")
                        {
                            <option value="generated"
                                    selected>
                                Generated
                            </option>
                        }
                        else
                        {
                            <option value="generated">
                                Generated
                            </option>
                        }

                        @if (Model.InventoryStatus == "not-generated")
                        {
                            <option value="not-generated"
                                    selected>
                                Not generated
                            </option>
                        }
                        else
                        {
                            <option value="not-generated">
                                Not generated
                            </option>
                        }

                    </select>

                </div>


                <!-- Buttons -->
                <div class="links-filter-actions">

                    <button type="submit"
                            class="links-filter-btn">
                        Apply
                    </button>

                    <a asp-action="Index"
                           class="links-clear-btn">
                        Clear
                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- Table -->
    <div class="links-card links-table-card">

        <div class="links-table-header">

            <h2 class="links-table-title">
                All links
            </h2>


            <span class="links-count">
                @Model.TotalItems total
            </span>

        </div>


        <div class="table-responsive">

            <table class="links-table">

                <thead>

                    <tr>

                        <th>
                            Link
                        </th>

                        <th>
                            Type
                        </th>

                        <th>
                            Route
                        </th>

                        <th>
                            Capacity
                        </th>

                        <th>
                            Inventory
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Links.Any())
                    {
                        foreach (var link in Model.Links)
                        {
                            <tr>

                                <!-- Name -->
                                <td>

                                    <span class="link-name">
                                        @link.Name
                                    </span>

                                </td>


                                <!-- Type -->
                                <td>

                                    <span class="link-type">
                                        @link.LinkTypeName
                                    </span>

                                </td>


                                <!-- Route -->
                                <td>

                                    <div class="link-route">

                                        <div class="link-route-site">

                                            <span class="link-route-name">
                                                @link.SiteFromName
                                            </span>

                                            <span class="link-route-id">
                                                @link.SiteFromId
                                            </span>

                                        </div>


                                        <span class="link-route-arrow">
                                            →
                                        </span>


                                        <div class="link-route-site">

                                            <span class="link-route-name">
                                                @link.SiteToName
                                            </span>

                                            <span class="link-route-id">
                                                @link.SiteToId
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- Capacity -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        link.Capacity))
                                    {
                                        <span class="link-capacity">
                                            @link.Capacity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="link-empty-value">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- Inventory -->
                                <td>

                                    @if (link.StmCount > 0)
                                    {
                                        <span class="
                                            link-inventory
                                            link-inventory-generated">

                                            @link.StmCount
                                            STM@(link.StmCount == 1 ? "" : "s")
                                            / direction

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="
                                            link-inventory
                                            link-inventory-empty">

                                            Not generated

                                        </span>
                                    }

                                </td>


                                <!-- Actions -->
                                <td>

                                    <div class="link-actions">

                                        <a asp-action="Details"
                                               asp-route-id="@link.Id"
                                               class="
                                            link-action
                                            link-action-view">
                                            View
                                        </a>

                                        <a asp-action="Edit"
                                               asp-route-id="@link.Id"
                                               class="
                                            link-action
                                            link-action-edit">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                               asp-route-id="@link.Id"
                                               class="
                                            link-action
                                            link-action-delete">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="links-empty">

                                <div class="links-empty-title">
                                    No communication links found
                                </div>

                                <p class="links-empty-text">
                                    Try changing your search or filters.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="links-pagination-area">

                <div class="links-page-info">

                    Showing
                    @Model.FirstItem–@Model.LastItem
                    of
                    @Model.TotalItems

                </div>


                <ul class="links-pagination">

                    <!-- Previous -->
                    <li>

                        @if (Model.HasPreviousPage)
                        {
                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-linkTypeId="@Model.LinkTypeId"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-inventoryStatus="@Model.InventoryStatus"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   class="links-page-link">
                                ‹
                            </a>
                        }
                        else
                        {
                            <span class="
                                links-page-link
                                disabled">
                                ‹
                            </span>
                        }

                    </li>


                    @{
                        int currentPage =
                            Model.PageNumber;

                        int totalPages =
                            Model.TotalPages;

                        int startPage =
                            Math.Max(
                                2,
                                currentPage - 2);

                        int endPage =
                            Math.Min(
                                totalPages - 1,
                                currentPage + 2);
                    }


                    <!-- First -->
                    <li>

                        <a asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-linkTypeId="@Model.LinkTypeId"
                               asp-route-siteId="@Model.SiteId"
                               asp-route-inventoryStatus="@Model.InventoryStatus"
                               asp-route-pageNumber="1"
                               class="links-page-link
                            @(currentPage == 1
                                                           ? "active"
                                                           : "")">

                            1

                        </a>

                    </li>


                    <!-- Left Ellipsis -->
                    @if (startPage > 2)
                    {
                        <li>

                            <span class="links-page-ellipsis">
                                …
                            </span>

                        </li>
                    }


                    <!-- Nearby Pages -->
                    @for (int i = startPage;
                          i <= endPage;
                          i++)
                    {
                        <li>

                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-linkTypeId="@Model.LinkTypeId"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-inventoryStatus="@Model.InventoryStatus"
                                   asp-route-pageNumber="@i"
                                   class="links-page-link
                                @(currentPage == i
                                                                   ? "active"
                                                                   : "")">

                                @i

                            </a>

                        </li>
                    }


                    <!-- Right Ellipsis -->
                    @if (endPage < totalPages - 1)
                    {
                        <li>

                            <span class="links-page-ellipsis">
                                …
                            </span>

                        </li>
                    }


                    <!-- Last -->
                    @if (totalPages > 1)
                    {
                        <li>

                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-linkTypeId="@Model.LinkTypeId"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-inventoryStatus="@Model.InventoryStatus"
                                   asp-route-pageNumber="@totalPages"
                                   class="links-page-link
                                @(currentPage == totalPages
                                                                   ? "active"
                                                                   : "")">

                                @totalPages

                            </a>

                        </li>
                    }


                    <!-- Next -->
                    <li>

                        @if (Model.HasNextPage)
                        {
                            <a asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-linkTypeId="@Model.LinkTypeId"
                                   asp-route-siteId="@Model.SiteId"
                                   asp-route-inventoryStatus="@Model.InventoryStatus"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   class="links-page-link">
                                ›
                            </a>
                        }
                        else
                        {
                            <span class="
                                links-page-link
                                disabled">
                                ›
                            </span>
                        }

                    </li>

                </ul>

            </div>
        }

    </div>


    <!-- Inventory Tool -->
    <div class="mt-3 d-flex justify-content-end">

        <form asp-action="GenerateStmsAndE1sFromCapacity"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="links-utility-btn"
                    onclick="return confirm(
                'Generate STM and E1 inventory from configured link capacities?');">

                Generate inventory from capacity

            </button>

        </form>

    </div>

</div>