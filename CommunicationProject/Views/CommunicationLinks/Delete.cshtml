@model CommunicationProject.Models.CommunicationLink

@{
    ViewData["Title"] = "Delete Communication Link";

    int primaryStmCount =
        Model.Stms?.Count ?? 0;

    int reverseStmCount =
        Model.ConnectedLink?.Stms?.Count ?? 0;

    int totalStmCount =
        primaryStmCount + reverseStmCount;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/links.css"
          asp-append-version="true" />
}


<div class="link-delete-page">

    <!-- Header -->
    <div class="links-form-top">

        <a href="#"
               class="links-back-link js-back-link"
               data-fallback-url="@Url.Action(
                                      "Details",
                                      "CommunicationLinks",
                                      new { id = Model.Id })">

            ← Back

        </a>


        <div class="links-form-heading">

            <div class="link-delete-heading-icon">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M4 7h16"></path>
                    <path d="M10 11v6"></path>
                    <path d="M14 11v6"></path>
                    <path d="M6 7l1 13h10l1-13"></path>
                    <path d="M9 7V4h6v3"></path>

                </svg>

            </div>


            <div>

                <h1 class="links-form-title">
                    Delete Communication Link
                </h1>

                <p class="links-form-subtitle">
                    Review what will be removed
                    before continuing.
                </p>

            </div>

        </div>

    </div>


    <div class="links-card link-delete-card">

        <!-- Warning -->
        <div class="link-delete-warning">

            <div class="link-delete-warning-icon">
                !
            </div>


            <div>

                <div class="link-delete-warning-title">
                    Permanent action
                </div>

                <p class="link-delete-warning-text">
                    Deleting this communication link removes
                    both directional records together with
                    their related STM and E1 inventory.
                </p>

            </div>

        </div>


        <div asp-validation-summary="ModelOnly"
             class="links-validation-summary">
        </div>


        <!-- Summary -->
        <div class="link-delete-summary">

            <div class="link-delete-summary-header">

                <div>

                    <div class="link-delete-name">
                        @Model.Name
                    </div>

                    <div class="link-delete-caption">
                        Communication Link
                    </div>

                </div>


                <span class="link-details-type-badge">
                    @Model.LinkType.Name
                </span>

            </div>


            <div class="link-delete-grid">

                <!-- Source -->
                <div class="link-delete-field">

                    <div class="link-detail-label">
                        Source
                    </div>

                    <div class="link-detail-value">
                        @Model.SiteFrom.Name
                    </div>

                    <div class="link-details-route-id">
                        @Model.SiteFrom.Id
                    </div>

                </div>


                <!-- Destination -->
                <div class="link-delete-field">

                    <div class="link-detail-label">
                        Destination
                    </div>

                    <div class="link-detail-value">
                        @Model.SiteTo.Name
                    </div>

                    <div class="link-details-route-id">
                        @Model.SiteTo.Id
                    </div>

                </div>


                <!-- Type -->
                <div class="link-delete-field">

                    <div class="link-detail-label">
                        Link Type
                    </div>

                    <div class="link-detail-value">
                        @Model.LinkType.Name
                    </div>

                </div>


                <!-- Capacity -->
                <div class="link-delete-field">

                    <div class="link-detail-label">
                        Capacity
                    </div>

                    <div class="link-detail-value">

                        @(string.IsNullOrWhiteSpace(Model.Capacity)
                            ? "—"
                            : Model.Capacity)

                    </div>

                </div>

            </div>


            <div class="link-delete-inventory">

                <div class="link-delete-inventory-icon">
                    i
                </div>


                <div>

                    <strong>
                        @totalStmCount STM records
                    </strong>

                    <span>
                        will be affected across both directions.
                    </span>

                    <div class="link-delete-inventory-detail">

                        @Model.SiteFrom.Id
                        →
                        @Model.SiteTo.Id:
                        @primaryStmCount

                        &nbsp; · &nbsp;

                        @Model.SiteTo.Id
                        →
                        @Model.SiteFrom.Id:
                        @reverseStmCount

                    </div>

                </div>

            </div>

        </div>


        <!-- Actions -->
        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />


            <div class="link-delete-actions">

                <a href="#"
                       class="links-form-cancel js-back-link"
                       data-fallback-url="@Url.Action(
                                                              "Details",
                                                              "CommunicationLinks",
                                                              new { id = Model.Id })">

                    Cancel

                </a>


                <button type="submit"
                        class="link-delete-btn">

                    <span class="link-delete-btn-icon">
                        ×
                    </span>

                    Delete Link

                </button>

            </div>

        </form>

    </div>

</div>