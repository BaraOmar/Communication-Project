@model CommunicationProject.ViewModels.CommunicationLinkCreateViewModel
@using CommunicationProject.Models
@using CommunicationProject.Security

@{
    ViewData["Title"] = "Create Communication Link";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Index"
               class="text-decoration-none">
            ← Communication Links
        </a>

        <h1 class="mt-3 mb-1">
            Create Communication Link
        </h1>

        <p class="text-muted mb-0">
            Create an SDH or PDH link between two sites.
        </p>
    </div>


    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">

                <h5 class="mb-3">
                    Link Sites
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="SiteFromId"
                               class="form-label">
                        </label>

                        @if (Model.LockSiteFrom)
                        {
                            <input asp-for="SiteFromId"
                                   type="hidden" />

                            <input asp-for="LockSiteFrom"
                                   type="hidden" />

                            <input value="@Model.SiteFromId"
                                   class="form-control"
                                   disabled />

                            <div class="form-text">
                                The source site is fixed to the site you opened.
                            </div>
                        }
                        else
                        {
                            <select asp-for="SiteFromId"
                                    asp-items="Model.SiteOptions"
                                    class="form-select">

                                <option value="">
                                    Select source site
                                </option>

                            </select>
                        }

                        <span asp-validation-for="SiteFromId"
                              class="text-danger">
                        </span>
                    </div>


                    <div class="col-md-6">
                        <label asp-for="SiteToId"
                               class="form-label">
                        </label>

                        <select asp-for="SiteToId"
                                asp-items="Model.SiteOptions"
                                class="form-select">

                            <option value="">
                                Select destination site
                            </option>

                        </select>

                        <span asp-validation-for="SiteToId"
                              class="text-danger">
                        </span>
                    </div>

                </div>


                <div class="alert alert-light border mt-3 mb-0">
                    <strong>Generated name:</strong>

                    <span id="generatedLinkName"
                          class="text-muted">
                        Select both sites
                    </span>
                </div>

            </div>
        </div>


        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">

                <h5 class="mb-3">
                    Link Technology
                </h5>

                <label asp-for="Technology"
                       class="form-label">
                </label>

                <select asp-for="Technology"
                        class="form-select"
                        id="Technology">

                    <option value="">
                        Select link technology
                    </option>

                    <option value="SDH">
                        SDH
                    </option>

                    <option value="PDH">
                        PDH
                    </option>

                </select>

                <span asp-validation-for="Technology"
                      class="text-danger">
                </span>

            </div>
        </div>


        <div id="sdhConfiguration"
             class="card border-0 shadow-sm mb-4">

            <div class="card-body p-4">

                <h5 class="mb-1">
                    SDH Configuration
                </h5>

                <p class="text-muted">
                    Each STM generates 63 E1 channels.
                </p>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="SdhCardCount"
                               class="form-label">
                        </label>

                        <select asp-for="SdhCardCount"
                                class="form-select">

                            <option value="">
                                Select number of cards
                            </option>

                            <option value="2">2 cards</option>
                            <option value="6">6 cards</option>
                            <option value="20">20 cards</option>

                        </select>

                        <span asp-validation-for="SdhCardCount"
                              class="text-danger">
                        </span>
                    </div>


                    <div class="col-md-6">
                        <label asp-for="StmCount"
                               class="form-label">
                        </label>

                        <select asp-for="StmCount"
                                class="form-select">

                            <option value="">
                                Select number of STMs
                            </option>

                            @for (int number = 1;
                                  number <= 9;
                                  number++)
                            {
                                <option value="@number">
                                    @number
                                </option>
                            }

                        </select>

                        <span asp-validation-for="StmCount"
                              class="text-danger">
                        </span>
                    </div>

                </div>


                <div class="alert alert-info mt-3 mb-0">
                    STMs are distributed across the selected cards
                    in round-robin order.
                </div>

            </div>
        </div>


        <div id="pdhConfiguration"
             class="card border-0 shadow-sm mb-4 d-none">

            <div class="card-body p-4">

                <h5 class="mb-1">
                    PDH Configuration
                </h5>

                <p class="text-muted">
                    PDH E1 channels are created directly without STMs.
                </p>

                <label asp-for="PdhE1Count"
                       class="form-label">
                </label>

                <input asp-for="PdhE1Count"
                       class="form-control"
                       type="number"
                       min="1"
                       max="1000"
                       placeholder="Enter number of E1 channels" />

                <span asp-validation-for="PdhE1Count"
                      class="text-danger">
                </span>

            </div>
        </div>


        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">
                Create Link
            </button>

            <a asp-action="Index"
                   class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const technology =
            document.getElementById("Technology");

        const sdhConfiguration =
            document.getElementById("sdhConfiguration");

        const pdhConfiguration =
            document.getElementById("pdhConfiguration");

        const sdhCardCount =
            document.getElementById("SdhCardCount");

        const stmCount =
            document.getElementById("StmCount");

        const pdhE1Count =
            document.getElementById("PdhE1Count");

        const siteFrom =
            document.getElementById("SiteFromId");

        const siteTo =
            document.getElementById("SiteToId");

        const generatedLinkName =
            document.getElementById("generatedLinkName");


        function updateTechnologyFields() {
            const isSdh =
                technology.value === "SDH";

            const isPdh =
                technology.value === "PDH";

            sdhConfiguration.classList.toggle(
                "d-none",
                !isSdh);

            pdhConfiguration.classList.toggle(
                "d-none",
                !isPdh);

            sdhCardCount.disabled = !isSdh;
            stmCount.disabled = !isSdh;
            pdhE1Count.disabled = !isPdh;
        }


        function updateGeneratedName() {
            if (!siteFrom.value ||
                !siteTo.value) {
                generatedLinkName.textContent =
                    "Select both sites";

                return;
            }

            generatedLinkName.textContent =
                siteFrom.value +
                " - " +
                siteTo.value +
                " - automatic sequence";
        }


        technology.addEventListener(
            "change",
            updateTechnologyFields);

        siteFrom.addEventListener(
            "change",
            updateGeneratedName);

        siteTo.addEventListener(
            "change",
            updateGeneratedName);


        updateTechnologyFields();
        updateGeneratedName();
    </script>
}