@model CommunicationProject.ViewModels.CommunicationLinkCreateViewModel

@{
    ViewData["Title"] = "Create Communication Link";
}

<h1>Create Communication Link</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="form-group mb-3">
                <label asp-for="Name"
                       class="control-label">
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LinkTypeId"
                       class="control-label">
                </label>

                <select asp-for="LinkTypeId"
                        asp-items="Model.LinkTypeOptions"
                        class="form-select">
                    <option value="">
                        -- Select Link Type --
                    </option>
                </select>

                <span asp-validation-for="LinkTypeId"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SiteFromId"
                       class="control-label">
                </label>

                <select asp-for="SiteFromId"
                        asp-items="Model.SiteOptions"
                        class="form-select">
                    <option value="">
                        -- Select Source Site --
                    </option>
                </select>

                <span asp-validation-for="SiteFromId"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SiteToId"
                       class="control-label">
                </label>

                <select asp-for="SiteToId"
                        asp-items="Model.SiteOptions"
                        class="form-select">
                    <option value="">
                        -- Select Destination Site --
                    </option>
                </select>

                <span asp-validation-for="SiteToId"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StmCount"
                       class="control-label">
                </label>

                <input asp-for="StmCount"
                       type="number"
                       min="1"
                       max="100"
                       class="form-control" />

                <span asp-validation-for="StmCount"
                      class="text-danger">
                </span>

                <div class="form-text">
                    The system creates 63 E1 channels for every STM.
                </div>
            </div>

            <div class="form-group">
                <button type="submit"
                        class="btn btn-primary">
                    Create Link and Channels
                </button>

                <a asp-action="Index"
                       class="btn btn-secondary">
                    Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const siteFrom = document.getElementById("SiteFromId");
            const siteTo = document.getElementById("SiteToId");

            function updateSiteOptions() {
                const selectedFrom = siteFrom.value;
                const selectedTo = siteTo.value;

                for (const option of siteTo.options) {
                    option.disabled =
                        option.value !== "" &&
                        option.value === selectedFrom;
                }

                for (const option of siteFrom.options) {
                    option.disabled =
                        option.value !== "" &&
                        option.value === selectedTo;
                }

                if (
                    selectedFrom !== "" &&
                    selectedFrom === siteTo.value
                ) {
                    siteTo.value = "";
                }
            }

            siteFrom.addEventListener(
                "change",
                updateSiteOptions
            );

            siteTo.addEventListener(
                "change",
                updateSiteOptions
            );

            updateSiteOptions();
        });
    </script>
}