@model CommunicationProject.ViewModels.CommunicationLinkCreateViewModel
@using CommunicationProject.Models
@using CommunicationProject.Security

@{
    ViewData["Title"] = "Add Communication Link";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/links.css"
          asp-append-version="true" />
}


<div class="links-form-page">

    <!-- Header -->
    <div class="links-form-top">

        <a href="#"
               class="links-back-link js-back-link"
               data-fallback-url="@Url.Action("Index", "CommunicationLinks")">
            ← Back
        </a>


        <div class="links-form-heading">

            <div class="links-form-heading-icon">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <circle cx="6"
                            cy="12"
                            r="3"></circle>

                    <circle cx="18"
                            cy="12"
                            r="3"></circle>

                    <path d="M9 12h6"></path>

                </svg>

            </div>


            <div>

                <h1 class="links-form-title">
                    Add Communication Link
                </h1>

                <p class="links-form-subtitle">
                    Create an SDH or PDH connection
                    between two communication sites.
                </p>

            </div>

        </div>

    </div>


    <div class="links-card links-form-card links-form-card-modern">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="links-validation-summary">
            </div>


            <!-- Route -->
            <section class="links-form-section">

                <div class="links-form-section-heading">

                    <span class="links-form-section-mark">
                    </span>

                    <div>

                        <h2>
                            Link Route
                        </h2>

                        <p>
                            Select the two endpoints for
                            this communication link.
                        </p>

                    </div>

                </div>


                <div class="links-route-form">

                    <div class="links-route-form-grid">

                        <!-- Source -->
                        <div>

                            <label asp-for="SiteFromId"
                                   class="links-form-label">
                                Source Site
                            </label>


                            @if (Model.LockSiteFrom)
                            {
                                <input asp-for="SiteFromId"
                                       type="hidden" />

                                <input asp-for="LockSiteFrom"
                                       type="hidden" />


                                <div class="links-readonly-field">

                                    <span>
                                        @Model.SiteFromId
                                    </span>

                                    <span class="links-readonly-badge">
                                        Fixed
                                    </span>

                                </div>


                                <div class="links-form-hint">
                                    Source site is fixed to
                                    the site you opened.
                                </div>
                            }
                            else
                            {
                                <select asp-for="SiteFromId"
                                        asp-items="Model.SiteOptions"
                                        class="links-form-select">

                                    <option value="">
                                        Select source site
                                    </option>

                                </select>
                            }


                            <span asp-validation-for="SiteFromId"
                                  class="links-validation">
                            </span>

                        </div>


                        <div class="links-route-divider">
                            →
                        </div>


                        <!-- Destination -->
                        <div>

                            <label asp-for="SiteToId"
                                   class="links-form-label">
                                Destination Site
                            </label>

                            <select asp-for="SiteToId"
                                    asp-items="Model.SiteOptions"
                                    class="links-form-select">

                                <option value="">
                                    Select destination site
                                </option>

                            </select>

                            <span asp-validation-for="SiteToId"
                                  class="links-validation">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- Generated Name -->
                <div class="links-generated-name">

                    <span class="links-generated-name-label">
                        Generated name
                    </span>

                    <span id="generatedLinkName"
                          class="links-generated-name-value">

                        Select both sites

                    </span>

                </div>

            </section>


            <!-- Technology -->
            <section class="links-form-section">

                <div class="links-form-section-heading">

                    <span class="links-form-section-mark">
                    </span>

                    <div>

                        <h2>
                            Link Technology
                        </h2>

                        <p>
                            Select the transmission technology
                            used by the link.
                        </p>

                    </div>

                </div>


                <div class="links-form-group">

                    <label asp-for="Technology"
                           class="links-form-label">
                        Technology
                    </label>

                    <select asp-for="Technology"
                            class="links-form-select"
                            id="Technology">

                        <option value="">
                            Select link technology
                        </option>

                        <option value="SDH">
                            SDH
                        </option>

                        <option value="PDH">
                            PDH
                        </option>

                    </select>

                    <span asp-validation-for="Technology"
                          class="links-validation">
                    </span>

                </div>

            </section>


            <!-- SDH -->
            <section id="sdhConfiguration"
                     class="links-form-section links-technology-section">

                <div class="links-technology-heading">

                    <div>

                        <h3>
                            SDH Configuration
                        </h3>

                        <p>
                            Each STM automatically generates
                            63 E1 channels.
                        </p>

                    </div>


                    <span class="links-technology-badge">
                        SDH
                    </span>

                </div>


                <div class="links-form-grid">

                    <div>

                        <label asp-for="SdhCardCount"
                               class="links-form-label">
                            Number of Cards
                        </label>

                        <select asp-for="SdhCardCount"
                                class="links-form-select">

                            <option value="">
                                Select number of cards
                            </option>

                            <option value="2">
                                2 cards
                            </option>

                            <option value="6">
                                6 cards
                            </option>

                            <option value="20">
                                20 cards
                            </option>

                        </select>

                        <span asp-validation-for="SdhCardCount"
                              class="links-validation">
                        </span>

                    </div>


                    <div>

                        <label asp-for="StmCount"
                               class="links-form-label">
                            Number of STMs
                        </label>

                        <select asp-for="StmCount"
                                class="links-form-select">

                            <option value="">
                                Select number of STMs
                            </option>

                            @for (int number = 1;
                                  number <= 9;
                                  number++)
                            {
                                <option value="@number">
                                    @number
                                </option>
                            }

                        </select>

                        <span asp-validation-for="StmCount"
                              class="links-validation">
                        </span>

                    </div>

                </div>


                <div class="links-inventory-note">

                    <div class="links-inventory-note-icon">
                        i
                    </div>

                    <div>

                        <div class="links-inventory-note-title">
                            Automatic distribution
                        </div>

                        <p class="links-inventory-note-text">
                            STMs are distributed across the
                            selected cards using round-robin order.
                        </p>

                    </div>

                </div>

            </section>


            <!-- PDH -->
            <section id="pdhConfiguration"
                     class="links-form-section links-technology-section d-none">

                <div class="links-technology-heading">

                    <div>

                        <h3>
                            PDH Configuration
                        </h3>

                        <p>
                            E1 channels are created directly
                            without STMs.
                        </p>

                    </div>


                    <span class="links-technology-badge">
                        PDH
                    </span>

                </div>


                <div class="links-form-group">

                    <label asp-for="PdhE1Count"
                           class="links-form-label">
                        Number of E1 Channels
                    </label>

                    <input asp-for="PdhE1Count"
                           class="links-form-control"
                           type="number"
                           min="1"
                           max="1000"
                           placeholder="Enter number of E1 channels" />

                    <span asp-validation-for="PdhE1Count"
                          class="links-validation">
                    </span>

                </div>

            </section>


            <!-- Actions -->
            <div class="links-form-actions">

                <a href="#"
                       class="links-form-cancel js-back-link"
                       data-fallback-url="@Url.Action("Index", "CommunicationLinks")">

                    Cancel

                </a>


                <button type="submit"
                        class="links-form-submit">

                    <span class="links-submit-icon">
                        +
                    </span>

                    Add Link

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>
        const technology =
            document.getElementById(
                "Technology");

        const sdhConfiguration =
            document.getElementById(
                "sdhConfiguration");

        const pdhConfiguration =
            document.getElementById(
                "pdhConfiguration");

        const sdhCardCount =
            document.getElementById(
                "SdhCardCount");

        const stmCount =
            document.getElementById(
                "StmCount");

        const pdhE1Count =
            document.getElementById(
                "PdhE1Count");

        const siteFrom =
            document.getElementById(
                "SiteFromId");

        const siteTo =
            document.getElementById(
                "SiteToId");

        const generatedLinkName =
            document.getElementById(
                "generatedLinkName");


        function updateTechnologyFields() {

            const isSdh =
                technology.value === "SDH";

            const isPdh =
                technology.value === "PDH";


            sdhConfiguration.classList.toggle(
                "d-none",
                !isSdh);

            pdhConfiguration.classList.toggle(
                "d-none",
                !isPdh);


            sdhCardCount.disabled =
                !isSdh;

            stmCount.disabled =
                !isSdh;

            pdhE1Count.disabled =
                !isPdh;
        }


        function updateGeneratedName() {

            if (!siteFrom.value ||
                !siteTo.value) {

                generatedLinkName.textContent =
                    "Select both sites";

                return;
            }


            generatedLinkName.textContent =
                siteFrom.value +
                " - " +
                siteTo.value +
                " - automatic sequence";
        }


        function updateSiteOptions() {

            const selectedFrom =
                siteFrom.value;

            const selectedTo =
                siteTo.value;


            for (const option
                 of siteTo.options) {

                option.disabled =
                    option.value !== "" &&
                    option.value === selectedFrom;
            }


            for (const option
                 of siteFrom.options) {

                option.disabled =
                    option.value !== "" &&
                    option.value === selectedTo;
            }
        }


        technology.addEventListener(
            "change",
            updateTechnologyFields);


        siteFrom.addEventListener(
            "change",
            function () {

                updateGeneratedName();
                updateSiteOptions();
            });


        siteTo.addEventListener(
            "change",
            function () {

                updateGeneratedName();
                updateSiteOptions();
            });


        updateTechnologyFields();
        updateGeneratedName();
        updateSiteOptions();
    </script>
}