@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
}


<div class="home-page">

    <section class="home-hero">

        <div class="home-hero-content">

            <div class="home-hero-label">

                <span class="home-hero-label-dot">
                </span>

                Communication Network

            </div>


            <h1 class="home-title">
                Network Management
            </h1>


            <p class="home-subtitle">

                Manage communication sites, links,
                channels, equipment and network paths
                from one centralized system.

            </p>

        </div>


        <div class="home-hero-decoration"
             aria-hidden="true">

            <div class="
                home-hero-ring
                home-hero-ring-large">
            </div>

            <div class="
                home-hero-ring
                home-hero-ring-small">
            </div>


            <div class="
                home-hero-node
                home-hero-node-one">
            </div>

            <div class="
                home-hero-node
                home-hero-node-two">
            </div>

            <div class="
                home-hero-node
                home-hero-node-three">
            </div>

        </div>

    </section>

</div>