@model CommunicationProject.ViewModels.CreateCrossConnectionViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Create Cross Connection";

    string initialValuesJson =
        JsonSerializer.Serialize(new
        {
            siteId =
                Model.SiteId,

            incomingResourceKey =
                Model.IncomingResourceKey,

            incomingE1Id =
                Model.IncomingE1Id?.ToString(),

            outgoingResourceKey =
                Model.OutgoingResourceKey,

            outgoingE1Id =
                Model.OutgoingE1Id?.ToString()
        });
}


@section Styles {

    <link rel="stylesheet"
          href="~/css/crossconnections.css"
          asp-append-version="true" />

}


<div class="cross-page">

    <!-- =====================================================
         Header
         ===================================================== -->

    <div class="cross-page-header">

        <span class="cross-eyebrow">
            NETWORK OPERATION
        </span>

        <h1>
            Create Cross Connection
        </h1>

        <p>
            Join an incoming E1 to an outgoing E1
            through one communication site.
        </p>

    </div>


    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <!-- =================================================
             Validation
             ================================================= -->

        <div asp-validation-summary="ModelOnly"
             class="cross-validation">
        </div>


        <!-- =================================================
             Cross-Connection Site
             ================================================= -->

        <section class="cross-site-card">

            <div class="cross-site-heading">

                <div class="cross-site-icon">
                    ●
                </div>


                <div>

                    <span class="cross-eyebrow">
                        CONNECTION POINT
                    </span>

                    <h2>
                        Cross-Connection Site
                    </h2>

                    <p>
                        Select the site where the incoming
                        and outgoing communication resources
                        will be joined.
                    </p>

                </div>

            </div>


            <div class="cross-field">

                <label asp-for="SiteId">
                    Cross Connection Site
                </label>


                <!-- =========================================
                     Searchable Site Select
                     ========================================= -->

                <div class="cross-searchable-select"
                     id="siteSearchableSelect">

                    <button type="button"
                            id="siteSelectTrigger"
                            class="cross-searchable-trigger"
                            aria-haspopup="listbox"
                            aria-expanded="false">

                        <span id="siteSelectText"
                              class="cross-searchable-value">

                            Select cross-connection site

                        </span>


                        <span class="cross-select-arrow">
                            ▾
                        </span>

                    </button>


                    <div id="siteSelectDropdown"
                         class="cross-searchable-dropdown"
                         hidden>


                        <!-- Search is inside the opened select -->

                        <div class="cross-search-wrapper">

                            <span class="cross-search-icon">
                                ⌕
                            </span>

                            <input type="search"
                                   id="siteSearchInput"
                                   class="cross-search-input"
                                   placeholder="Search site..."
                                   autocomplete="off" />

                        </div>


                        <div id="siteOptionList"
                             class="cross-search-options"
                             role="listbox">
                        </div>


                        <div id="siteNoResults"
                             class="cross-search-no-results"
                             hidden>

                            No sites found.

                        </div>

                    </div>


                    <!--
                        Real ASP.NET select.

                        This remains the field submitted to
                        the controller. The custom dropdown
                        only changes its value.
                    -->

                    <select asp-for="SiteId"
                            asp-items="Model.SiteOptions"
                            id="siteSelect"
                            class="cross-native-select"
                            tabindex="-1"
                            aria-hidden="true">

                        <option value="">
                            Select cross-connection site
                        </option>

                    </select>

                </div>


                <span asp-validation-for="SiteId"
                      class="cross-field-error">
                </span>

            </div>

        </section>


        <!-- =================================================
             Incoming / Outgoing
             ================================================= -->

        <div class="cross-direction-grid">


            <!-- =============================================
                 Incoming Side
                 ============================================= -->

            <section class="cross-side-card">

                <div class="cross-side-header">

                    <div class="cross-direction-symbol">
                        →
                    </div>


                    <div>

                        <span class="cross-eyebrow">
                            INCOMING
                        </span>

                        <h2>
                            Incoming Side
                        </h2>

                        <p>
                            Select the communication resource
                            arriving from the previous site.
                        </p>

                    </div>

                </div>


                <!-- Previous Site -->

                <div class="cross-field">

                    <label for="incomingResourceSelect">
                        Previous Site
                    </label>

                    <select asp-for="IncomingResourceKey"
                            id="incomingResourceSelect"
                            class="cross-select"
                            disabled>

                        <option value="">
                            Select incoming STM or PDH link
                        </option>

                    </select>

                    <span asp-validation-for="IncomingResourceKey"
                          class="cross-field-error">
                    </span>

                </div>


                <!-- Incoming E1 -->

                <div class="cross-field">

                    <label asp-for="IncomingE1Id">
                        Incoming E1
                    </label>

                    <select asp-for="IncomingE1Id"
                            id="incomingE1Select"
                            class="cross-select"
                            disabled>

                        <option value="">
                            Select incoming E1
                        </option>

                    </select>

                    <span asp-validation-for="IncomingE1Id"
                          class="cross-field-error">
                    </span>

                </div>

            </section>



            <!-- =============================================
                 Cross Connection
                 ============================================= -->

            <div class="cross-center-connector">

                <span>
                    ×
                </span>

                <small>
                    CROSS
                    <br />
                    CONNECTION
                </small>

            </div>



            <!-- =============================================
                 Outgoing Side
                 ============================================= -->

            <section class="cross-side-card">

                <div class="cross-side-header">

                    <div class="cross-direction-symbol
                        cross-direction-out">
                        →
                    </div>


                    <div>

                        <span class="cross-eyebrow">
                            OUTGOING
                        </span>

                        <h2>
                            Outgoing Side
                        </h2>

                        <p>
                            Select the communication resource
                            leaving toward the next site.
                        </p>

                    </div>

                </div>


                <!-- Next Site -->

                <div class="cross-field">

                    <label for="outgoingResourceSelect">
                        Next Site
                    </label>

                    <select asp-for="OutgoingResourceKey"
                            id="outgoingResourceSelect"
                            class="cross-select"
                            disabled>

                        <option value="">
                            Select outgoing STM or PDH link
                        </option>

                    </select>

                    <span asp-validation-for="OutgoingResourceKey"
                          class="cross-field-error">
                    </span>

                </div>


                <!-- Outgoing E1 -->

                <div class="cross-field">

                    <label asp-for="OutgoingE1Id">
                        Outgoing E1
                    </label>

                    <select asp-for="OutgoingE1Id"
                            id="outgoingE1Select"
                            class="cross-select"
                            disabled>

                        <option value="">
                            Select outgoing E1
                        </option>

                    </select>

                    <span asp-validation-for="OutgoingE1Id"
                          class="cross-field-error">
                    </span>

                </div>

            </section>

        </div>


        <!-- =================================================
             Customer
             ================================================= -->

        <section class="cross-customer-card">

            <div>

                <span class="cross-eyebrow">
                    SERVICE
                </span>

                <h2>
                    Customer
                </h2>

            </div>


            <div class="cross-field
                cross-customer-field">

                <label asp-for="CustomerName">
                    Customer Name
                </label>

                <input asp-for="CustomerName"
                       class="cross-input"
                       placeholder="Enter customer name" />

                <span asp-validation-for="CustomerName"
                      class="cross-field-error">
                </span>

            </div>

        </section>


        <!-- =================================================
             Actions
             ================================================= -->

        <div class="cross-actions">

            <a href="@Url.Action(
                                                   "Index",
                                                   "Sites")"
                   data-fallback-url="@Url.Action(
                                                   "Index",
                                                   "Sites")"
                   class="cross-cancel-btn js-back-link">

                Cancel

            </a>


            <button type="submit"
                    class="cross-primary-btn">

                Create Cross Connection

            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        (() => {

            /* =================================================
               Initial Values
               ================================================= */

            const initialValues =
                @Html.Raw(initialValuesJson);


            /* =================================================
               API URLs
               ================================================= */

            const urls = {

                resources:
                    '@Url.Action(
                                                    "GetConnectionResources",
                                                    "CrossConnections")',

                e1s:
                    '@Url.Action(
                                                    "GetAvailableE1s",
                                                    "CrossConnections")'

            };


            /* =================================================
               Elements
               ================================================= */

            const siteSearchableSelect =
                document.getElementById(
                    "siteSearchableSelect");


            const siteSelectTrigger =
                document.getElementById(
                    "siteSelectTrigger");


            const siteSelectText =
                document.getElementById(
                    "siteSelectText");


            const siteSelectDropdown =
                document.getElementById(
                    "siteSelectDropdown");


            const siteSearchInput =
                document.getElementById(
                    "siteSearchInput");


            const siteOptionList =
                document.getElementById(
                    "siteOptionList");


            const siteNoResults =
                document.getElementById(
                    "siteNoResults");


            const siteSelect =
                document.getElementById(
                    "siteSelect");


            const incomingResourceSelect =
                document.getElementById(
                    "incomingResourceSelect");


            const outgoingResourceSelect =
                document.getElementById(
                    "outgoingResourceSelect");


            const incomingE1Select =
                document.getElementById(
                    "incomingE1Select");


            const outgoingE1Select =
                document.getElementById(
                    "outgoingE1Select");


            const customerNameInput =
                document.getElementById(
                    "CustomerName");


            let customerWasAutoFilled =
                false;


            /* =================================================
               Searchable Site Select
               ================================================= */

            const siteOptions =
                Array.from(
                    siteSelect.options)
                    .filter(option =>
                        option.value !== "")
                    .map(option => ({

                        value:
                            option.value,

                        text:
                            option.textContent
                                .trim()

                    }));


            function getSelectedSiteText() {

                if (!siteSelect.value) {

                    return "Select cross-connection site";

                }


                const option =
                    Array.from(
                        siteSelect.options)
                        .find(item =>
                            item.value ===
                            siteSelect.value);


                return option
                    ?.textContent
                    ?.trim() ??
                    "Select cross-connection site";

            }


            function updateSiteTrigger() {

                const hasValue =
                    siteSelect.value !== "";


                siteSelectText.textContent =
                    getSelectedSiteText();


                siteSelectTrigger.classList.toggle(
                    "has-value",
                    hasValue);

            }


            function renderSiteOptions(
                searchText = "") {

                const query =
                    searchText
                        .trim()
                        .toLowerCase();


                siteOptionList.innerHTML =
                    "";


                const matchingSites =
                    siteOptions.filter(site => {

                        if (!query) {
                            return true;
                        }


                        const searchable =
                            (
                                site.value +
                                " " +
                                site.text
                            ).toLowerCase();


                        return searchable.includes(
                            query);

                    });


                siteNoResults.hidden =
                    matchingSites.length > 0;


                matchingSites.forEach(site => {

                    const button =
                        document.createElement(
                            "button");


                    button.type =
                        "button";


                    button.className =
                        "cross-search-option";


                    button.dataset.value =
                        site.value;


                    button.setAttribute(
                        "role",
                        "option");


                    const selected =
                        site.value ===
                        siteSelect.value;


                    button.setAttribute(
                        "aria-selected",
                        selected
                            ? "true"
                            : "false");


                    if (selected) {

                        button.classList.add(
                            "is-selected");

                    }


                    const main =
                        document.createElement(
                            "span");


                    main.className =
                        "cross-search-option-main";


                    main.textContent =
                        site.text;


                    button.appendChild(
                        main);


                    /*
                     * If the option text does not
                     * already show the site ID,
                     * display it separately.
                     */
                    if (
                        site.value &&
                        !site.text
                            .toLowerCase()
                            .includes(
                                site.value
                                    .toLowerCase())
                    ) {

                        const id =
                            document.createElement(
                                "small");


                        id.textContent =
                            site.value;


                        button.appendChild(
                            id);

                    }


                    button.addEventListener(
                        "click",
                        () => {

                            selectSite(
                                site.value);

                        });


                    siteOptionList.appendChild(
                        button);

                });

            }


            function openSiteDropdown() {

                siteSelectDropdown.hidden =
                    false;


                siteSelectTrigger.setAttribute(
                    "aria-expanded",
                    "true");


                siteSearchInput.value =
                    "";


                renderSiteOptions();


                requestAnimationFrame(
                    () => {

                        siteSearchInput.focus();

                    });

            }


            function closeSiteDropdown() {

                siteSelectDropdown.hidden =
                    true;


                siteSelectTrigger.setAttribute(
                    "aria-expanded",
                    "false");

            }


            function selectSite(
                value) {

                const changed =
                    siteSelect.value !==
                    value;


                siteSelect.value =
                    value;


                updateSiteTrigger();


                closeSiteDropdown();


                if (changed) {

                    siteSelect.dispatchEvent(
                        new Event(
                            "change",
                            {
                                bubbles: true
                            }));

                }

            }


            siteSelectTrigger.addEventListener(
                "click",
                () => {

                    if (
                        siteSelectDropdown.hidden
                    ) {

                        openSiteDropdown();

                    }
                    else {

                        closeSiteDropdown();

                    }

                });


            siteSearchInput.addEventListener(
                "input",
                () => {

                    renderSiteOptions(
                        siteSearchInput.value);

                });


            siteSearchInput.addEventListener(
                "keydown",
                event => {

                    if (
                        event.key ===
                        "Escape"
                    ) {

                        event.preventDefault();

                        closeSiteDropdown();

                        siteSelectTrigger.focus();

                        return;

                    }


                    /*
                     * Enter selects the first
                     * visible search result.
                     */
                    if (
                        event.key ===
                        "Enter"
                    ) {

                        const firstOption =
                            siteOptionList
                                .querySelector(
                                    ".cross-search-option");


                        if (!firstOption) {
                            return;
                        }


                        event.preventDefault();


                        selectSite(
                            firstOption
                                .dataset
                                .value);

                    }

                });


            document.addEventListener(
                "click",
                event => {

                    if (
                        !siteSearchableSelect
                            .contains(
                                event.target)
                    ) {

                        closeSiteDropdown();

                    }

                });


            /* =================================================
               Request Helper
               ================================================= */

            async function getJson(
                url,
                parameters) {

                const query =
                    new URLSearchParams();


                for (
                    const [key, value]
                    of Object.entries(
                        parameters)
                ) {

                    if (
                        value !== null &&
                        value !== undefined &&
                        value !== ""
                    ) {

                        query.append(
                            key,
                            value);

                    }

                }


                const response =
                    await fetch(
                        url +
                        "?" +
                        query.toString());


                if (!response.ok) {

                    throw new Error(
                        "Unable to load options.");

                }


                return await response.json();

            }


            /* =================================================
               Generic Select Reset
               ================================================= */

            function resetSelect(
                select,
                placeholder) {

                select.innerHTML =
                    "";


                const option =
                    document.createElement(
                        "option");


                option.value =
                    "";


                option.textContent =
                    placeholder;


                select.appendChild(
                    option);


                select.value =
                    "";


                select.disabled =
                    true;

            }


            /* =================================================
               Populate Resource Select
               ================================================= */

            function populateResourceSelect(
                select,
                resources,
                placeholder,
                selectedValue = "") {

                resetSelect(
                    select,
                    placeholder);


                resources.forEach(
                    resource => {

                        const option =
                            document.createElement(
                                "option");


                        option.value =
                            resource.value;


                        option.textContent =
                            resource.text;


                        option.dataset.resourceType =
                            resource.resourceType ??
                            "";


                        option.dataset.linkId =
                            resource.linkId ??
                            "";


                        option.dataset.stmId =
                            resource.stmId ??
                            "";


                        option.dataset.connectedSiteId =
                            resource.connectedSiteId ??
                            "";


                        select.appendChild(
                            option);

                    });


                select.disabled =
                    resources.length === 0;


                if (
                    selectedValue &&
                    Array.from(
                        select.options)
                        .some(option =>
                            option.value ===
                            selectedValue)
                ) {

                    select.value =
                        selectedValue;

                }

            }


            /* =================================================
               Populate E1 Select
               ================================================= */

            function populateE1Select(
                select,
                e1s,
                placeholder,
                selectedValue = "") {

                resetSelect(
                    select,
                    placeholder);


                e1s.forEach(
                    e1 => {

                        const option =
                            document.createElement(
                                "option");


                        option.value =
                            e1.value;


                        option.textContent =
                            e1.text;


                        if (e1.state) {

                            option.dataset.state =
                                e1.state;

                        }


                        if (e1.customerName) {

                            option.dataset.customerName =
                                e1.customerName;

                        }


                        select.appendChild(
                            option);

                    });


                select.disabled =
                    e1s.length === 0;


                if (
                    selectedValue &&
                    Array.from(
                        select.options)
                        .some(option =>
                            option.value ===
                            selectedValue)
                ) {

                    select.value =
                        selectedValue;

                }

            }


            /* =================================================
               Customer
               ================================================= */

            function updateCustomerFromIncomingE1() {

                const selectedOption =
                    incomingE1Select.options[
                        incomingE1Select
                            .selectedIndex];


                const isExistingPath =
                    selectedOption
                        ?.dataset
                        ?.state ===
                    "ExtendExistingPath";


                const customerName =
                    selectedOption
                        ?.dataset
                        ?.customerName ??
                    "";


                if (
                    isExistingPath &&
                    customerName
                ) {

                    customerNameInput.value =
                        customerName;


                    customerNameInput.readOnly =
                        true;


                    customerWasAutoFilled =
                        true;


                    return;

                }


                if (customerWasAutoFilled) {

                    customerNameInput.value =
                        "";

                }


                customerNameInput.readOnly =
                    false;


                customerWasAutoFilled =
                    false;

            }


            /* =================================================
               Reset Both Sides
               ================================================= */

            function resetConnectionSides() {

                resetSelect(
                    incomingResourceSelect,
                    "Select incoming STM or PDH link");


                resetSelect(
                    outgoingResourceSelect,
                    "Select outgoing STM or PDH link");


                resetSelect(
                    incomingE1Select,
                    "Select incoming E1");


                resetSelect(
                    outgoingE1Select,
                    "Select outgoing E1");


                updateCustomerFromIncomingE1();

            }


            /* =================================================
               Connected-Site Helper
               ================================================= */

            function getConnectedSiteId(
                select) {

                if (!select.value) {
                    return "";
                }


                const option =
                    select.options[
                        select.selectedIndex];


                return option
                    ?.dataset
                    ?.connectedSiteId ??
                    "";

            }


            /* =================================================
               Previous / Next Site Availability
               ================================================= */

            function updateResourceAvailability(
                changedSide = "") {

                const previousSiteId =
                    getConnectedSiteId(
                        incomingResourceSelect);


                const nextSiteId =
                    getConnectedSiteId(
                        outgoingResourceSelect);


                /*
                 * Previous Site and Next Site
                 * cannot be the same.
                 */

                if (
                    changedSide ===
                        "incoming" &&
                    previousSiteId &&
                    nextSiteId &&
                    previousSiteId ===
                        nextSiteId
                ) {

                    outgoingResourceSelect.value =
                        "";


                    resetSelect(
                        outgoingE1Select,
                        "Select outgoing E1");

                }


                if (
                    changedSide ===
                        "outgoing" &&
                    previousSiteId &&
                    nextSiteId &&
                    previousSiteId ===
                        nextSiteId
                ) {

                    incomingResourceSelect.value =
                        "";


                    resetSelect(
                        incomingE1Select,
                        "Select incoming E1");


                    updateCustomerFromIncomingE1();

                }


                const selectedPreviousSite =
                    getConnectedSiteId(
                        incomingResourceSelect);


                const selectedNextSite =
                    getConnectedSiteId(
                        outgoingResourceSelect);


                /*
                 * Disable incoming resources that
                 * point to the selected Next Site.
                 */

                Array.from(
                    incomingResourceSelect.options)
                    .forEach(option => {

                        if (!option.value) {
                            return;
                        }


                        const sameSite =
                            selectedNextSite &&
                            option.dataset
                                .connectedSiteId ===
                            selectedNextSite;


                        option.disabled =
                            !!sameSite;

                    });


                /*
                 * Disable outgoing resources that
                 * point to the selected Previous Site.
                 */

                Array.from(
                    outgoingResourceSelect.options)
                    .forEach(option => {

                        if (!option.value) {
                            return;
                        }


                        const sameSite =
                            selectedPreviousSite &&
                            option.dataset
                                .connectedSiteId ===
                            selectedPreviousSite;


                        option.disabled =
                            !!sameSite;

                    });

            }


            /* =================================================
               Load Resources At Selected Site
               ================================================= */

            async function loadResources(
                incomingValue = "",
                outgoingValue = "",
                incomingE1Value = "",
                outgoingE1Value = "") {

                resetConnectionSides();


                if (!siteSelect.value) {
                    return;
                }


                try {

                    const resources =
                        await getJson(
                            urls.resources,
                            {
                                siteId:
                                    siteSelect.value
                            });


                    populateResourceSelect(
                        incomingResourceSelect,
                        resources,
                        "Select incoming STM or PDH link",
                        incomingValue);


                    populateResourceSelect(
                        outgoingResourceSelect,
                        resources,
                        "Select outgoing STM or PDH link",
                        outgoingValue);


                    updateResourceAvailability();


                    if (
                        incomingResourceSelect.value
                    ) {

                        await loadE1s(
                            "incoming",
                            incomingE1Value);

                    }


                    if (
                        outgoingResourceSelect.value
                    ) {

                        await loadE1s(
                            "outgoing",
                            outgoingE1Value);

                    }

                }
                catch (error) {

                    console.error(
                        error);


                    resetConnectionSides();

                }

            }


            /* =================================================
               Load E1s
               ================================================= */

            async function loadE1s(
                side,
                selectedE1Id = "") {

                const isIncoming =
                    side ===
                    "incoming";


                const resourceSelect =
                    isIncoming
                        ? incomingResourceSelect
                        : outgoingResourceSelect;


                const e1Select =
                    isIncoming
                        ? incomingE1Select
                        : outgoingE1Select;


                resetSelect(
                    e1Select,
                    isIncoming
                        ? "Select incoming E1"
                        : "Select outgoing E1");


                if (!resourceSelect.value) {

                    if (isIncoming) {

                        updateCustomerFromIncomingE1();

                    }


                    return;

                }


                const selectedResource =
                    resourceSelect.options[
                        resourceSelect
                            .selectedIndex];


                const linkId =
                    selectedResource
                        ?.dataset
                        ?.linkId ??
                    "";


                const stmId =
                    selectedResource
                        ?.dataset
                        ?.stmId ??
                    "";


                if (!linkId) {
                    return;
                }


                try {

                    const e1s =
                        await getJson(
                            urls.e1s,
                            {
                                linkId:
                                    linkId,

                                stmId:
                                    stmId || null,

                                isIncoming:
                                    isIncoming
                            });


                    populateE1Select(
                        e1Select,
                        e1s,
                        isIncoming
                            ? "Select incoming E1"
                            : "Select outgoing E1",
                        selectedE1Id);


                    if (isIncoming) {

                        updateCustomerFromIncomingE1();

                    }

                }
                catch (error) {

                    console.error(
                        error);


                    resetSelect(
                        e1Select,
                        isIncoming
                            ? "Select incoming E1"
                            : "Select outgoing E1");

                }

            }


            /* =================================================
               Events
               ================================================= */

            siteSelect.addEventListener(
                "change",
                async () => {

                    updateSiteTrigger();


                    await loadResources();

                });


            incomingResourceSelect
                .addEventListener(
                    "change",
                    async () => {

                        updateResourceAvailability(
                            "incoming");


                        await loadE1s(
                            "incoming");

                    });


            outgoingResourceSelect
                .addEventListener(
                    "change",
                    async () => {

                        updateResourceAvailability(
                            "outgoing");


                        await loadE1s(
                            "outgoing");

                    });


            incomingE1Select
                .addEventListener(
                    "change",
                    updateCustomerFromIncomingE1);


            /* =================================================
               Restore Values After Validation
               ================================================= */

            async function restoreSelections() {

                /*
                 * Always synchronize custom control
                 * with the real <select>.
                 */

                updateSiteTrigger();


                if (!initialValues.siteId) {
                    return;
                }


                siteSelect.value =
                    initialValues.siteId;


                updateSiteTrigger();


                await loadResources(
                    initialValues
                        .incomingResourceKey,

                    initialValues
                        .outgoingResourceKey,

                    initialValues
                        .incomingE1Id,

                    initialValues
                        .outgoingE1Id);

            }


            restoreSelections();

        })();

    </script>

}