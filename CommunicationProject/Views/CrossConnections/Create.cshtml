@model CommunicationProject.ViewModels.CreateCrossConnectionViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Create Cross Connection";

    string initialValuesJson = JsonSerializer.Serialize(new
    {
        siteId = Model.SiteId,
        previousSiteId = Model.PreviousSiteId,
        incomingStmId = Model.IncomingStmId?.ToString(),
        incomingE1Id = Model.IncomingE1Id?.ToString(),
        nextSiteId = Model.NextSiteId,
        outgoingStmId = Model.OutgoingStmId?.ToString(),
        outgoingE1Id = Model.OutgoingE1Id?.ToString(),
        description = Model.Description
    });
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/crossconnections.css"
          asp-append-version="true" />
}


<div class="cross-page">

    <!-- Header -->
    <div class="cross-header">

        <h1 class="cross-title">
            Create cross connection
        </h1>

        <p class="cross-subtitle">
            Connect an incoming E1 to an outgoing E1 at a central
            site to create or extend a communication path.
        </p>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="cross-message cross-message-success">
            @TempData["SuccessMessage"]
        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="cross-message cross-message-error">
            @TempData["ErrorMessage"]
        </div>
    }


    <div id="ajaxError"
         class="cross-message cross-message-error d-none">
    </div>


    <form asp-action="Create"
          method="post"
          id="crossConnectionForm">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="cross-validation-summary">
        </div>


        <!-- =================================================
             STEP 1 - CENTRAL SITE
             ================================================= -->

        <div class="cross-card cross-central-card">

            <div class="cross-section-heading">

                <span class="cross-step">
                    1
                </span>

                <div>

                    <h2 class="cross-section-title">
                        Cross-connection site
                    </h2>

                    <div class="cross-section-caption">
                        Select where the incoming and outgoing
                        channels will be joined.
                    </div>

                </div>

            </div>


            <div class="cross-field">

                <label asp-for="SiteId"
                       class="cross-label">
                    Cross-connection site
                </label>

                <select asp-for="SiteId"
                        asp-items="Model.SiteOptions"
                        id="siteSelect"
                        class="cross-control">

                    <option value="">
                        Select central site
                    </option>

                </select>


                <span asp-validation-for="SiteId"
                      class="cross-validation">
                </span>

            </div>

        </div>


        <!-- =================================================
             STEP 2 + 3
             ================================================= -->

        <div id="connectionSides"
             class="cross-sides d-none">


            <!-- Incoming -->
            <div class="cross-card
                cross-side-card
                cross-incoming-card">

                <div class="cross-side-header">

                    <div class="cross-side-label">
                        Step 2 · Incoming
                    </div>

                    <h2 class="cross-side-title">
                        Previous site
                    </h2>

                </div>


                <div class="cross-side-body">


                    <div class="cross-field">

                        <label asp-for="PreviousSiteId"
                               class="cross-label">
                            Previous site
                        </label>

                        <select asp-for="PreviousSiteId"
                                id="previousSiteSelect"
                                class="cross-control"
                                disabled>

                            <option value="">
                                Select previous site
                            </option>

                        </select>

                        <span asp-validation-for="PreviousSiteId"
                              class="cross-validation">
                        </span>

                    </div>


                    <div class="cross-field">

                        <label asp-for="IncomingStmId"
                               class="cross-label">
                            Incoming STM
                        </label>

                        <select asp-for="IncomingStmId"
                                id="incomingStmSelect"
                                class="cross-control"
                                disabled>

                            <option value="">
                                Select incoming STM
                            </option>

                        </select>

                        <span asp-validation-for="IncomingStmId"
                              class="cross-validation">
                        </span>

                    </div>


                    <div class="cross-field">

                        <label asp-for="IncomingE1Id"
                               class="cross-label">
                            Incoming E1
                        </label>

                        <select asp-for="IncomingE1Id"
                                id="incomingE1Select"
                                class="cross-control"
                                disabled>

                            <option value="">
                                Select incoming E1
                            </option>

                        </select>

                        <span asp-validation-for="IncomingE1Id"
                              class="cross-validation">
                        </span>


                        <div class="cross-hint">
                            The E1 entering the central site
                            from the previous site.
                        </div>

                    </div>


                    <!-- Description -->
                    <div class="cross-description-box">

                        <div class="cross-field">

                            <label asp-for="Description"
                                   class="cross-label">
                                Connection description
                            </label>

                            <input asp-for="Description"
                                   id="descriptionInput"
                                   class="cross-control"
                                   placeholder="Enter path description" />

                            <span asp-validation-for="Description"
                                  class="cross-validation">
                            </span>


                            <div class="cross-hint">
                                For a new path, enter its description.
                                When extending an existing path, its
                                existing description is reused automatically.
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Outgoing -->
            <div class="cross-card
                cross-side-card
                cross-outgoing-card">

                <div class="cross-side-header">

                    <div class="cross-side-label">
                        Step 3 · Outgoing
                    </div>

                    <h2 class="cross-side-title">
                        Next site
                    </h2>

                </div>


                <div class="cross-side-body">


                    <div class="cross-field">

                        <label asp-for="NextSiteId"
                               class="cross-label">
                            Next site
                        </label>

                        <select asp-for="NextSiteId"
                                id="nextSiteSelect"
                                class="cross-control"
                                disabled>

                            <option value="">
                                Select next site
                            </option>

                        </select>

                        <span asp-validation-for="NextSiteId"
                              class="cross-validation">
                        </span>

                    </div>


                    <div class="cross-field">

                        <label asp-for="OutgoingStmId"
                               class="cross-label">
                            Outgoing STM
                        </label>

                        <select asp-for="OutgoingStmId"
                                id="outgoingStmSelect"
                                class="cross-control"
                                disabled>

                            <option value="">
                                Select outgoing STM
                            </option>

                        </select>

                        <span asp-validation-for="OutgoingStmId"
                              class="cross-validation">
                        </span>

                    </div>


                    <div class="cross-field">

                        <label asp-for="OutgoingE1Id"
                               class="cross-label">
                            Outgoing E1
                        </label>

                        <select asp-for="OutgoingE1Id"
                                id="outgoingE1Select"
                                class="cross-control"
                                disabled>

                            <option value="">
                                Select outgoing E1
                            </option>

                        </select>

                        <span asp-validation-for="OutgoingE1Id"
                              class="cross-validation">
                        </span>


                        <div class="cross-hint">
                            The E1 leaving the central site
                            toward the next site.
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             PATH PREVIEW
             ================================================= -->

        <div id="connectionDiagram"
             class="cross-diagram d-none">

            <div class="cross-diagram-label">
                Connection preview
            </div>


            <div class="cross-diagram-flow">

                <span class="cross-diagram-node">
                    Previous site
                </span>

                <span class="cross-diagram-arrow">
                    →
                </span>

                <span class="cross-diagram-node">
                    Incoming E1
                </span>

                <span class="cross-diagram-arrow">
                    →
                </span>

                <span class="
                    cross-diagram-node
                    cross-diagram-center">
                    Cross connection
                </span>

                <span class="cross-diagram-arrow">
                    →
                </span>

                <span class="cross-diagram-node">
                    Outgoing E1
                </span>

                <span class="cross-diagram-arrow">
                    →
                </span>

                <span class="cross-diagram-node">
                    Next site
                </span>

            </div>

        </div>


        <div class="cross-note">

            <div class="cross-note-icon">
                i
            </div>

            <div>

                <div class="cross-note-title">
                    Available channels only
                </div>

                <p class="cross-note-text">
                    The E1 lists are loaded dynamically and only
                    show channels that can validly participate in
                    the selected cross connection.
                </p>

            </div>

        </div>


        <!-- Actions -->
        <div class="cross-actions">

            <a asp-controller="Home"
                   asp-action="Index"
                   class="cross-cancel-btn">
                Cancel
            </a>

            <button type="submit"
                    id="saveButton"
                    class="cross-submit-btn"
                    disabled>
                Create cross connection
            </button>

        </div>

    </form>

</div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const initialValues =
                @Html.Raw(initialValuesJson);

            const urls = {
                connectedSites:
                    '@Url.Action("GetConnectedSites", "CrossConnections")',

                stms:
                    '@Url.Action("GetStms", "CrossConnections")',

                e1s:
                    '@Url.Action("GetAvailableE1s", "CrossConnections")'
            };

            const siteSelect =
                document.getElementById("siteSelect");

            const connectionSides =
                document.getElementById("connectionSides");

            const connectionDiagram =
                document.getElementById("connectionDiagram");

            const previousSiteSelect =
                document.getElementById("previousSiteSelect");

            const incomingStmSelect =
                document.getElementById("incomingStmSelect");

            const incomingE1Select =
                document.getElementById("incomingE1Select");

            const nextSiteSelect =
                document.getElementById("nextSiteSelect");

            const outgoingStmSelect =
                document.getElementById("outgoingStmSelect");

            const outgoingE1Select =
                document.getElementById("outgoingE1Select");

                    const descriptionInput =
        document.getElementById("descriptionInput");

            const saveButton =
                document.getElementById("saveButton");

            const ajaxError =
                document.getElementById("ajaxError");

            function showError(message) {
                ajaxError.textContent = message;
                ajaxError.classList.remove("d-none");
            }

            function clearError() {
                ajaxError.textContent = "";
                ajaxError.classList.add("d-none");
            }

            function resetSelect(
                selectElement,
                placeholder) {

                selectElement.innerHTML = "";

                const option =
                    document.createElement("option");

                option.value = "";
                option.textContent = placeholder;

                selectElement.appendChild(option);
                selectElement.disabled = true;
            }

            function showLoading(
                selectElement,
                message) {

                resetSelect(selectElement, message);
            }

            function populateSelect(
                selectElement,
                items,
                placeholder,
                selectedValue = null) {

                resetSelect(
                    selectElement,
                    placeholder);

                for (const item of items) {
                    const option =
                        document.createElement("option");

        option.value = item.value;
        option.textContent = item.text;

        option.dataset.state =
            item.state ?? "";

        option.dataset.description =
            item.description ?? "";

        option.dataset.pathId =
            item.pathId ?? "";

        selectElement.appendChild(option);
                }

                selectElement.disabled =
                    items.length === 0;

                if (selectedValue) {
                    const exists =
                        Array.from(selectElement.options)
                            .some(option =>
                                option.value === selectedValue);

                    if (exists) {
                        selectElement.value =
                            selectedValue;
                    }
                }
            }

            async function getJson(
                url,
                parameters) {

                const query =
                    new URLSearchParams(parameters);

                const response = await fetch(
                    `${url}?${query.toString()}`,
                    {
                        headers: {
                            "X-Requested-With":
                                "XMLHttpRequest"
                        }
                    });

                if (!response.ok) {
                    throw new Error(
                        "The requested data could not be loaded.");
                }

                return await response.json();
            }

        function resetIncomingSide() {
            resetSelect(
                previousSiteSelect,
                "-- Select previous site --");
                        descriptionInput.value = "";
        descriptionInput.readOnly = false;

            resetSelect(
                incomingStmSelect,
                "-- Select incoming STM --");

            resetSelect(
                incomingE1Select,
                "-- Select incoming E1 --");

            descriptionInput.value = "";
            descriptionInput.readOnly = false;
        }

            function resetOutgoingSide() {
                resetSelect(
                    nextSiteSelect,
                    "-- Select next site --");

                resetSelect(
                    outgoingStmSelect,
                    "-- Select outgoing STM --");

                resetSelect(
                    outgoingE1Select,
                    "-- Select outgoing E1 --");
            }

            function updateSiteRestrictions() {
                const previousValue =
                    previousSiteSelect.value;

                const nextValue =
                    nextSiteSelect.value;

                for (const option of
                     previousSiteSelect.options) {

                    option.disabled =
                        option.value !== "" &&
                        option.value === nextValue;
                }

                for (const option of
                     nextSiteSelect.options) {

                    option.disabled =
                        option.value !== "" &&
                        option.value === previousValue;
                }
            }
                    function updateDescription() {
            const selectedOption =
                incomingE1Select.options[
                    incomingE1Select.selectedIndex
                ];

            if (!selectedOption ||
                !selectedOption.value) {

                descriptionInput.value = "";
                descriptionInput.readOnly = false;

                updateSaveButton();
                return;
            }

            const state =
                selectedOption.dataset.state ?? "";

            const existingDescription =
                selectedOption.dataset.description ?? "";

            if (state === "ExtendExistingPath") {
                /*
                 * Existing path:
                 * display and reuse its description.
                 */
                descriptionInput.value =
                    existingDescription;

                descriptionInput.readOnly = true;
            }
            else {
                /*
                 * Available E1:
                 * the user is creating a new path.
                 */
                descriptionInput.value = "";
                descriptionInput.readOnly = false;
            }

            updateSaveButton();
        }
        function updateSaveButton() {
            const isComplete =
                siteSelect.value !== "" &&
                previousSiteSelect.value !== "" &&
                incomingStmSelect.value !== "" &&
                incomingE1Select.value !== "" &&
                nextSiteSelect.value !== "" &&
                outgoingStmSelect.value !== "" &&
                outgoingE1Select.value !== "" &&
                descriptionInput.value.trim() !== "";

            saveButton.disabled = !isComplete;

            connectionDiagram.classList.toggle(
                "d-none",
                !isComplete);
        }

            async function loadConnectedSites(
                selectedPreviousSiteId = null,
                selectedNextSiteId = null) {

                clearError();
                resetIncomingSide();
                resetOutgoingSide();
                updateSaveButton();

                const siteId =
                    siteSelect.value;

                if (!siteId) {
                    connectionSides.classList.add(
                        "d-none");

                    return;
                }

                connectionSides.classList.remove(
                    "d-none");

                showLoading(
                    previousSiteSelect,
                    "Loading connected sites...");

                showLoading(
                    nextSiteSelect,
                    "Loading connected sites...");

                try {
                    const items = await getJson(
                        urls.connectedSites,
                        {
                            siteId: siteId
                        });

                    populateSelect(
                        previousSiteSelect,
                        items,
                        "-- Select previous site --",
                        selectedPreviousSiteId);

                    populateSelect(
                        nextSiteSelect,
                        items,
                        "-- Select next site --",
                        selectedNextSiteId);

                    updateSiteRestrictions();
                }
                catch (error) {
                    resetIncomingSide();
                    resetOutgoingSide();

                    showError(error.message);
                }
            }

        async function loadStms(
            connectedSiteId,
            stmSelect,
            e1Select,
            isIncoming = false,
            selectedStmId = null,
            selectedE1Id = null) {

                resetSelect(
                    stmSelect,
                    "-- Select STM --");

                resetSelect(
                    e1Select,
                    "-- Select E1 --");

                updateSaveButton();

                if (!siteSelect.value ||
                    !connectedSiteId) {
                    return;
                }

                showLoading(
                    stmSelect,
                    "Loading STMs...");

                try {
                    const items = await getJson(
                        urls.stms,
                        {
                            siteId: siteSelect.value,
                            connectedSiteId:
                                connectedSiteId
                        });

                    populateSelect(
                        stmSelect,
                        items,
                        "-- Select STM --",
                        selectedStmId);

                    if (selectedStmId &&
                        stmSelect.value) {

        await loadE1s(
            stmSelect.value,
            e1Select,
            isIncoming,
            selectedE1Id);
                    }
                }
                catch (error) {
                    resetSelect(
                        stmSelect,
                        "-- Select STM --");

                    showError(error.message);
                }
            }

        async function loadE1s(
            stmId,
            e1Select,
            isIncoming = false,
            selectedE1Id = null) {

            resetSelect(
                e1Select,
                "-- Select E1 --");

            updateSaveButton();

            if (!stmId) {
                return;
            }

            showLoading(
                e1Select,
                "Loading E1 channels...");

            try {
        const items = await getJson(
            urls.e1s,
            {
                stmId: stmId,
                isIncoming: isIncoming
            });

                populateSelect(
                    e1Select,
                    items,
                    "-- Select E1 --",
                    selectedE1Id);

        if (isIncoming) {
            updateDescription();
        }
        else {
            updateSaveButton();
        }
            }
            catch (error) {
                resetSelect(
                    e1Select,
                    "-- Select E1 --");

                showError(error.message);
            }
        }

            siteSelect.addEventListener(
                "change",
                async function () {

                    await loadConnectedSites();
                });

            previousSiteSelect.addEventListener(
                "change",
                async function () {

                    if (previousSiteSelect.value ===
                        nextSiteSelect.value) {

                        nextSiteSelect.value = "";

                        resetSelect(
                            outgoingStmSelect,
                            "-- Select outgoing STM --");

                        resetSelect(
                            outgoingE1Select,
                            "-- Select outgoing E1 --");
                    }

                    updateSiteRestrictions();

        await loadStms(
            previousSiteSelect.value,
            incomingStmSelect,
            incomingE1Select,
            true);
                });

            nextSiteSelect.addEventListener(
                "change",
                async function () {

                    if (nextSiteSelect.value ===
                        previousSiteSelect.value) {

                        previousSiteSelect.value = "";

                        resetSelect(
                            incomingStmSelect,
                            "-- Select incoming STM --");

                        resetSelect(
                            incomingE1Select,
                            "-- Select incoming E1 --");
                    }

                    updateSiteRestrictions();
        await loadStms(
            nextSiteSelect.value,
            outgoingStmSelect,
            outgoingE1Select,
            false);
                });

        incomingStmSelect.addEventListener(
            "change",
            async function () {

                await loadE1s(
                    incomingStmSelect.value,
                    incomingE1Select,
                    true);
            });

        outgoingStmSelect.addEventListener(
            "change",
            async function () {

                await loadE1s(
                    outgoingStmSelect.value,
                    outgoingE1Select,
                    false);
            });
                descriptionInput.addEventListener(
        "input",
        updateSaveButton);
        incomingE1Select.addEventListener(
            "change",
            updateDescription);


            outgoingE1Select.addEventListener(
                "change",
                updateSaveButton);

            /*
             * Restore the submitted selections when server-side
             * validation returns the same page.
             */
            if (initialValues.siteId) {
                siteSelect.value =
                    initialValues.siteId;

                await loadConnectedSites(
                    initialValues.previousSiteId,
                    initialValues.nextSiteId);

        if (initialValues.previousSiteId) {
            await loadStms(
                initialValues.previousSiteId,
                incomingStmSelect,
                incomingE1Select,
                true,
                initialValues.incomingStmId,
                initialValues.incomingE1Id);
        } 

        if (initialValues.nextSiteId) {
            await loadStms(
                initialValues.nextSiteId,
                outgoingStmSelect,
                outgoingE1Select,
                false,
                initialValues.outgoingStmId,
                initialValues.outgoingE1Id);
        }

        updateDescription();

        /*
         * Preserve the submitted description when server-side
         * validation returns the page.
         *
         * For ExtendExistingPath, updateDescription already
         * loads the database description and makes it readonly.
         */
        const selectedIncomingOption =
            incomingE1Select.options[
                incomingE1Select.selectedIndex
            ];

        const selectedState =
            selectedIncomingOption?.dataset.state ?? "";

        if (selectedState !== "ExtendExistingPath" &&
            initialValues.description) {

            descriptionInput.value =
                initialValues.description;
        }

        updateSiteRestrictions();
        updateSaveButton();
            }
        });
    </script>
}