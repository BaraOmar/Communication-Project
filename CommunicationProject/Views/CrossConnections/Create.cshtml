@model CommunicationProject.ViewModels.CreateCrossConnectionViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Create Cross Connection";

    string initialValuesJson =
        JsonSerializer.Serialize(new
        {
            siteId = Model.SiteId,
            previousSiteId = Model.PreviousSiteId,
            incomingLinkId =
                Model.IncomingLinkId?.ToString(),
            incomingStmId =
                Model.IncomingStmId?.ToString(),
            incomingE1Id =
                Model.IncomingE1Id?.ToString(),

            nextSiteId = Model.NextSiteId,
            outgoingLinkId =
                Model.OutgoingLinkId?.ToString(),
            outgoingStmId =
                Model.OutgoingStmId?.ToString(),
            outgoingE1Id =
                Model.OutgoingE1Id?.ToString()
        });
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/crossconnections.css"
          asp-append-version="true" />
}


<div class="container py-4">

    <div class="mb-4">
        <h1 class="mb-1">
            Create Cross Connection
        </h1>

        <p class="text-muted mb-0">
            Join an incoming E1 to an outgoing E1 at one site.
        </p>
    </div>


    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">

                <label asp-for="SiteId"
                       class="form-label">
                </label>

                <select asp-for="SiteId"
                        asp-items="Model.SiteOptions"
                        id="siteSelect"
                        class="form-select">

                    <option value="">
                        Select cross-connection site
                    </option>

                </select>

                <span asp-validation-for="SiteId"
                      class="text-danger">
                </span>

            </div>
        </div>


        <div class="row g-4">

            <!-- Incoming side -->
            <div class="col-lg-6">

                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">

                        <h4 class="mb-1">
                            Incoming Side
                        </h4>

                        <p class="text-muted mb-4">
                            Select the link arriving from the previous site.
                        </p>


                        <div class="mb-3">

                            <label asp-for="PreviousSiteId"
                                   class="form-label">
                            </label>

                            <select asp-for="PreviousSiteId"
                                    id="previousSiteSelect"
                                    class="form-select"
                                    disabled>

                                <option value="">
                                    Select previous site
                                </option>

                            </select>

                            <span asp-validation-for="PreviousSiteId"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="IncomingLinkId"
                                   class="form-label">
                            </label>

                            <select asp-for="IncomingLinkId"
                                    id="incomingLinkSelect"
                                    class="form-select"
                                    disabled>

                                <option value="">
                                    Select incoming link
                                </option>

                            </select>

                            <span asp-validation-for="IncomingLinkId"
                                  class="text-danger">
                            </span>

                        </div>


                        <div id="incomingStmField"
                             class="mb-3">

                            <label asp-for="IncomingStmId"
                                   class="form-label">
                            </label>

                            <select asp-for="IncomingStmId"
                                    id="incomingStmSelect"
                                    class="form-select"
                                    disabled>

                                <option value="">
                                    Select incoming STM
                                </option>

                            </select>

                            <span asp-validation-for="IncomingStmId"
                                  class="text-danger">
                            </span>

                        </div>


                        <div>

                            <label asp-for="IncomingE1Id"
                                   class="form-label">
                            </label>

                            <select asp-for="IncomingE1Id"
                                    id="incomingE1Select"
                                    class="form-select"
                                    disabled>

                                <option value="">
                                    Select incoming E1
                                </option>

                            </select>

                            <span asp-validation-for="IncomingE1Id"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>
                </div>

            </div>


            <!-- Outgoing side -->
            <div class="col-lg-6">

                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">

                        <h4 class="mb-1">
                            Outgoing Side
                        </h4>

                        <p class="text-muted mb-4">
                            Select the link leaving toward the next site.
                        </p>


                        <div class="mb-3">

                            <label asp-for="NextSiteId"
                                   class="form-label">
                            </label>

                            <select asp-for="NextSiteId"
                                    id="nextSiteSelect"
                                    class="form-select"
                                    disabled>

                                <option value="">
                                    Select next site
                                </option>

                            </select>

                            <span asp-validation-for="NextSiteId"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="OutgoingLinkId"
                                   class="form-label">
                            </label>

                            <select asp-for="OutgoingLinkId"
                                    id="outgoingLinkSelect"
                                    class="form-select"
                                    disabled>

                                <option value="">
                                    Select outgoing link
                                </option>

                            </select>

                            <span asp-validation-for="OutgoingLinkId"
                                  class="text-danger">
                            </span>

                        </div>


                        <div id="outgoingStmField"
                             class="mb-3">

                            <label asp-for="OutgoingStmId"
                                   class="form-label">
                            </label>

                            <select asp-for="OutgoingStmId"
                                    id="outgoingStmSelect"
                                    class="form-select"
                                    disabled>

                                <option value="">
                                    Select outgoing STM
                                </option>

                            </select>

                            <span asp-validation-for="OutgoingStmId"
                                  class="text-danger">
                            </span>

                        </div>


                        <div>

                            <label asp-for="OutgoingE1Id"
                                   class="form-label">
                            </label>

                            <select asp-for="OutgoingE1Id"
                                    id="outgoingE1Select"
                                    class="form-select"
                                    disabled>

                                <option value="">
                                    Select outgoing E1
                                </option>

                            </select>

                            <span asp-validation-for="OutgoingE1Id"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>
                </div>

            </div>

        </div>


        <div class="card border-0 shadow-sm my-4">
            <div class="card-body p-4">

                <label asp-for="CustomerName"
                       class="form-label">
                </label>

                <input asp-for="CustomerName"
                       class="form-control"
                       placeholder="Enter customer name" />

                <span asp-validation-for="CustomerName"
                      class="text-danger">
                </span>

            </div>
        </div>


        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">
                Create Cross Connection
            </button>

            <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const initialValues =
            @Html.Raw(initialValuesJson);

        const urls = {
            connectedSites:
                '@Url.Action("GetConnectedSites", "CrossConnections")',

            links:
                '@Url.Action("GetLinks", "CrossConnections")',

            stms:
                '@Url.Action("GetStms", "CrossConnections")',

            e1s:
                '@Url.Action("GetAvailableE1s", "CrossConnections")'
        };


        const siteSelect =
            document.getElementById("siteSelect");

        const previousSiteSelect =
            document.getElementById("previousSiteSelect");

        const nextSiteSelect =
            document.getElementById("nextSiteSelect");


        const incomingLinkSelect =
            document.getElementById("incomingLinkSelect");

        const incomingStmSelect =
            document.getElementById("incomingStmSelect");

        const incomingE1Select =
            document.getElementById("incomingE1Select");

        const incomingStmField =
            document.getElementById("incomingStmField");


        const outgoingLinkSelect =
            document.getElementById("outgoingLinkSelect");

        const outgoingStmSelect =
            document.getElementById("outgoingStmSelect");

        const outgoingE1Select =
            document.getElementById("outgoingE1Select");

        const outgoingStmField =
            document.getElementById("outgoingStmField");

                    const customerNameInput =
            document.getElementById("CustomerName");

        let customerWasAutoFilled = false;


        function resetSelect(
            select,
            placeholder) {

            select.innerHTML = "";

            const option =
                document.createElement("option");

            option.value = "";
            option.textContent = placeholder;

            select.appendChild(option);

            select.value = "";
            select.disabled = true;
        }


        function populateSelect(
            select,
            items,
            placeholder,
            selectedValue = "") {

            resetSelect(
                select,
                placeholder);

            for (const item of items) {
                const option =
                    document.createElement("option");

                option.value = item.value;
                option.textContent = item.text;

                if (item.technology) {
                    option.dataset.technology =
                        item.technology;
                }
                        if (item.state) {
            option.dataset.state =
                item.state;
        }

        if (item.customerName) {
            option.dataset.customerName =
                item.customerName;
        }
                select.appendChild(option);
            }

            select.disabled = false;

            if (selectedValue) {
                select.value = selectedValue;
            }
        }


        async function getJson(
            url,
            parameters) {

            const query =
                new URLSearchParams();

            for (const [key, value]
                 of Object.entries(parameters)) {

                if (value !== null &&
                    value !== undefined &&
                    value !== "") {

                    query.append(
                        key,
                        value);
                }
            }

            const response =
                await fetch(
                    url + "?" + query.toString());

            if (!response.ok) {
                throw new Error(
                    "Unable to load options.");
            }

            return await response.json();
        }


        function resetIncomingSide() {
            resetSelect(
                incomingLinkSelect,
                "Select incoming link");

            resetSelect(
                incomingStmSelect,
                "Select incoming STM");

            resetSelect(
                incomingE1Select,
                "Select incoming E1");

            incomingStmField.classList.remove(
                "d-none");

                updateCustomerFromIncomingE1();
        }


        function resetOutgoingSide() {
            resetSelect(
                outgoingLinkSelect,
                "Select outgoing link");

            resetSelect(
                outgoingStmSelect,
                "Select outgoing STM");

            resetSelect(
                outgoingE1Select,
                "Select outgoing E1");

            outgoingStmField.classList.remove(
                "d-none");
        }


        async function loadConnectedSites(
            previousValue = "",
            nextValue = "") {

            resetSelect(
                previousSiteSelect,
                "Select previous site");

            resetSelect(
                nextSiteSelect,
                "Select next site");

            resetIncomingSide();
            resetOutgoingSide();

            if (!siteSelect.value) {
                return;
            }

            const sites =
                await getJson(
                    urls.connectedSites,
                    {
                        siteId:
                            siteSelect.value
                    });

            populateSelect(
                previousSiteSelect,
                sites,
                "Select previous site",
                previousValue);

            populateSelect(
                nextSiteSelect,
                sites,
                "Select next site",
                nextValue);

        updateSideSiteAvailability();
    }


        async function loadLinks(
            side,
            selectedLinkId = "",
            selectedStmId = "",
            selectedE1Id = "") {

            const isIncoming =
                side === "incoming";

            const connectedSiteSelect =
                isIncoming
                    ? previousSiteSelect
                    : nextSiteSelect;

            const linkSelect =
                isIncoming
                    ? incomingLinkSelect
                    : outgoingLinkSelect;

            const stmSelect =
                isIncoming
                    ? incomingStmSelect
                    : outgoingStmSelect;

            const e1Select =
                isIncoming
                    ? incomingE1Select
                    : outgoingE1Select;

            resetSelect(
                linkSelect,
                isIncoming
                    ? "Select incoming link"
                    : "Select outgoing link");

            resetSelect(
                stmSelect,
                isIncoming
                    ? "Select incoming STM"
                    : "Select outgoing STM");

            resetSelect(
                e1Select,
                isIncoming
                    ? "Select incoming E1"
                    : "Select outgoing E1");

            if (!siteSelect.value ||
                !connectedSiteSelect.value) {
                return;
            }

            const links =
                await getJson(
                    urls.links,
                    {
                        siteId:
                            siteSelect.value,

                        connectedSiteId:
                            connectedSiteSelect.value
                    });

            populateSelect(
                linkSelect,
                links,
                isIncoming
                    ? "Select incoming link"
                    : "Select outgoing link",
                selectedLinkId);

            if (selectedLinkId) {
                await configureLink(
                    side,
                    selectedStmId,
                    selectedE1Id);
            }
        }


        async function configureLink(
            side,
            selectedStmId = "",
            selectedE1Id = "") {

            const isIncoming =
                side === "incoming";

            const linkSelect =
                isIncoming
                    ? incomingLinkSelect
                    : outgoingLinkSelect;

            const stmSelect =
                isIncoming
                    ? incomingStmSelect
                    : outgoingStmSelect;

            const e1Select =
                isIncoming
                    ? incomingE1Select
                    : outgoingE1Select;

            const stmField =
                isIncoming
                    ? incomingStmField
                    : outgoingStmField;

            resetSelect(
                stmSelect,
                isIncoming
                    ? "Select incoming STM"
                    : "Select outgoing STM");

            resetSelect(
                e1Select,
                isIncoming
                    ? "Select incoming E1"
                    : "Select outgoing E1");

            if (!linkSelect.value) {
                stmField.classList.remove(
                    "d-none");

                return;
            }

            const selectedOption =
                linkSelect.options[
                    linkSelect.selectedIndex];

            const technology =
                (
                    selectedOption.dataset.technology ||
                    ""
                ).toUpperCase();

            if (technology === "PDH") {
                stmField.classList.add(
                    "d-none");

                stmSelect.value = "";
                stmSelect.disabled = true;

                await loadE1s(
                    side,
                    null,
                    selectedE1Id);

                return;
            }

            stmField.classList.remove(
                "d-none");

            const stms =
                await getJson(
                    urls.stms,
                    {
                        linkId:
                            linkSelect.value
                    });

            populateSelect(
                stmSelect,
                stms,
                isIncoming
                    ? "Select incoming STM"
                    : "Select outgoing STM",
                selectedStmId);

            if (selectedStmId) {
                await loadE1s(
                    side,
                    selectedStmId,
                    selectedE1Id);
            }
        }


        async function loadE1s(
            side,
            stmId,
            selectedE1Id = "") {

            const isIncoming =
                side === "incoming";

            const linkSelect =
                isIncoming
                    ? incomingLinkSelect
                    : outgoingLinkSelect;

            const e1Select =
                isIncoming
                    ? incomingE1Select
                    : outgoingE1Select;

            resetSelect(
                e1Select,
                isIncoming
                    ? "Select incoming E1"
                    : "Select outgoing E1");

            if (!linkSelect.value) {
                return;
            }

            const e1s =
                await getJson(
                    urls.e1s,
                    {
                        linkId:
                            linkSelect.value,

                        stmId:
                            stmId,

                        isIncoming:
                            isIncoming
                    });

            populateSelect(
                e1Select,
                e1s,
                isIncoming
                    ? "Select incoming E1"
                    : "Select outgoing E1",
                selectedE1Id);
                        if (isIncoming) {
            updateCustomerFromIncomingE1();
        }

        }
        function updateSideSiteAvailability() {
            const previousSiteId = previousSiteSelect.value;
            const nextSiteId = nextSiteSelect.value;

            for (const option of previousSiteSelect.options) {
                const unavailable =
                    option.value !== "" &&
                    option.value === nextSiteId;

                option.hidden = unavailable;
                option.disabled = unavailable;
            }

            for (const option of nextSiteSelect.options) {
                const unavailable =
                    option.value !== "" &&
                    option.value === previousSiteId;

                option.hidden = unavailable;
                option.disabled = unavailable;
            }
        }
        


        function updateCustomerFromIncomingE1() {
            const selectedOption =
                incomingE1Select.options[
                    incomingE1Select.selectedIndex];

            const isExistingPath =
                selectedOption?.dataset.state ===
                "ExtendExistingPath";

            const customerName =
                selectedOption?.dataset.customerName || "";

            if (isExistingPath && customerName) {
                customerNameInput.value =
                    customerName;

                customerNameInput.readOnly = true;
                customerWasAutoFilled = true;

                return;
            }

            if (customerWasAutoFilled) {
                customerNameInput.value = "";
            }

            customerNameInput.readOnly = false;
            customerWasAutoFilled = false;
        }

        siteSelect.addEventListener(
            "change",
            async () => {
                await loadConnectedSites();
            });


        previousSiteSelect.addEventListener(
            "change",
            async () => {
                updateSideSiteAvailability();
                await loadLinks("incoming");
            });
                incomingE1Select.addEventListener(
        "change",
        updateCustomerFromIncomingE1);

        nextSiteSelect.addEventListener(
            "change",
            async () => {
                updateSideSiteAvailability();
                await loadLinks("outgoing");
            });


        incomingLinkSelect.addEventListener(
            "change",
            async () => {
                await configureLink("incoming");
            });


        outgoingLinkSelect.addEventListener(
            "change",
            async () => {
                await configureLink("outgoing");
            });


        incomingStmSelect.addEventListener(
            "change",
            async () => {
                await loadE1s(
                    "incoming",
                    incomingStmSelect.value);
            });


        outgoingStmSelect.addEventListener(
            "change",
            async () => {
                await loadE1s(
                    "outgoing",
                    outgoingStmSelect.value);
            });


        async function restoreSelections() {
            if (!initialValues.siteId) {
                return;
            }

            siteSelect.value =
                initialValues.siteId;

            await loadConnectedSites(
                initialValues.previousSiteId,
                initialValues.nextSiteId);

            if (initialValues.previousSiteId) {
                await loadLinks(
                    "incoming",
                    initialValues.incomingLinkId,
                    initialValues.incomingStmId,
                    initialValues.incomingE1Id);
            }

            if (initialValues.nextSiteId) {
                await loadLinks(
                    "outgoing",
                    initialValues.outgoingLinkId,
                    initialValues.outgoingStmId,
                    initialValues.outgoingE1Id);
            }
        }


        restoreSelections();
    </script>
}