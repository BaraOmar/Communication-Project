@model CommunicationProject.Models.Mux
@using CommunicationProject.Security
@using CommunicationProject.Services.Muxes

@{
    ViewData["Title"] = "MUX Details";

    bool canManage =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.Operator);

    var groups = Model.Cards
        .OrderBy(card => card.Section)
        .ThenBy(card => card.ShelfNumber)
        .ThenBy(card => card.SlotNumber)
        .GroupBy(card => new { card.Section, card.ShelfNumber });

    int stmPorts = Model.Cards
        .Where(card => card.Category == CardCategory.STM)
        .Sum(card => card.Ports.Count);

    int ltuPorts = Model.Cards
        .Where(card => card.Category == CardCategory.LTU)
        .Sum(card => card.Ports.Count);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/muxes.css"
          asp-append-version="true" />
}

<div class="mux-details-page">
    <div class="mux-details-top">
        <div>
            <h1>@Model.Name</h1>
            <p>
                Site @Model.SiteId — @Model.Site.Name ·
                @MuxStructureRules.GetName(Model.Model)
            </p>
        </div>

        @if (canManage &&
             !MuxStructureRules.HasFixedStructure(Model.Model))
        {
            <a asp-controller="MuxCards"
                   asp-action="Create"
                   asp-route-muxId="@Model.Id"
                   class="mux-primary-btn">
                + Add Card
            </a>
        }
    </div>

    <div class="mux-details-summary">
        <div class="mux-summary-item">
            <span>Installed Cards</span>
            <strong>@Model.Cards.Count</strong>
        </div>
        <div class="mux-summary-item">
            <span>STM Positions</span>
            <strong>@stmPorts</strong>
        </div>
        <div class="mux-summary-item">
            <span>E1 Channel Capacity</span>
            <strong>@(stmPorts * 63)</strong>
        </div>
        <div class="mux-summary-item">
            <span>LTU Ports</span>
            <strong>@ltuPorts</strong>
        </div>
    </div>

    @if (Model.Model == MuxModel.Tellab)
    {
        <section class="mux-install-card">
            <h2>Physical STM Group</h2>
            <p>
                STM @Model.FirstPhysicalStmNumber
                → VC4 @(Model.FirstPhysicalStmNumber - 1)
                ·
                STM @Model.SecondPhysicalStmNumber
                → VC4 @(Model.SecondPhysicalStmNumber - 1)
            </p>
            <p>Either physical VC4 can use either LTU card.</p>
        </section>
    }

    @foreach (var group in groups)
    {
        <section class="mux-install-card">
            <h2>
                @if (group.Key.Section != MuxSection.Standard)
                {
                    @group.Key.Section
                }
                else if (group.Key.ShelfNumber > 0)
                {
                    <text>Shelf @group.Key.ShelfNumber</text>
                }
                else
                {
                    <text>Installed Cards</text>
                }
            </h2>

            @foreach (var card in group)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h3>
                            @card.Category —
                            @MuxDisplay.CardPosition(card)
                        </h3>

                        <p>
                            @card.Ports.Count ports ·
                            @(card.IsRequired ? "Required card" : "Optional card")
                        </p>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var port in card.Ports.OrderBy(p => p.PortNumber))
                            {
                                string label = card.Category == CardCategory.STM
                                    ? MuxDisplay.StmLabel(
                                        Model.Model,
                                        card.ShelfNumber,
                                        card.SlotNumber,
                                        port.PortNumber,
                                        port.Stm?.Number)
                                    : MuxDisplay.LtuLabel(
                                        Model.Model,
                                        card.ShelfNumber,
                                        card.SlotNumber,
                                        port.PortNumber,
                                        port.PhysicalStmNumber);

                                string resource = port.Stm != null
                                    ? port.Stm.Link.Name
                                    : port.E1 != null
                                        ? $"E1 {port.E1.E1Number}"
                                        : "Unassigned";

                                <a asp-controller="MuxCards"
                                       asp-action="Details"
                                       asp-route-id="@card.Id"
                                       class="btn btn-outline-secondary"
                                       title="@($"{resource} · {port.Status}")">
                                    @label
                                </a>
                            }
                        </div>

                        <a asp-controller="MuxCards"
                               asp-action="Details"
                               asp-route-id="@card.Id"
                               class="mux-details-secondary-btn">
                            Open Card / Manage Assignments
                        </a>
                    </div>
                </div>
            }
        </section>
    }

    <a asp-controller="Sites"
           asp-action="Details"
           asp-route-id="@Model.SiteId"
           class="mux-details-secondary-btn">
        Back to Site
    </a>
</div>