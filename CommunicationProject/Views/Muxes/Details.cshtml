@model CommunicationProject.Models.Mux
@using CommunicationProject.Models

@{
    ViewData["Title"] = "MUX Details";

    var categoryOrder = new[]
    {
        CardCategory.Power,
        CardCategory.STM,
        CardCategory.E1
    };

    int totalPorts =
        Model.Cards.Sum(card =>
            card.Ports.Count);
}

<div class="container py-4">

    <div class="mb-4">

        <a asp-action="Index"
               class="text-decoration-none">
            ← MUXes
        </a>

        <h1 class="mt-3 mb-1">
            @Model.Name
        </h1>

        <p class="text-muted mb-0">
            Installed MUX cards and ports.
        </p>

    </div>


    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <h3 class="mb-4">
                MUX Information
            </h3>

            <div class="row g-4">

                <div class="col-md-3">

                    <div class="text-muted small">
                        Name
                    </div>

                    <div class="fw-semibold">
                        @Model.Name
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Site
                    </div>

                    <div class="fw-semibold">
                        @Model.Site.Name
                    </div>

                    <div class="text-muted small">
                        @Model.Site.Id
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        MUX Type
                    </div>

                    <div class="fw-semibold">
                        @(Model.MuxType?.Name ?? "Not assigned")
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Installed Capacity
                    </div>

                    <div class="fw-semibold">
                        @Model.Cards.Count cards
                    </div>

                    <div class="text-muted small">
                        @totalPorts ports
                    </div>

                </div>

            </div>

        </div>
    </div>


    @foreach (var category in categoryOrder)
    {
        var cards = Model.Cards
            .Where(card =>
                card.Category == category)
            .OrderBy(card =>
                card.SlotNumber)
            .ToList();

        <div class="card border-0 shadow-sm mb-4">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between
                    align-items-center mb-3">

                    <div>

                        <h3 class="mb-1">
                            @category Cards
                        </h3>

                        <div class="text-muted">
                            @cards.Count cards ·
                            @cards.Sum(card => card.Ports.Count) ports
                        </div>

                    </div>

                    <span class="badge bg-primary">
                        @cards.Count
                    </span>

                </div>


                @if (cards.Any())
                {
                    <div class="table-responsive">

                        <table class="table align-middle">

                            <thead>
                                <tr>
                                    <th>Card</th>
                                    <th>Category</th>
                                    <th>Ports</th>
                                    <th>Available Ports</th>
                                    <th class="text-end">
                                        Action
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var card in cards)
                                {
                                    int availablePorts =
                                        card.Ports.Count(port =>
                                            port.Status ==
                                            MuxPortStatus.Available);

                                    <tr>

                                        <td>
                                            <strong>
                                                Card @card.SlotNumber
                                            </strong>
                                        </td>

                                        <td>
                                            @card.Category
                                        </td>

                                        <td>
                                            @card.Ports.Count
                                        </td>

                                        <td>
                                            @availablePorts
                                        </td>

                                        <td class="text-end">

                                            <a asp-controller="MuxCards"
                                                   asp-action="Details"
                                                   asp-route-id="@card.Id"
                                                   class="btn btn-sm
                                                btn-outline-secondary">
                                                View Card
                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="text-muted py-3">
                        This MUX type does not contain
                        @category cards.
                    </div>
                }

            </div>

        </div>
    }

</div>