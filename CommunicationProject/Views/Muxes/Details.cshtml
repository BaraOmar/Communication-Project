@model CommunicationProject.Models.Mux
@using CommunicationProject.Security

@{
    ViewData["Title"] = "MUX Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <a asp-action="Index"
                   class="text-decoration-none">
                ← MUXes
            </a>

            <h1 class="mt-3 mb-1">
                @Model.Name
            </h1>

            <p class="text-muted mb-0">
                MUX device details and installed cards.
            </p>
        </div>

        @if (User.IsInRole(AppRoles.Admin) ||
             User.IsInRole(AppRoles.Operator))
        {
            <a asp-controller="MuxCards"
                   asp-action="Create"
                   asp-route-muxId="@Model.Id"
                   class="btn btn-primary">
                Add Card
            </a>
        }

    </div>


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h3 class="mb-4">
                MUX Information
            </h3>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="text-muted small">
                        Name
                    </div>

                    <div class="fw-semibold">
                        @Model.Name
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        Site
                    </div>

                    <div class="fw-semibold">
                        @Model.Site.Name
                    </div>

                    <div class="text-muted small">
                        @Model.Site.Id
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        Communication Link
                    </div>

                    <div class="fw-semibold">
                        @Model.CommunicationLink.Name
                    </div>

                    <div class="text-muted small">
                        @Model.CommunicationLink.SiteFrom.Name
                        →
                        @Model.CommunicationLink.SiteTo.Name
                    </div>
                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>
                    <h3 class="mb-1">
                        Cards
                    </h3>

                    <div class="text-muted">
                        @Model.Cards.Count installed cards
                    </div>
                </div>

            </div>


            @if (Model.Cards.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Slot</th>
                                <th>Card Type</th>
                                <th>Category</th>
                                <th>Ports</th>
                                <th class="text-end">
                                    Action
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var card in Model.Cards
                                .OrderBy(card => card.SlotNumber))
                            {
                                <tr>

                                    <td>
                                        Slot @card.SlotNumber
                                    </td>

                                    <td>
                                        <strong>
                                            @card.CardType.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @card.CardType.Category
                                    </td>

                                    <td>
                                        @card.Ports.Count
                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="MuxCards"
                                               asp-action="Details"
                                               asp-route-id="@card.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                            View Card
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-muted py-3">
                    No cards have been installed in this MUX yet.
                </div>
            }

        </div>

    </div>

</div>