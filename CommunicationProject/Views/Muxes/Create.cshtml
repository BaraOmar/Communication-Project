@model CommunicationProject.ViewModels.CreateMuxViewModel

@{
    ViewData["Title"] = "Install MUX";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Index"
               class="text-decoration-none">
            ← MUXes
        </a>

        <h1 class="mt-3 mb-1">
            Install MUX
        </h1>

        <p class="text-muted mb-0">
            Install a MUX at a site using a reusable MUX type.
            Its cards and ports will be generated automatically.
        </p>
    </div>


    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter the installed MUX name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="SiteId"
                           class="form-label">
                    </label>

                    <select asp-for="SiteId"
                            asp-items="Model.SiteOptions"
                            class="form-select">

                        <option value="">
                            Select a site
                        </option>

                    </select>

                    <span asp-validation-for="SiteId"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="MuxTypeId"
                           class="form-label">
                    </label>

                    <select asp-for="MuxTypeId"
                            asp-items="Model.MuxTypeOptions"
                            class="form-select">

                        <option value="">
                            Select a MUX type
                        </option>

                    </select>

                    <span asp-validation-for="MuxTypeId"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        The selected type determines all Power,
                        STM, and E1 cards and their ports.
                    </div>

                </div>


                <div class="alert alert-info">
                    Cards and ports are generated automatically.
                    They do not need to be added manually.
                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Install MUX
                    </button>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}