@model CommunicationProject.ViewModels.CreateMuxViewModel

@{
    ViewData["Title"] = "Install MUX";
}

<div class="container py-4">
    <h1>Install MUX</h1>
    <p>Select the site where you want to install the MUX.</p>

    <form asp-action="InstallForSite" method="get">
        <div class="mb-3">
            <label for="siteId" class="form-label">Site</label>

            <select id="siteId"
                    name="siteId"
                    asp-items="Model.SiteOptions"
                    class="form-select"
                    required>
                <option value="">Select a site</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Continue
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Cancel
        </a>
    </form>
</div>