@model CommunicationProject.ViewModels.InstallSiteMuxViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Install MUX";

    var initialCards = JsonSerializer.Serialize(
        Model.Cards,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/muxes.css"
          asp-append-version="true" />
}

<div class="mux-install-page">
    <div class="mux-install-header">
        <div>
            <h1>Install MUX</h1>
            <p>Site @Model.SiteId — @Model.SiteName</p>
        </div>
    </div>

    <form asp-action="InstallForSite"
          method="post"
          id="installMuxForm">

        @Html.AntiForgeryToken()
        <input asp-for="SiteId" type="hidden" />

        <div asp-validation-summary="All"
             class="mux-install-validation"></div>

        <section class="mux-install-card">
            <h2>MUX Configuration</h2>

            <div class="mux-install-fields">
                <div class="mux-install-field">
                    <label asp-for="MuxName"></label>
                    <input asp-for="MuxName"
                           class="mux-install-input" />
                    <span asp-validation-for="MuxName"
                          class="mux-install-field-error"></span>
                </div>

                <div class="mux-install-field">
                    <label asp-for="MuxTypeId"></label>

                    <select asp-for="MuxTypeId"
                            asp-items="Model.MuxTypeOptions"
                            id="muxTypeSelect"
                            class="mux-install-select">
                        <option value="">Select a MUX type</option>
                    </select>

                    <span asp-validation-for="MuxTypeId"
                          class="mux-install-field-error"></span>
                </div>
            </div>

            <p id="loadError"
               class="mux-install-field-error"
               role="alert"></p>
        </section>

        <section class="mux-install-card"
                 id="tellabSettings"
                 hidden>
            <h2>Tellab Physical STMs</h2>

            <p>
                Select two different STM numbers.
                These are separate from Main VC4 0–15.
                Either physical VC4 can use either LTU.
            </p>

            <div class="mux-install-fields">
                <div class="mux-install-field">
                    <label asp-for="FirstPhysicalStmNumber"></label>

                    <select asp-for="FirstPhysicalStmNumber"
                            class="mux-install-select">
                        <option value="">Select STM</option>
                        @for (int number = 29; number <= 31; number++)
                        {
                            <option value="@number">
                                STM @number → VC4 @(number - 1)
                            </option>
                        }
                    </select>

                    <span asp-validation-for="FirstPhysicalStmNumber"
                          class="mux-install-field-error"></span>
                </div>

                <div class="mux-install-field">
                    <label asp-for="SecondPhysicalStmNumber"></label>

                    <select asp-for="SecondPhysicalStmNumber"
                            class="mux-install-select">
                        <option value="">Select STM</option>
                        @for (int number = 29; number <= 31; number++)
                        {
                            <option value="@number">
                                STM @number → VC4 @(number - 1)
                            </option>
                        }
                    </select>

                    <span asp-validation-for="SecondPhysicalStmNumber"
                          class="mux-install-field-error"></span>
                </div>
            </div>
        </section>

        <section class="mux-install-card">
            <h2>Installed Cards</h2>

            <p>
                Required cards retain their default configuration.
                Optional cards can be changed or removed.
                Additional cards belong only to this installation.
            </p>

            <div class="mux-install-table-wrap">
                <table class="mux-install-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Section</th>
                            <th class="shelf-column">Shelf</th>
                            <th>Card Number</th>
                            <th>Ports</th>
                            <th>Requirement</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="installationCards"></tbody>
                </table>
            </div>

            <button type="button"
                    id="addCard"
                    class="mux-primary-btn"
                    hidden>
                + Add Card
            </button>

            <button type="button"
                    id="resetCards"
                    class="mux-details-secondary-btn"
                    disabled>
                Reload Type Defaults
            </button>

            <p id="capacityText" class="mt-3">
                Select a MUX type.
            </p>
        </section>

        <section class="mux-install-card">
            <h2>Link STM Assignments</h2>

            <p>
                Optionally connect this site's available link STMs
                to the installed MUX. You can also assign them later.
            </p>

            @if (Model.StmAssignments.Any())
            {
                <div class="mux-install-table-wrap">
                    <table class="mux-install-table">
                        <thead>
                            <tr>
                                <th>Remote Site</th>
                                <th>Link</th>
                                <th>Link STM</th>
                                <th>MUX Position</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int index = 0;
                                  index < Model.StmAssignments.Count;
                                  index++)
                            {
                                <tr>
                                    <td>
                                        @Model.StmAssignments[index].RemoteSiteId
                                    </td>
                                    <td>
                                        @Model.StmAssignments[index].LinkName
                                    </td>
                                    <td>
                                        STM @Model.StmAssignments[index].StmNumber

                                        <input asp-for="StmAssignments[index].StmId"
                                               type="hidden" />
                                    </td>
                                    <td>
                                        <select asp-for="StmAssignments[index].PortKey"
                                                class="mux-install-select stm-assignment"
                                                data-selected-port="@Model.StmAssignments[index].PortKey"
                                                disabled>
                                            <option value="">
                                                Leave unassigned
                                            </option>
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>
                    No unassigned link STMs are available.
                    You can still install this MUX.
                </p>
            }
        </section>

        <div class="mux-install-actions">
            <a asp-controller="Sites"
                   asp-action="Details"
                   asp-route-id="@Model.SiteId"
                   class="mux-details-secondary-btn">
                Cancel
            </a>

            <button type="submit"
                    id="installButton"
                    class="mux-primary-btn">
                Install MUX
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const typeSelect = document.getElementById("muxTypeSelect");
            const body = document.getElementById("installationCards");
            const addButton = document.getElementById("addCard");
            const resetButton = document.getElementById("resetCards");
            const installButton = document.getElementById("installButton");
            const capacity = document.getElementById("capacityText");
            const error = document.getElementById("loadError");
            const tellabSettings = document.getElementById("tellabSettings");
            const firstPhysical = document.getElementById("FirstPhysicalStmNumber");
            const secondPhysical = document.getElementById("SecondPhysicalStmNumber");
            const assignmentSelects = [
                ...document.querySelectorAll(".stm-assignment")
            ];

            let cards = @Html.Raw(initialCards);
            let muxModel = @((int)Model.Model);
            let requestVersion = 0;

            const selections = new Map(
                assignmentSelects.map(select => [
                    select,
                    select.dataset.selectedPort || ""
                ])
            );

            const usesShelves = () => [1, 2].includes(muxModel);
            const fixedStructure = () => [5, 6].includes(muxModel);

            function readCards() {
                return [...body.querySelectorAll("tr")].map(row => {
                    const field = name =>
                        row.querySelector(`[data-field="${name}"]`).value;

                    return {
                        category: Number(field("Category")),
                        section: Number(field("Section")),
                        shelfNumber: Number(field("ShelfNumber")),
                        slotNumber: Number(field("SlotNumber")),
                        portCount: Number(field("PortCount")),
                        isRequired: field("IsRequired") === "true"
                    };
                });
            }

            function renderCards() {
                const shelves = usesShelves();

                body.innerHTML = cards.map((card, index) => {
                    const locked = card.isRequired || fixedStructure();
                    const name = field => `Cards[${index}].${field}`;

                    const hidden = (field, value) =>
                        `<input type="hidden"
                            name="${name(field)}"
                            data-field="${field}" value="${value}">`;

                    const number = (field, value, minimum) =>
                        `<input type="number"
                            name="${name(field)}"
                            data-field="${field}" value="${value}"
                            min="${minimum}" max="1000" required
                            class="mux-install-input"
                            ${locked ? "readonly" : ""}>`;

                    const category = locked
                        ? hidden("Category", card.category) +
                          (card.category === 0 ? "STM" : "LTU")
                        : `<select name="${name("Category")}"
                                data-field="Category"
                                class="mux-install-select">
                              <option value="0"
                                ${card.category === 0 ? "selected" : ""}>
                                STM
                              </option>
                              <option value="1"
                                ${card.category === 1 ? "selected" : ""}>
                                LTU
                              </option>
                           </select>`;

                    const section =
                        ["Standard", "Main", "Sub"][card.section];

                    return `<tr>
                        <td>${category}</td>
                        <td>
                            ${hidden("Section", card.section)}
                            ${section}
                        </td>
                        <td class="shelf-column" ${shelves ? "" : "hidden"}>
                            ${shelves
                                ? number("ShelfNumber", card.shelfNumber, 1)
                                : hidden("ShelfNumber", 0)}
                        </td>
                        <td>${number("SlotNumber", card.slotNumber, 1)}</td>
                        <td>${number("PortCount", card.portCount, 1)}</td>
                        <td>
                            ${hidden("IsRequired", card.isRequired)}
                            ${card.isRequired ? "Required" : "Optional"}
                        </td>
                        <td>
                            <button type="button" data-remove="${index}"
                                ${locked ? "disabled" : ""}>
                                Remove
                            </button>
                        </td>
                    </tr>`;
                }).join("");

                document.querySelectorAll(".shelf-column")
                    .forEach(cell => cell.hidden = !shelves);

                addButton.hidden = !typeSelect.value || fixedStructure();
                addButton.disabled = cards.length >= 100;
                resetButton.disabled = !typeSelect.value;

                configurePhysicalFields();
                updatePorts();
            }

            function configurePhysicalFields() {
                const isTellab = muxModel === 5;

                tellabSettings.hidden = !isTellab;

                [firstPhysical, secondPhysical].forEach(select => {
                    select.disabled = !isTellab;
                    select.required = isTellab;

                    if (!isTellab)
                        select.value = "";
                });

                updatePhysicalOptions();
            }

            function updatePhysicalOptions() {
                [...firstPhysical.options].forEach(option => {
                    option.disabled = option.value !== "" &&
                        option.value === secondPhysical.value;
                });

                [...secondPhysical.options].forEach(option => {
                    option.disabled = option.value !== "" &&
                        option.value === firstPhysical.value;
                });
            }

            function portLabel(card, number) {
                if (muxModel === 5)
                    return `VC4 ${number - 1} (Main)`;

                if (muxModel === 6)
                    return card.slotNumber === 1 ? "SC4 I" : "SC4 II";

                const position = usesShelves()
                    ? `${card.shelfNumber}.${card.slotNumber}.${number}`
                    : `${card.slotNumber}.${number}`;

                return `STM (${position})`;
            }

            function updatePorts() {
                const ports = [];
                let ltuPorts = 0;

                for (const card of cards) {
                    const valid = [card.slotNumber, card.portCount]
                        .every(value =>
                            Number.isInteger(value) &&
                            value >= 1 && value <= 1000);

                    if (!valid)
                        continue;

                    if (usesShelves() &&
                        (!Number.isInteger(card.shelfNumber) ||
                         card.shelfNumber < 1 ||
                         card.shelfNumber > 1000))
                        continue;

                    if (card.category === 1) {
                        ltuPorts += card.portCount;
                        continue;
                    }

                    for (let number = 1; number <= card.portCount; number++) {
                        ports.push({
                            value: `${card.section}:${card.shelfNumber}:` +
                                   `${card.slotNumber}:${number}`,
                            text: portLabel(card, number)
                        });
                    }
                }

                const validKeys = new Set(ports.map(port => port.value));

                assignmentSelects.forEach(select => {
                    const previous = selections.get(select) || "";

                    select.replaceChildren(
                        new Option("Leave unassigned", "")
                    );

                    ports.forEach(port => {
                        select.add(new Option(port.text, port.value));
                    });

                    const selected = validKeys.has(previous) ? previous : "";

                    select.value = selected;
                    selections.set(select, selected);
                    select.disabled = ports.length === 0;
                });

                updateDisabledAssignments();

                const assigned = assignmentSelects
                    .filter(select => select.value).length;

                capacity.textContent =
                    `${cards.length} cards · ${ports.length} STM positions · ` +
                    `${ports.length * 63} E1 channel capacity · ` +
                    `${ltuPorts} LTU ports · ${assigned} link STMs assigned`;
            }

            function updateDisabledAssignments() {
                const selected = new Set(
                    assignmentSelects.map(select => select.value).filter(Boolean)
                );

                assignmentSelects.forEach(select => {
                    [...select.options].forEach(option => {
                        option.disabled = Boolean(option.value) &&
                            selected.has(option.value) &&
                            option.value !== select.value;
                    });
                });
            }

            async function loadTemplate() {
                const version = ++requestVersion;

                cards = [];
                muxModel = 0;
                error.textContent = "";
                renderCards();

                if (!typeSelect.value) {
                    installButton.disabled = false;
                    return;
                }

                installButton.disabled = true;
                addButton.disabled = true;
                resetButton.disabled = true;

                try {
                    const response = await fetch(
                        '@Url.Action("GetInstallationTemplate", "Muxes")' +
                        '?muxTypeId=' + encodeURIComponent(typeSelect.value));

                    if (!response.ok)
                        throw new Error("Unable to load the MUX configuration.");

                    const data = await response.json();

                    if (version !== requestVersion)
                        return;

                    muxModel = data.model;
                    cards = data.cards;
                    renderCards();
                    installButton.disabled = false;
                } catch (problem) {
                    if (version !== requestVersion)
                        return;

                    error.textContent = problem.message;
                    resetButton.disabled = false;
                }
            }

            addButton.addEventListener("click", () => {
                cards = readCards();

                if (cards.length >= 100 || fixedStructure())
                    return;

                cards.push({
                    category: 0,
                    section: 0,
                    shelfNumber: usesShelves() ? 1 : 0,
                    slotNumber: Math.max(
                        0, ...cards.map(card => card.slotNumber)
                    ) + 1,
                    portCount: 1,
                    isRequired: false
                });

                renderCards();
            });

            body.addEventListener("change", () => {
                cards = readCards();
                updatePorts();
            });

            body.addEventListener("click", event => {
                const button = event.target.closest("[data-remove]");

                if (!button)
                    return;

                cards = readCards();
                const index = Number(button.dataset.remove);

                if (cards[index].isRequired || fixedStructure())
                    return;

                cards.splice(index, 1);
                renderCards();
            });

            assignmentSelects.forEach(select => {
                select.addEventListener("change", () => {
                    selections.set(select, select.value);
                    updatePorts();
                });
            });

            firstPhysical.addEventListener("change", updatePhysicalOptions);
            secondPhysical.addEventListener("change", updatePhysicalOptions);
            typeSelect.addEventListener("change", loadTemplate);
            resetButton.addEventListener("click", loadTemplate);

            if (typeSelect.value && cards.length === 0)
                loadTemplate();
            else
                renderCards();
        })();
    </script>
}