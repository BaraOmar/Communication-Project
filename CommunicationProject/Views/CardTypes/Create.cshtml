@model CommunicationProject.Models.CardType

@{
    ViewData["Title"] = "Add Card Type";
}

<div class="container py-4">

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <div class="mb-4">
                <h2 class="mb-1">
                    Add Card Type
                </h2>

                <p class="text-muted mb-0">
                    Define a reusable MUX card type.
                </p>
            </div>

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name"
                           class="form-label"></label>

                    <input asp-for="Name"
                           class="form-control"
                           autocomplete="off" />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category"
                           class="form-label"></label>

                    <select asp-for="Category"
                            class="form-select">

                        <option value="STM">
                            STM
                        </option>

                        <option value="E1">
                            E1
                        </option>

                        <option value="Power">
                            Power
                        </option>

                    </select>

                    <span asp-validation-for="Category"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="PortCount"
                           class="form-label"></label>

                    <input asp-for="PortCount"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="PortCount"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Create Card Type
                    </button>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}