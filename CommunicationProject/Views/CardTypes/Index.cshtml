@model List<CommunicationProject.Models.CardType>

@{
    ViewData["Title"] = "Card Types";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">
                Card Types
            </h1>

            <p class="text-muted mb-0">
                Manage reusable MUX card definitions.
            </p>
        </div>

        <a asp-action="Create"
               class="btn btn-primary">
            Add Card Type
        </a>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Port Count</th>
                        <th class="text-end">
                            Action
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.Name
                                    </strong>
                                </td>

                                <td>
                                    @item.Category
                                </td>

                                <td>
                                    @item.PortCount
                                </td>

                                <td class="text-end">
                                    <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4"
                                class="text-center py-4 text-muted">
                                No card types have been added yet.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>