@using CommunicationProject.Security

@{
    string currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string NavClass(string controller)
    {
        return currentController.Equals(
            controller,
            StringComparison.OrdinalIgnoreCase)
                ? "app-nav-link active"
                : "app-nav-link";
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Communication Project
    </title>

    <link rel="stylesheet"
          href="~/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync(
        "Styles",
        required: false)

</head>


<body>

    <!-- =====================================================
         TOP NAVIGATION
         ===================================================== -->
         @if (User.Identity?.IsAuthenticated == true)
{
    <header class="app-header">

        <nav class="navbar navbar-expand-xl app-navbar">

            <div class="app-navbar-container">


                <!-- Brand -->
                <a asp-controller="Home"
                       asp-action="Index"
                       class="app-brand">

                    <span class="app-brand-mark">
                        C
                    </span>

                    <span class="app-brand-text">

                        <span class="app-brand-name">
                            Communication
                        </span>

                        <span class="app-brand-subtitle">
                            Network Management
                        </span>

                    </span>

                </a>


                <!-- Mobile Toggle -->
                <button class="navbar-toggler app-navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navigation -->
                <div id="mainNavigation"
                     class="collapse navbar-collapse">

                    <div class="app-nav">


                        @if (User.IsInRole(AppRoles.Admin))
                        {
                            <a asp-controller="Users"
                                   asp-action="Index"
                                   class="@NavClass("Users")">
                                Users
                            </a>


                            <a asp-controller="Sites"
                                   asp-action="Index"
                                   class="@NavClass("Sites")">
                                Sites
                            </a>


                            <a asp-controller="CommunicationLinks"
                                   asp-action="Index"
                                   class="@NavClass("CommunicationLinks")">
                                Links
                            </a>
                        }


                        <a asp-controller="LinkTypes"
                               asp-action="Index"
                               class="@NavClass("LinkTypes")">
                            Link Types
                        </a>


                        <a asp-controller="Stms"
                               asp-action="Index"
                               class="@NavClass("Stms")">
                            STMs
                        </a>


                        <a asp-controller="E1s"
                               asp-action="Index"
                               class="@NavClass("E1s")">
                            E1 Channels
                        </a>


                        @if (User.IsInRole(AppRoles.Admin) ||
                             User.IsInRole(AppRoles.Operator))
                        {
                            <a asp-controller="CrossConnections"
                                   asp-action="Create"
                                   class="@NavClass("CrossConnections")">
                                Cross Connection
                            </a>
                        }


                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="SearchPath"
                                   asp-action="Index"
                                   class="@NavClass("SearchPath")">
                                Search Paths
                            </a>
                        }

                    </div>


                    <!-- Account -->
                    <div class="app-account">

                        <partial name="_LoginPartial" />

                    </div>

                </div>

            </div>

        </nav>

    </header>
    }

    <!-- =====================================================
         MESSAGES
         ===================================================== -->

    <div class="app-message-area">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="app-alert app-alert-success">

                <span class="app-alert-icon">
                    ✓
                </span>

                <span>
                    @TempData["SuccessMessage"]
                </span>

                <button type="button"
                        class="app-alert-close"
                        onclick="this.parentElement.remove()">
                    ×
                </button>

            </div>
        }


        @if (TempData["ErrorMessage"] != null)
        {
            <div class="app-alert app-alert-error">

                <span class="app-alert-icon">
                    !
                </span>

                <span>
                    @TempData["ErrorMessage"]
                </span>

                <button type="button"
                        class="app-alert-close"
                        onclick="this.parentElement.remove()">
                    ×
                </button>

            </div>
        }

    </div>


    <!-- =====================================================
         CONTENT
         ===================================================== -->

    <main class="app-main">

        @RenderBody()

    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->
         @if (User.Identity?.IsAuthenticated == true)
{
    <footer class="app-footer">

        <div class="app-footer-inner">

            <span>
                Communication Network Management
            </span>

            <span class="app-footer-year">
                © 2026
            </span>

        </div>

    </footer>

}
    <script src="~/js/bootstrap.bundle.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>